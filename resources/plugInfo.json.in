{
  "Plugins": [{
    "Name": "@HDUE_PLUGIN_NAME@", "Type": "library", "Root": "..",
    "LibraryPath": "@HDUE_PLUGIN_LIBRARY@", "ResourcePath": "resources",
    "Info": { "Types": {
      "HdUnrealEngine": {
        "bases": ["HdRendererPlugin"], "displayName": "Unreal Engine", "priority": 0
      },
      "HdUE_ImplicitSurfaceSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "Implicit surfaces to meshes for hdUE"
      },
      "HdUE_LightLinkingSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "Light and shadow linking categories for hdUE"
      },
      "HdUE_ConversionSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "TetMesh, NURBS and particle fields to meshes, curves and points for hdUE"
      },
      "HdUE_RenderPassPruneSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "Render pass prune collection for hdUE"
      },
      "HdUE_DrawModeSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "model:drawMode stand-ins for hdUE"
      },
      "HdUE_RenderPassVisibilitySceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "Render pass renderVisibility collection for hdUE"
      },
      "HdUE_PurposeVisibilitySceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "VisibilityAPI purpose visibility for hdUE"
      },
      "HdUE_HermiteCurvesAPIAdapter": {
        "bases": ["UsdImagingAPISchemaAdapter"], "apiSchemaName": ""
      },
      "HdUE_NativeAssetAPIAdapter": {
        "bases": ["UsdImagingAPISchemaAdapter"], "apiSchemaName": ""
      },
      "HdUE_NativeAssetSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "Native asset meshes for hdUE"
      },
      "HdUE_LocalFogVolumeAdapter": {
        "bases": ["UsdImagingPrimAdapter"], "primTypeName": "UnrealLocalFogVolume"
      },
      "HdUEUnrealLocalFogVolume": {
        "alias": { "UsdSchemaBase": "UnrealLocalFogVolume" }, "bases": ["UsdGeomXformable"],
        "schemaIdentifier": "UnrealLocalFogVolume", "schemaKind": "concreteTyped"
      },
      "HdUE_PostProcessVolumeAdapter": {
        "bases": ["UsdImagingPrimAdapter"], "primTypeName": "UnrealPostProcessVolume"
      },
      "HdUEUnrealPostProcessVolume": {
        "alias": { "UsdSchemaBase": "UnrealPostProcessVolume" }, "bases": ["UsdGeomXformable"],
        "schemaIdentifier": "UnrealPostProcessVolume", "schemaKind": "concreteTyped"
      },
      "HdUE_DecalAdapter": {
        "bases": ["UsdImagingPrimAdapter"], "primTypeName": "UnrealDecal"
      },
      "HdUEUnrealDecal": {
        "alias": { "UsdSchemaBase": "UnrealDecal" }, "bases": ["UsdGeomXformable"],
        "schemaIdentifier": "UnrealDecal", "schemaKind": "concreteTyped"
      },
      "HdUE_HeightFogAdapter": {
        "bases": ["UsdImagingPrimAdapter"], "primTypeName": "UnrealExponentialHeightFog"
      },
      "HdUEUnrealExponentialHeightFog": {
        "alias": { "UsdSchemaBase": "UnrealExponentialHeightFog" }, "bases": ["UsdGeomXformable"],
        "schemaIdentifier": "UnrealExponentialHeightFog", "schemaKind": "concreteTyped"
      },
      "HdUE_SkyAtmosphereAdapter": {
        "bases": ["UsdImagingPrimAdapter"], "primTypeName": "UnrealSkyAtmosphere"
      },
      "HdUEUnrealSkyAtmosphere": {
        "alias": { "UsdSchemaBase": "UnrealSkyAtmosphere" }, "bases": ["UsdGeomXformable"],
        "schemaIdentifier": "UnrealSkyAtmosphere", "schemaKind": "concreteTyped"
      },
      "HdUE_VolumetricCloudAdapter": {
        "bases": ["UsdImagingPrimAdapter"], "primTypeName": "UnrealVolumetricCloud"
      },
      "HdUEUnrealVolumetricCloud": {
        "alias": { "UsdSchemaBase": "UnrealVolumetricCloud" }, "bases": ["UsdGeomXformable"],
        "schemaIdentifier": "UnrealVolumetricCloud", "schemaKind": "concreteTyped"
      },
      "HdUE_VisibilityAPIAdapter": {
        "bases": ["UsdImagingAPISchemaAdapter"], "apiSchemaName": "VisibilityAPI"
      },
      "HdUE_UnsupportedSceneIndexPlugin": {
        "bases": ["HdSceneIndexPlugin"], "loadWithRenderer": "Unreal Engine", "priority": 0,
        "displayName": "Warnings for what hdUE does not render"
      }
    } }
  }]
}
