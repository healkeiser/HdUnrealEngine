        doc = """Global density factor."""
    )
    float unreal:heightFog:FogHeightFalloff = 0.2 (
        displayName = "Fog Height Falloff"
        doc = """Height density factor, controls how the density increases as height decreases. Smaller values make the visible transition larger."""
