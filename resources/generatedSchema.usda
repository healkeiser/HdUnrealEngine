class UnrealLocalFogVolume "UnrealLocalFogVolume" (
    doc = """A UE Local Fog Volume (ULocalFogVolumeComponent), rendered by hdUE: UE's base volume, a sphere of radius 500 cm, fills the unit sphere of the prim's local space. Realtime only: UE's Path Tracer does not render local fog volumes."""
)
{
    rel proxyPrim
    uniform token purpose = "default" (
        allowedTokens = ["default", "render", "proxy", "guide"]
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
    )
    uniform token[] xformOpOrder
    float unreal:localFogVolume:RadialFogExtinction = 1 (
        displayName = "Radial Fog Density"
        doc = """The density of the radial fog representing its extinction coefficient at the center of the sphere. The final look of the volume is determined by combining the "Coverage=1-Transmittance" of both radial and height fog in order to achieve both soft edges and height fog."""
    )
    float unreal:localFogVolume:HeightFogExtinction = 1 (
        displayName = "Height Fog Density"
        doc = """The density of the radial fog representing its extinction coefficient at height 0 in the unit sphere. The final look of the volume is determined by combining the "Coverage=1-Transmittance" of both radial and height fog in order to achieve both soft edges and height fog."""
    )
    float unreal:localFogVolume:HeightFogFalloff = 1000 (
        displayName = "Height Fog Falloff"
        doc = """Controls how the density decreases as height increases. Smaller values make the visible transition larger. 1.0 is the lowest value before visual artifact are visible at the horizon."""
    )
    float unreal:localFogVolume:HeightFogOffset = 0 (
        displayName = "Height Fog Offset"
        doc = """Height offset, relative to the actor Z position."""
    )
    float unreal:localFogVolume:FogPhaseG = 0.2 (
        displayName = "Scattering Distribution"
        doc = """Controls the phase `G` parameter, describing the directionality of the scattering within this fog volume."""
    )
    color3f unreal:localFogVolume:FogAlbedo = (1, 1, 1) (
        displayName = "Fog Albedo"
        doc = """Controls the albedo of this fog volume."""
    )
    color3f unreal:localFogVolume:FogEmissive = (0, 0, 0) (
        displayName = "Fog Emissive"
        doc = """Controls the emissive color of this fog volume. (Unit = Luminance)"""
    )
    float unreal:localFogVolume:FogStartDistance = 0 (
        displayName = "Start Distance"
        doc = """Controls the distance after which this volume starts to appear. (Unit = Centimeter) This distance is clamped to be greater than r.LocalFogVolume.GlobalStartDistance."""
    )
    int unreal:localFogVolume:FogSortPriority = 0 (
        displayName = "Fog Sort Priority"
        doc = """The priority can be used as a way to override the sorting by distance. A lower value means the volume will be considered further away, i.e. it will draw behind the one with a higher priority value."""
    )
}

class UnrealPostProcessVolume "UnrealPostProcessVolume" (
    doc = """A UE Post Process Volume (APostProcessVolume), rendered by hdUE: a box filling the cube from -1 to 1 of the prim's local space (a Cube prim's default extent), whose unreal:postProcess:<FPostProcessSettings property> attributes blend into the view by UE's own rules (priority, blend radius and weight, unbound) while the camera is inside or near it. The render settings' unreal:postProcess:* apply after the volumes, as a camera's do in UE."""
)
{
    rel proxyPrim
    uniform token purpose = "default" (
        allowedTokens = ["default", "render", "proxy", "guide"]
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
    )
    uniform token[] xformOpOrder
    float unreal:postProcessVolume:Priority = 0 (
        displayName = "Priority"
        doc = """Priority of this volume. In the case of overlapping volumes the one with the highest priority overrides the lower priority ones. The order is undefined if two or more overlapping volumes have the same priority."""
    )
    float unreal:postProcessVolume:BlendRadius = 100 (
        displayName = "Blend Radius"
        doc = """World space radius around the volume that is used for blending (only if not unbound)."""
    )
    float unreal:postProcessVolume:BlendWeight = 1 (
        displayName = "Blend Weight"
        doc = """0:no effect, 1:full effect"""
    )
    bool unreal:postProcessVolume:bEnabled = true (
        displayName = "Enabled"
        doc = """Whether this volume is enabled or not."""
    )
    bool unreal:postProcessVolume:bUnbound = false (
        displayName = "Infinite Extent (Unbound)"
        doc = """Whether this volume covers the whole world, or just the area inside its bounds."""
    )
}

class UnrealExponentialHeightFog "UnrealExponentialHeightFog" (
    doc = """A UE Exponential Height Fog (UExponentialHeightFogComponent), rendered by hdUE: its density is FogDensity at the prim's height (its world position along the up axis). It takes the place of the render settings' unreal:heightFog; UE draws one height fog, the first prim by path."""
)
{
    rel proxyPrim
    uniform token purpose = "default" (
        allowedTokens = ["default", "render", "proxy", "guide"]
