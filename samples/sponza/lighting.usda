#usda 1.0
(
    doc = """Lighting and render settings for Intel's Sponza 2022 (NewSponza_Main_USD_Yup_003.usda, not included):
a sun and a sky dome, since the scene has no lights, and settings shared by hdUE and Karma.
scripts/render_gallery.py --sponza <file> sublayers this over the downloaded scene."""
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "lights"
{
    def DistantLight "sun"
    {
        bool inputs:normalize = 1
        float inputs:intensity = 1.5
        color3f inputs:color = (1, 0.93, 0.82)
        float inputs:angle = 0.53
        float3 xformOp:rotateXYZ = (-74, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "sky"
    {
        float inputs:intensity = 0.5
        color3f inputs:color = (0.55, 0.7, 1)
    }
}

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </root/PhysCamera001>
        uniform int2 resolution = (960, 540)
        rel products = </Render/Product>
        int hdUE:samplesPerPixel = 256
        token hdUE:renderMode = "pathtraced"
        token karma:global:convergence_mode = "Path Traced"
        int karma:global:pathtracedsamples = 256
        float karma:object:diffuselimit = 8
    }

    def RenderProduct "Product"
    {
        token productName = "sponza.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
