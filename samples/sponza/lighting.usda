#usda 1.0
(
    doc = """Lighting and render settings for Intel's Sponza 2022 (NewSponza_Main_USD_Yup_003.usda, not included):
a sun and a sky dome, since the scene has no lights, and settings shared by hdUE and Karma.
scripts/render_gallery.py --sponza <file> sublayers this over the downloaded scene."""
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "lights"
{
    # Fitted to Intel's own renders of this scene (samples/sponza/intel/main/reference, Render_Main_A and _C): the
    # exports carry no light settings, and the sun direction in the glTF/FBX does not light the areas Intel's renders
    # show lit. Sun direction from a sweep matched to the sunlit areas (azimuth 20 degrees from +Z towards +X,
    # elevation 75); exposures and colours by a least-squares fit of Karma renders to Intel's. Intensities stay 1.
    def DistantLight "sun"
    {
        bool inputs:normalize = 1
        float inputs:intensity = 1
        float inputs:exposure = 0.09
        color3f inputs:color = (1, 0.961, 0.903)
        float inputs:angle = 0.53
        matrix4d xformOp:transform = ( (0.939693, 0, -0.34202, 0), (-0.330366, 0.258819, -0.907673, 0), (0.088521, 0.965926, 0.24321, 0), (0, 0, 0, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def DomeLight "sky"
    {
        # Lights the scene without being seen through gaps in the geometry: hdUE's background visibility, and
        # Karma's equivalent (its default) so both renderers are told the same thing.
        bool hdue:visibleBackground = 0
        bool inputs:karma:light:renderlightgeo = 0
        float inputs:intensity = 1
        float inputs:exposure = -0.69
        color3f inputs:color = (0.751, 0.811, 1)
    }
}

over "root"
{
    over "PhysCamera001"
    {
        # 3ds Max's physical camera corrects vertical tilt (Intel's Render_Main_A has straight verticals): the camera
        # is levelled and the lens shifted instead, which keeps the aim point centred.
        float verticalApertureOffset = 4.972893
        matrix4d xformOp:transform = ( (-0.18552, 0, 0.98264, 0), (0, 1, 0, 0), (-0.98264, 0, -0.18552, 0), (-880.743, 159.222, -85.8258, 1) )
    }
}

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </root/PhysCamera001>
        uniform int2 resolution = (960, 540)
        rel products = </Render/Product>
        int hdUE:samplesPerPixel = 256
        token hdUE:renderMode = "pathtraced"
        token karma:global:convergence_mode = "Path Traced"
        int karma:global:pathtracedsamples = 256
        float karma:object:diffuselimit = 8
    }

    def RenderProduct "Product"
    {
        token productName = "sponza.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
