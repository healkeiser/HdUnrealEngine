            float inputs:metalness = 0
            vector3f inputs:normal.connect = </Materials/LeafSpring_USD/mtlx_normal.outputs:out>
            color3f inputs:opacity.connect = </Materials/LeafSpring_USD/mtlx_coverage.outputs:out>
            float inputs:specular = 0.5
            float inputs:specular_IOR = 1.5
            float inputs:specular_roughness = 0.45
            float inputs:subsurface = 0.5
            color3f inputs:subsurface_color.connect = </Materials/LeafSpring_USD/mtlx_base_color.outputs:out>
            bool inputs:thin_walled = 1
            token outputs:surface
        }

        def Shader "mtlx_uv"
        {
            uniform token info:id = "ND_geompropvalue_vector2"
            string inputs:geomprop = "map1"
            float2 outputs:out
        }

        def Shader "mtlx_base_color"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @./intel/cypress_tree/textures/Cypress_LF01_Spring_BaseColor.tga@ (
                colorSpace = "srgb_texture"
            )
            float2 inputs:texcoord.connect = </Materials/LeafSpring_USD/mtlx_uv.outputs:out>
            color3f outputs:out
        }

        def Shader "mtlx_opacity"
        {
            uniform token info:id = "ND_image_color4"
            asset inputs:file = @./intel/cypress_tree/textures/Cypress_LF01_Spring_BaseColor.tga@
            float2 inputs:texcoord.connect = </Materials/LeafSpring_USD/mtlx_uv.outputs:out>
            color4f outputs:out
        }

        def Shader "mtlx_alpha"
        {
            uniform token info:id = "ND_extract_color4"
            color4f inputs:in.connect = </Materials/LeafSpring_USD/mtlx_opacity.outputs:out>
            int inputs:index = 3
            float outputs:out
        }

        def Shader "mtlx_coverage"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Materials/LeafSpring_USD/mtlx_alpha.outputs:out>
            color3f outputs:out
        }

        def Shader "mtlx_normal_image"
        {
            uniform token info:id = "ND_image_vector3"
            asset inputs:file = @./intel/cypress_tree/textures/Cypress_LF01_Spring_Normal.png@
            float2 inputs:texcoord.connect = </Materials/LeafSpring_USD/mtlx_uv.outputs:out>
            vector3f outputs:out
        }

        def Shader "mtlx_normal"
        {
            uniform token info:id = "ND_normalmap_float"
            vector3f inputs:in.connect = </Materials/LeafSpring_USD/mtlx_normal_image.outputs:out>
            float inputs:scale = 1
            vector3f outputs:out
        }
    }

