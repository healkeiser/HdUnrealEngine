#usda 1.0
(
    doc = "MaterialX standard_surface networks for Intel's Sponza 2022 (main, curtains, cypress tree), generated by scripts/generate_sponza_materials.py from Intel's UsdPreviewSurface materials and texture maps. Sublayer it over the scene and its add-ons: hdUE and Karma render the mtlx context."
)

over "root"
{
    over "mtl"
    {
        over "arch_stone_wall_01_usd"
        {
            token outputs:mtlx:surface.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_surface.outputs:surface>

            def Shader "mtlx_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_base_color.outputs:out>
                float inputs:metalness = 0
                vector3f inputs:normal.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_normal.outputs:out>
                float inputs:specular = 1
                float inputs:specular_IOR = 1.5
                float inputs:specular_roughness.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_roughness.outputs:out>
                token outputs:surface
            }

            def Shader "mtlx_uv"
            {
                uniform token info:id = "ND_geompropvalue_vector2"
                string inputs:geomprop = "st"
                float2 outputs:out
            }

            def Shader "mtlx_base_color"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @./intel/main/textures/arch_stone_wall_01_BaseColor.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_uv.outputs:out>
                color3f outputs:out
            }

            def Shader "mtlx_roughness"
            {
                uniform token info:id = "ND_image_float"
                asset inputs:file = @./intel/main/textures/arch_stone_wall_01_Roughness.png@
                float2 inputs:texcoord.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_uv.outputs:out>
                float outputs:out
            }

            def Shader "mtlx_normal_image"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @./intel/main/textures/arch_stone_wall_01_Normal.png@
                float2 inputs:texcoord.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_uv.outputs:out>
                vector3f outputs:out
            }

            def Shader "mtlx_normal"
            {
                uniform token info:id = "ND_normalmap_float"
                vector3f inputs:in.connect = </root/mtl/arch_stone_wall_01_usd/mtlx_normal_image.outputs:out>
                float inputs:scale = 1
                vector3f outputs:out
            }
        }

        over "brickwall_01_usd"
