#usda 1.0
(
    doc = "An UnrealDecal (resources/generatedSchema.usda) projecting a Substrate Builder decal material (a red Slab through Substrate Convert To Decal, authored with substrate_graph.author()) onto the middle of a white wall. The decal is rotated 90 degrees about X, so its local down axis (-Y) points into the wall (-Z). tests/houdini/python3.13libs/hdue_decal_test.py prepares it in the Houdini viewport."
    endTimeCode = 1
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    startTimeCode = 1
    subLayers = [
        @../conformance/common/stage.usda@
    ]
    upAxis = "Y"
)

def "Looks"
{
    def Material "Paint"
    {
        token outputs:surface.connect = </Looks/Paint/Preview.outputs:surface>
        token outputs:unreal:surface.connect = </Looks/Paint/Graph/decal.outputs:out>
        custom int unreal:substrate:version = 1

        def "Graph"
        {
            def Shader "paint"
            {
                uniform token info:id = "unreal:substrate:slab"
                color3f inputs:diffuse_albedo = (0.8, 0.05, 0.05)
                color3f inputs:diffuse_albedo.connect = None
                color3f inputs:emission = None
                color3f inputs:emission.connect = None
                color3f inputs:f0 = (0.04, 0.04, 0.04)
                color3f inputs:f0.connect = None
                color3f inputs:f90 = None
                color3f inputs:f90.connect = None
                color3f inputs:mfp = (0, 0, 0)
                color3f inputs:mfp.connect = None
                color3f inputs:normal = None
                color3f inputs:normal.connect = None
                float inputs:roughness = 0.5
                float inputs:roughness.connect = None
                float inputs:second_roughness = None
                float inputs:second_roughness.connect = None
                float inputs:second_roughness_weight = None
                float inputs:second_roughness_weight.connect = None
                string inputs:subsurface = "none"
                string inputs:subsurface.connect = None
                token outputs:out
            }

            def Shader "decal"
            {
                uniform token info:id = "unreal:substrate:decal"
                float inputs:coverage = 1
                float inputs:coverage.connect = None
                token inputs:surface.connect = </Looks/Paint/Graph/paint.outputs:out>
                token outputs:out
            }
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.18, 0.18, 0.18)
            token outputs:surface
        }
    }
}

def Cube "Wall"
{
    double size = 1
    float3 xformOp:scale = (12, 12, 0.1)
    uniform token[] xformOpOrder = ["xformOp:scale"]
}

def UnrealDecal "Decal" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Looks/Paint>
    float3 xformOp:rotateXYZ = (90, 0, 0)
    float3 xformOp:scale = (2, 1, 2)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ", "xformOp:scale"]
}

