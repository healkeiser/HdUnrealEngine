        {
            token outputs:mtlx:surface.connect = </atmosphere/Looks/dust/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.92, 0.88)
                float inputs:specular_roughness = 0.6
                token outputs:surface
            }
        }
    }
}

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </BistroInterior/group13/Camera>
        uniform int2 resolution = (640, 360)
        rel products = </Render/Product>
        token unreal:renderMode = "realtime"
        int unreal:samplesPerPixel = 256
        # The images show UE's tone-mapped frame, as UE's editor viewport shows it.
        bool unreal:tonemapper = 1
        # A night interior lit by its lamps: one stop over the manual exposure UE starts from.
        float unreal:postProcess:AutoExposureBias = 1
        # Haze: a thin volumetric height fog the lamps light into cones.
        bool unreal:heightFog = 1
        float unreal:heightFog:FogDensity = 0.05
        float unreal:heightFog:FogHeightFalloff = 0.02
        bool unreal:heightFog:bEnableVolumetricFog = 1
        # Grade: a touch of film grain and a slightly warm white balance.
        float unreal:postProcess:FilmGrainIntensity = 0.12
        float unreal:postProcess:WhiteTemp = 6000
    }

    def RenderProduct "Product"
    {
        token productName = "bistro.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
