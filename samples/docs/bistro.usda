#usda 1.0
(
    doc = """The interior of Amazon Lumberyard Bistro (NVIDIA ORCA, CC BY 4.0), converted by scripts/convert_bistro.py with
MaterialX standard surfaces, lit by a light in each of its lamps and its HDRI (San Giuseppe Bridge, Poly Haven, CC0), both
written by the conversion (bistro_lights.usda). Not committed: run the conversion first (samples/bistro/README.md)."""
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../bistro/usd/bistro_lights.usda@, @../bistro/usd/bistro_interior.usdc@]
)

over "BistroInterior"
{
    over "group13"
    {
        over "Camera"
        {
            # A photographer's choice: f/2.8, focused on the near table's glasses.
            float fStop = 2.8
            float focusDistance = 1.37
        }
    }
}

def Xform "atmosphere"
{
    def SphereLight "key" (prepend apiSchemas = ["ShapingAPI"])
    {
        # The shot's key: a warm pin spot from the ceiling onto the near table, as a restaurant lights its tables;
        # the room's lamps become the fill and the background falls off.
        float inputs:radius = 0.04
        float inputs:intensity = 1
        float inputs:exposure = 12
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 3000
        float inputs:shaping:cone:angle = 22
        float inputs:shaping:cone:softness = 0.5
        float unreal:light:VolumetricScatteringIntensity = 2
        double3 xformOp:translate = (4.85, 4.4, -2.4)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Points "dust" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        # 700 motes of 1.5-3 mm inside the key spot's cone, where dust shows: in the beam.
