#usda 1.0
(
    doc = """Game effects: three Niagara Systems from Epic's Niagara Examples Pack (Fab, a local download prepared with scripts/Prepare-ProjectAssets.ps1) on the light study's floor at dusk: fire, a Tesla coil's arcs and a loop of electricity. Each starts at frame 1 and is simulated to the frame rendered."""
    defaultPrim = "scene"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 96
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@./lights.usda@]
)

over "scene"
{
    over "sky"
    {
        float inputs:exposure = -5
    }

    over "key"
    {
        float inputs:exposure = 1
    }

    # A placeholder box: hdUE renders the cooked asset (primvars:unreal:asset) in its place.
    def Mesh "fire"
    {
        string primvars:unreal:asset = "/Game/NiagaraExamples/FX_Misc/NS_Fire.NS_Fire" (interpolation = "constant")
        point3f[] points = [(-0.1, 0, -0.1), (-0.1, 0, 0.1), (-0.1, 0.2, -0.1), (-0.1, 0.2, 0.1), (0.1, 0, -0.1), (0.1, 0, 0.1), (0.1, 0.2, -0.1), (0.1, 0.2, 0.1)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        float primvars:unreal:effect:startFrame = 1 (interpolation = "constant")
        double3 xformOp:translate = (0, 0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # A placeholder box: hdUE renders the cooked asset (primvars:unreal:asset) in its place.
    def Mesh "coil"
    {
        string primvars:unreal:asset = "/Game/NiagaraExamples/FX_Ribbons/NS_TeslaCoil.NS_TeslaCoil" (interpolation = "constant")
        point3f[] points = [(-0.1, 0, -0.1), (-0.1, 0, 0.1), (-0.1, 0.2, -0.1), (-0.1, 0.2, 0.1), (0.1, 0, -0.1), (0.1, 0, 0.1), (0.1, 0.2, -0.1), (0.1, 0.2, 0.1)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        float primvars:unreal:effect:startFrame = 1 (interpolation = "constant")
        double3 xformOp:translate = (1.5, 0, -1.8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # A placeholder box: hdUE renders the cooked asset (primvars:unreal:asset) in its place.
    def Mesh "electricity"
    {
        string primvars:unreal:asset = "/Game/NiagaraExamples/FX_Player/NS_Player_Electricity_Looping.NS_Player_Electricity_Looping" (interpolation = "constant")
        point3f[] points = [(-0.1, 0, -0.1), (-0.1, 0, 0.1), (-0.1, 0.2, -0.1), (-0.1, 0.2, 0.1), (0.1, 0, -0.1), (0.1, 0, 0.1), (0.1, 0.2, -0.1), (0.1, 0.2, 0.1)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        float primvars:unreal:effect:startFrame = 1 (interpolation = "constant")
        double3 xformOp:translate = (-1.7, 0, -1.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
