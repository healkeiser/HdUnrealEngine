#usda 1.0
(
    doc = """The street outside Amazon Lumberyard Bistro (NVIDIA ORCA, CC BY 4.0), converted by scripts/convert_bistro.py
--scene exterior, at night: its street lamps, a cool moon, the daylight HDRI (San Giuseppe Bridge, Poly Haven, CC0)
dimmed to a sky glow, haze and dust. Not committed: run the conversion first (samples/bistro/README.md)."""
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../bistro/usd/bistro_exterior_lights.usda@, @../bistro/usd/bistro_exterior.usdc@]
)

over "lamps"
{
    over "sky"
    {
        # Night: the daylight HDRI dimmed to a faint sky glow.
        float inputs:exposure = -7
    }
    # Street lamps: 2 stops over the conversion's 10, warm-white (3000 K) against the blue moonlight.
    over "lamp00"
    {
        float inputs:exposure = 12
        float inputs:colorTemperature = 3000
    }

