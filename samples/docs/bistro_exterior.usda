def Xform "night"
{
    def DistantLight "moon"
    {
        # The moon behind the street, high enough (35 degrees) to clear the rooftops, aimed at the camera from a little left: its sheen on the wet cobbles shapes the
        # street, it rims the Vespa, and the mist glows blue.
        float inputs:angle = 0.53
        bool inputs:normalize = 1
        float inputs:intensity = 1
        float inputs:exposure = 1.5
        float unreal:light:VolumetricScatteringIntensity = 0.25
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 12000
        float3 xformOp:rotateXYZ = (-35, 153.113, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

