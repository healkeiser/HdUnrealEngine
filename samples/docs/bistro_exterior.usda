, 0.0039, 0.0044, 0.0049, 0.0056, 0.0059, 0.0057, 0.0042, 0.0050, 0.0056, 0.0044, 0.0045, 0.0056, 0.0049, 0.0044, 0.0040, 0.0050, 0.0040, 0.0042, 0.0047, 0.0044, 0.0049, 0.0038, 0.0060, 0.0053, 0.0043, 0.0058, 0.0039, 0.0049, 0.0044, 0.0037, 0.0052, 0.0049, 0.0051, 0.0057, 0.0039, 0.0040, 0.0054, 0.0038, 0.0047, 0.0037, 0.0037, 0.0037, 0.0060, 0.0056, 0.0055, 0.0046, 0.0054, 0.0037, 0.0056, 0.0056, 0.0056, 0.0050, 0.0050] (interpolation = "vertex")
        rel material:binding = </night/Looks/dust>
    }

    def Scope "Looks"
    {
        def Material "dust"
        {
            token outputs:mtlx:surface.connect = </night/Looks/dust/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.92, 0.88)
                float inputs:specular_roughness = 0.6
                # Dust lit from behind glows (it scatters light forward); matte spheres would read as dark specks.
                float inputs:emission = 0.1
                color3f inputs:emission_color = (1, 0.93, 0.82)
                token outputs:surface
            }
        }
    }
}

def Camera "shot"
{
    # Low, 35 mm, 10 m from the Vespa on the right third, the wet street and its lamps receding into the mist; f/2.8.
    float focalLength = 0.35
    float horizontalAperture = 0.36
    float verticalAperture = 0.2025
    float2 clippingRange = (0.05, 1000)
    float fStop = 2.8
    float focusDistance = 10.0
    double3 xformOp:translate = (-14.346, 0.900, 7.420)
    float3 xformOp:rotateXYZ = (2.217, -34.887, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </shot>
        uniform int2 resolution = (640, 360)
        rel products = </Render/Product>
        token unreal:renderMode = "realtime"
        int unreal:samplesPerPixel = 256
        bool unreal:tonemapper = 1
        # Night exposure: the street lit by its lamps.
        float unreal:postProcess:AutoExposureBias = 0.5
        # Haze that thins with height: the lamps draw cones and halos in it.
        bool unreal:heightFog = 1
        float unreal:heightFog:FogDensity = 0.12
        # Blue-teal mist in the distance (UE's non-volumetric fog colour); the volumetric fog scatters the lamps and moon.
        color3f unreal:heightFog:FogInscatteringLuminance = (0.02, 0.04, 0.07)
        # Mist scatters light forward: looking toward the moon, it glows, and the wet street mirrors it.
        float unreal:heightFog:VolumetricFogScatteringDistribution = 0.7
        float unreal:heightFog:FogHeightFalloff = 0.05
        bool unreal:heightFog:bEnableVolumetricFog = 1
        # Grade: a cool white balance against the warm lamps, and grain.
        float unreal:postProcess:WhiteTemp = 4600
        float unreal:postProcess:FilmGrainIntensity = 0.12
    }

    def RenderProduct "Product"
    {
        token productName = "bistro_exterior.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
