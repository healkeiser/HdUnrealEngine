#usda 1.0
(
    doc = """A 6 x 3 x 6 m room lit only through a window in its left wall, by the sun and the sky: global illumination does the rest."""
    defaultPrim = "scene"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@./stage.usda@]
)

over "scene"
{
    over "Looks"
    {
        def Material "plaster"
        {
            token outputs:surface.connect = </scene/Looks/plaster/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.73, 0.7)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "wood"
        {
            token outputs:surface.connect = </scene/Looks/wood/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.2, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "fabric"
        {
            token outputs:surface.connect = </scene/Looks/fabric/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.25, 0.45)
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }

    over "floor" (active = false)
    {
    }

    def Cube "floor_slab" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wood>
        double3 xformOp:translate = (0, -0.05, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (6.4, 0.1, 6.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "ceiling" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (0, 3.05, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (6.4, 0.1, 6.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "back" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (0, 1.5, -3.05)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (6.4, 3.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "right" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (3.05, 1.5, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 3.2, 6.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "front" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (0, 1.5, 3.05)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (6.4, 3.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "left_low" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (-3.05, 0.4, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 0.9, 6.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "left_high" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (-3.05, 2.8, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 0.8, 6.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "left_back" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (-3.05, 1.6, -2.1)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 1.8, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "left_front" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/plaster>
        double3 xformOp:translate = (-3.05, 1.6, 2.1)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 1.8, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "sofa" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/fabric>
        double3 xformOp:translate = (1.5, 0.25, -2.2)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (2.2, 0.5, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "sofa_back" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/fabric>
        double3 xformOp:translate = (1.5, 0.6, -2.6)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (2.2, 0.7, 0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "table" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wood>
        double3 xformOp:translate = (0.6, 0.2, -0.6)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1.2, 0.4, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def DistantLight "sun"
    {
        float inputs:angle = 0.53
        # Normalized: intensity is illuminance, not the radiance of the 0.53 degree disk.
        bool inputs:normalize = 1
        float inputs:intensity = 1
        float inputs:exposure = 4
        double3 xformOp:translate = (0, 0, 0)
        float3 xformOp:rotateXYZ = (-36.04, -75.964, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "camera"
    {
        float focalLength = 18
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.05, 1000)
        double3 xformOp:translate = (2.6, 1.5, 2.6)
        float3 xformOp:rotateXYZ = (-5.236, 41.285, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
