#usda 1.0
(
    doc = """Beam in fog: a closed 8 m room, a spot light shining down through UE's Exponential Height Fog with Volumetric Fog on, and a sphere in the beam."""
    defaultPrim = "scene"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@./stage.usda@]
)

over "scene"
{
    over "sky" (active = false)
    {
    }

    over "floor" (active = false)
    {
    }

    over "Looks"
    {
        def Material "wall"
        {
            token outputs:surface.connect = </scene/Looks/wall/S.outputs:surface>
            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.4)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "floor_slab" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (0, -0.05, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (8, 0.1, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "ceiling" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (0, 4.05, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (8, 0.1, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "back" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (0, 2, -4.05)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (8, 4.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "left" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (-4.05, 2, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 4.2, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "right" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (4.05, 2, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.1, 4.2, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "front" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (0, 2, 4.05)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (8, 4.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Sphere "ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.4
        rel material:binding = </scene/Looks/wall>
        double3 xformOp:translate = (0.5, 1.2, 0.12)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def SphereLight "spot" (prepend apiSchemas = ["ShapingAPI"])
    {
        float inputs:radius = 0.05
        float inputs:intensity = 1
        float inputs:exposure = 14
        float inputs:shaping:cone:angle = 15
        float inputs:shaping:cone:softness = 0.1
        double3 xformOp:translate = (-0.5, 3.9, -0.5)
        float3 xformOp:rotateXYZ = (-71.926, -135.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "camera"
    {
        # USD lens values are tenths of a scene unit: in this metre stage, 24 mm is 0.24.
        float focalLength = 0.24
        float horizontalAperture = 0.36
        float verticalAperture = 0.2025
        float2 clippingRange = (0.05, 1000)
        double3 xformOp:translate = (0, 1.6, 3.8)
        float3 xformOp:rotateXYZ = (3.013, 0.0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

over "Render"
{
    over "Settings"
    {
        bool unreal:heightFog = 1
        float unreal:heightFog:FogDensity = 0.3
        bool unreal:heightFog:bEnableVolumetricFog = 1
    }
}
