#usda 1.0
(
    doc = """SideFX's Veach MIS planks (four glossy planks of increasing roughness under four sphere lights of increasing size): light size against surface roughness, with hdUE render settings."""
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    # Houdini's sample scenes: ${HFS} is this default unless the root layer opening this scene sets it
    # (scripts/render_docs_images.py sets it to $HFS).
    expressionVariables = {
        string HFS = "C:/Program Files/Side Effects Software/Houdini 22.0.368"
    }
    subLayers = [@`"${HFS}/houdini/usd/scenes/veach_mis_planks/veach_mis_planks.usd"`@]
)

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (640, 480)
        rel products = </Render/Product>
        token unreal:renderMode = "realtime"
        int unreal:samplesPerPixel = 256
        int unreal:subdivisionLevel = 2
        # The images show UE's tone-mapped frame, as UE's editor viewport shows it.
        bool unreal:tonemapper = 1
    }

    def RenderProduct "Product"
    {
        token productName = "docs.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
