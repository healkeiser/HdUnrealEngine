#usda 1.0
(
    doc = """SideFX's material lookdev scene (shader ball in a studio box, its own lights and camera) with hdUE render settings. The guide's material figures bind /scene/Looks/ball to the ball's surface and override its inputs."""
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    # Houdini's sample scenes: ${HFS} is this default unless the root layer opening this scene sets it
    # (scripts/render_docs_images.py sets it to $HFS).
    expressionVariables = {
        string HFS = "C:/Program Files/Side Effects Software/Houdini 22.0.368"
    }
    subLayers = [@`"${HFS}/houdini/usd/scenes/material_lookdev/standard_shader_ball.usd"`@]
)

def Scope "scene"
{
    def Scope "Looks"
    {
        def Material "ball"
        {
            token outputs:surface.connect = </scene/Looks/ball/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.25, 0.08)
                float inputs:roughness = 0.3
                float inputs:metallic = 0
                token outputs:surface
            }
        }
    }
}

over "World"
{
    over "shader_ball"
    {
        over "material_surface" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            rel material:binding = </scene/Looks/ball>
        }
    }
}

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (640, 480)
        rel products = </Render/Product>
        token unreal:renderMode = "realtime"
        int unreal:samplesPerPixel = 256
        int unreal:subdivisionLevel = 2
        # The images show UE's tone-mapped frame, as UE's editor viewport shows it.
        bool unreal:tonemapper = 1
    }

    def RenderProduct "Product"
    {
        token productName = "docs.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
