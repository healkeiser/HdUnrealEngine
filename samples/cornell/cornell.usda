#usda 1.0
(
    doc = """Gallery base scene: the CC0 Cornell box (cornell-box.usda, unchanged) with the canonical Cornell camera,
its ceiling light as a UsdLux RectLight of the same size and radiance, and render settings shared by hdUE and Karma."""
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@./cornell-box.usda@]
)

over "cornell_box"
{
    # Cornell data space (metres, Y up, inside the root transform).
    over "light" (active = false)
    {
    }

    def RectLight "ceiling_light"
    {
        # Same quad and radiance as the emissive light mesh (17, 12, 4), sampled directly by both renderers.
        float inputs:width = 1.3
        float inputs:height = 1.05
        float inputs:intensity = 1
        float inputs:exposure = 4.087
        color3f inputs:color = (1, 0.70588, 0.23529)
        double3 xformOp:translate = (2.78, 5.487, 2.795)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "camera"
    {
        # Cornell camera: 35 mm lens, 25 x 25 mm film, at (278, 273, -800) cm looking +Z.
        float focalLength = 35
        float horizontalAperture = 25
        float verticalAperture = 25
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (2.78, 2.73, -8)
        float3 xformOp:rotateXYZ = (0, 180, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def Scope "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </cornell_box/camera>
        uniform int2 resolution = (512, 512)
        rel products = </Render/Product>
        int hdUE:samplesPerPixel = 512
        token hdUE:renderMode = "pathtraced"
        token karma:global:convergence_mode = "Path Traced"
        int karma:global:pathtracedsamples = 512
        # Karma traces one diffuse bounce by default; the UE Path Tracer up to 32 (PathTracingMaxBounces).
        float karma:object:diffuselimit = 8
    }

    def RenderProduct "Product"
    {
        token productName = "cornell.exr"
        rel orderedVars = [</Render/Vars/color>]
    }

    def Scope "Vars"
    {
        def RenderVar "color"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "C.*[LO]"
            uniform token sourceType = "lpe"
            string driver:parameters:aov:name = "C"
            token driver:parameters:aov:format = "color4f"
        }
    }
}
