#usda 1.0
(
    doc = "Preview Surface clearcoat: red lacquer (clearcoat 1 over a rough red base, left) next to the same base without a coat (right)."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    def Material "lacquer"
    {
        token outputs:surface.connect = </cornell_box/lacquer/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.05, 0.04)
            float inputs:roughness = 0.6
            float inputs:clearcoat = 1
            float inputs:clearcoatRoughness = 0.03
            token outputs:surface
        }
    }
    def Material "base"
    {
        token outputs:surface.connect = </cornell_box/base/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.05, 0.04)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
    over "tall_box_front" (active = false)
    {
    }
    over "tall_box_right" (active = false)
    {
    }
    over "tall_box_back" (active = false)
    {
    }
    over "tall_box_left" (active = false)
    {
    }
    over "tall_box_top" (active = false)
    {
    }
    over "short_box_back" (active = false)
    {
    }
    over "short_box_right" (active = false)
    {
    }
    over "short_box_front" (active = false)
    {
    }
    over "short_box_left" (active = false)
    {
    }
    over "short_box_top" (active = false)
    {
    }
    def Sphere "lacquered" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.8
        rel material:binding = </cornell_box/lacquer>
        double3 xformOp:translate = (3.5, 0.8, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "uncoated" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.8
        rel material:binding = </cornell_box/base>
        double3 xformOp:translate = (1.9, 0.8, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
