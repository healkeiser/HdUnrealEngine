#usda 1.0
(
    doc = "A warm light linked only to the tall box and a cool one only to the short box; the ceiling light lights everything. Lumen still bounces the linked lights onto every surface: UE’s lighting channels only restrict direct light."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    over "ceiling_light"
    {
        float inputs:intensity = 6
    }
    def SphereLight "warm" (prepend apiSchemas = ["CollectionAPI:lightLink"])
    {
        float inputs:radius = 0.15
        float inputs:intensity = 400
        color3f inputs:color = (1, 0.45, 0.15)
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = [</cornell_box/tall_box_front>, </cornell_box/tall_box_right>, </cornell_box/tall_box_back>, </cornell_box/tall_box_left>, </cornell_box/tall_box_top>]
        double3 xformOp:translate = (1.2, 3.6, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def SphereLight "cool" (prepend apiSchemas = ["CollectionAPI:lightLink"])
    {
        float inputs:radius = 0.15
        float inputs:intensity = 400
        color3f inputs:color = (0.15, 0.45, 1)
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = [</cornell_box/short_box_back>, </cornell_box/short_box_right>, </cornell_box/short_box_front>, </cornell_box/short_box_left>, </cornell_box/short_box_top>]
        double3 xformOp:translate = (4.4, 2.2, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
