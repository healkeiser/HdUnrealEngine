#usda 1.0
(
    doc = "Horizontal and vertical aperture offsets (lens shift)."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    over "camera"
    {
        float horizontalApertureOffset = 5
        float verticalApertureOffset = 4
    }
}
