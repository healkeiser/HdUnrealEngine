#usda 1.0
(
    doc = "Glossy metal on the tall box and a glossy dielectric ball."
    defaultPrim = "cornell_box"
    metersPerUnit = 1
    upAxis = "Z"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../cornell.usda@]
)

over "cornell_box"
{
    def Material "metal"
    {
        token outputs:surface.connect = </cornell_box/metal/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.8, 0.6)
            float inputs:roughness = 0.25
            float inputs:metallic = 1.0
            token outputs:surface
        }
    }
    def Material "gloss"
    {
        token outputs:surface.connect = </cornell_box/gloss/S.outputs:surface>
        def Shader "S"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.1, 0.25, 0.8)
            float inputs:roughness = 0.15
            float inputs:metallic = 0.0
            token outputs:surface
        }
    }
    over "tall_box_front"
    {
        over "tall_box_front"
        {
            rel material:binding = </cornell_box/metal>
        }
    }
    over "tall_box_right"
    {
        over "tall_box_right"
        {
            rel material:binding = </cornell_box/metal>
        }
    }
    over "tall_box_back"
    {
        over "tall_box_back"
        {
            rel material:binding = </cornell_box/metal>
        }
    }
    over "tall_box_left"
    {
        over "tall_box_left"
        {
            rel material:binding = </cornell_box/metal>
        }
    }
    over "tall_box_top"
    {
        over "tall_box_top"
        {
            rel material:binding = </cornell_box/metal>
        }
    }
    def Sphere "ball" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.6
        rel material:binding = </cornell_box/gloss>
        double3 xformOp:translate = (4.4, 0.6, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
