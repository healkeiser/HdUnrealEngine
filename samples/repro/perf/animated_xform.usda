#usda 1.0
(
    defaultPrim = "World"
    doc = """One mesh whose only animation is its transform, to time husk's per-frame mesh Sync (HDUE_TRACE_TIMING
"mesh sync since last submit"). The cube is refined to level 5 (6,144 quads), so a Sync that rebuilds the geometry
(primvars, subdivision, triangulation, hashing) shows next to one that only moves it. Motion blur on (shutter
-0.25..0.25). Render: husk --renderer "Unreal Engine" -f 1 -n 10 samples/repro/perf/animated_xform.usda"""
    endTimeCode = 10
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "cube"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
        point3f[] points = [(-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5), (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5)]
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        uniform token subdivisionScheme = "catmullClark"
        int primvars:unreal:subdivisionLevel = 5
        color3f[] primvars:displayColor = [(0.7, 0.45, 0.2)]
        double3 xformOp:translate.timeSamples = {1: (-1.5, 0, 0), 10: (1.5, 0, 0)}
        float3 xformOp:rotateXYZ.timeSamples = {1: (0, 0, 0), 10: (0, 270, 0)}
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "camera"
    {
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 36
        double shutter:open = -0.25
        double shutter:close = 0.25
        double3 xformOp:translate = (0, 0.5, 5)
        float3 xformOp:rotateXYZ = (-5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DistantLight "sun"
    {
        float inputs:intensity = 1
        float inputs:exposure = 2
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "sky"
    {
        color3f inputs:color = (0.6, 0.7, 0.9)
        float inputs:intensity = 1
        float inputs:exposure = -1
    }
}

def "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/camera>
        uniform int2 resolution = (320, 320)
        custom token unreal:renderMode = "realtime"
    }
}
