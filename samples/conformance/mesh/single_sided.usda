#usda 1.0
(
    doc = """With unreal:cullBackface = 0, hdUE renders both sides of every mesh, as Karma does (its karma:object:cull_backface
defaults to off); by default it culls single-sided back faces, as UE's USD importer does (mesh/double_sided). Left: a single-sided
reference quad facing the camera. Right: the same quad wound clockwise (facing away), single-sided: visible and lit
like the reference."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMesh",
 "feature": "unreal:cullBackface = 0 renders single-sided back faces (as Karma)",
 "frames": 1,
 "checks": [
  {
   "name": "single-sided back face visible",
   "value": {
    "region": [
     0.9,
     -1,
     3.1,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "back face lit like the front",
   "ratio": [
    {
     "region": [
      0.9,
      -1,
      3.1,
      1
     ]
    },
    {
     "region": [
      -3.1,
      -1,
      -0.9,
      1
     ]
    }
   ],
   "min": 0.6,
   "max": 1.6
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        bool unreal:cullBackface = 0
    }
}
def Mesh "Front"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3.5, -1.5, 0), (-0.5, -1.5, 0), (-0.5, 1.5, 0), (-3.5, 1.5, 0)]
        uniform token subdivisionScheme = "none"
}
def Mesh "Back"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(0.5, -1.5, 0), (3.5, -1.5, 0), (3.5, 1.5, 0), (0.5, 1.5, 0)]
        uniform token subdivisionScheme = "none"
}
