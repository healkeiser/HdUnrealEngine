#usda 1.0
(
    doc = """purpose classifies geometry; final renders include the RenderSettings includedPurposes, by default
["default", "render"]. Left to right: default, render, proxy, guide cubes; only the first two render."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomImageable",
 "feature": "purpose",
 "frames": 1,
 "checks": [
  {
   "name": "default",
   "value": {
    "region": [
     -3.3,
     -0.3,
     -2.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "render",
   "value": {
    "region": [
     -1.3,
     -0.3,
     -0.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "proxy",
   "value": {
    "region": [
     0.7,
     -0.3,
     1.3,
     0.3
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "guide",
   "value": {
    "region": [
     2.7,
     -0.3,
     3.3,
     0.3
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Cube "default"
{
        double size = 1.0
        uniform token purpose = "default"
        double3 xformOp:translate = (-3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "render"
{
        double size = 1.0
        uniform token purpose = "render"
        double3 xformOp:translate = (-1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "proxy"
{
        double size = 1.0
        uniform token purpose = "proxy"
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "guide"
{
        double size = 1.0
        uniform token purpose = "guide"
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
