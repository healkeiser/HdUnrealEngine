#usda 1.0
(
    doc = """triangleSubdivisionRule (catmullClark scheme only): "catmullClark" uses Catmull-Clark weights on triangles,
"smooth" uses weights that give a smoother, rounder surface; on a tetrahedron cage the smooth rule's surface is much
smaller (OpenSubdiv in Houdini's Subdivide SOP at two levels: 0.78 x the catmullClark rule's size). Two tetrahedron
cages: x = -2.5 catmullClark rule, x = 2.5 smooth rule."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMesh",
 "feature": "triangleSubdivisionRule catmullClark vs smooth",
 "frames": 1,
 "checks": [
  {
   "name": "catmullClark rule renders",
   "value": {
    "region": [
     -2.8,
     -0.3,
     -2.2,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "smooth rule is smaller",
   "ratio": [
    {
     "region": [
      0,
      -4,
      5,
      4
     ],
     "stat": "coverage"
    },
    {
     "region": [
      -5,
      -4,
      0,
      4
     ],
     "stat": "coverage"
    }
   ],
   "min": 0.4,
   "max": 0.8
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Mesh "CatmullClark"
{
    int[] faceVertexCounts = [3, 3, 3, 3]
    int[] faceVertexIndices = [0, 1, 2, 0, 3, 1, 0, 2, 3, 1, 3, 2]
    point3f[] points = [(3, 3, 3), (3, -3, -3), (-3, 3, -3), (-3, -3, 3)]
    uniform token subdivisionScheme = "catmullClark"
    uniform bool doubleSided = 1
    double3 xformOp:translate = (-2.5, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Mesh "Smooth"
{
    int[] faceVertexCounts = [3, 3, 3, 3]
    int[] faceVertexIndices = [0, 1, 2, 0, 3, 1, 0, 2, 3, 1, 3, 2]
    point3f[] points = [(3, 3, 3), (3, -3, -3), (-3, 3, -3), (-3, -3, 3)]
    uniform token subdivisionScheme = "catmullClark"
    uniform bool doubleSided = 1
    token triangleSubdivisionRule = "smooth"
    double3 xformOp:translate = (2.5, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
over "Render"
{
    over "Settings"
    {
        # hdUE leaves subdivision surfaces unrefined by default, as UE's USD Stage Actor does (SubdivisionLevel 0).
        int unreal:subdivisionLevel = 2
    }
}
