#usda 1.0
(
    doc = """doubleSided = true instructs every renderer to draw both sides and to light each side with a forward-facing
normal; a single-sided mesh may cull its back faces, which hdUE does under hdUE:cullBackface (set here). Left: a
single-sided reference quad facing the camera. Middle: the same quad wound clockwise (facing away), doubleSided: it
must be visible and lit like the reference. Right: the clockwise quad, single-sided: culled."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMesh",
 "feature": "doubleSided (hdUE:cullBackface)",
 "frames": 1,
 "checks": [
  {
   "name": "front face visible",
   "value": {
    "region": [
     -4.0,
     -1,
     -2.0,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "double-sided back face visible",
   "value": {
    "region": [
     -1.0,
     -1,
     1.0,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "back face lit like the front",
   "ratio": [
    {
     "region": [
      -1.0,
      -1,
      1.0,
      1
     ]
    },
    {
     "region": [
      -4.0,
      -1,
      -2.0,
      1
     ]
    }
   ],
   "min": 0.6,
   "max": 1.6
  },
  {
   "name": "single-sided back face culled",
   "value": {
    "region": [
     2.0,
     -1,
     4.0,
     1
    ],
    "stat": "coverage"
   },
   "max": 0.1
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        bool hdUE:cullBackface = 1
    }
}
def Mesh "Front"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4.4, -1.5, 0), (-1.6, -1.5, 0), (-1.6, 1.5, 0), (-4.4, 1.5, 0)]
        uniform token subdivisionScheme = "none"
}
def Mesh "Back"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(-1.4, -1.5, 0), (1.4, -1.5, 0), (1.4, 1.5, 0), (-1.4, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
}
def Mesh "Culled"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(1.6, -1.5, 0), (4.4, -1.5, 0), (4.4, 1.5, 0), (1.6, 1.5, 0)]
        uniform token subdivisionScheme = "none"
}
