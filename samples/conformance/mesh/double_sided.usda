#usda 1.0
(
    doc = """doubleSided = true instructs every renderer to draw both sides and to light each side with a forward-facing
normal. Left: a reference quad facing the camera. Right: the same quad wound clockwise (facing away), doubleSided:
it must be visible and lit like the reference. (Culling single-sided back faces is allowed, not required.)"""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMesh",
 "feature": "doubleSided",
 "frames": 1,
 "checks": [
  {
   "name": "double-sided back face visible",
   "value": {
    "region": [
     1,
     -1,
     3,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "back face lit like the front",
   "ratio": [
    {
     "region": [
      1,
      -1,
      3,
      1
     ]
    },
    {
     "region": [
      -3,
      -1,
      -1,
      1
     ]
    }
   ],
   "min": 0.6,
   "max": 1.6
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Mesh "Front"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3.5, -1.5, 0), (-0.5, -1.5, 0), (-0.5, 1.5, 0), (-3.5, 1.5, 0)]
        uniform token subdivisionScheme = "none"
}
def Mesh "Back"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(0.5, -1.5, 0), (3.5, -1.5, 0), (3.5, 1.5, 0), (0.5, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
}
