#usda 1.0
(
    doc = """A UsdPrimvarReader_float2 reads the primvar named by its varname. The mesh carries st (constant, inside the red
half) and st1 (0..1 across the quad); the material reads st1, so the left half is red and the right half blue."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMesh",
 "feature": "multiple UV sets (st, st1)",
 "frames": 1,
 "checks": [
  {
   "name": "st1 left red",
   "color": {
    "region": [
     -2.8,
     -0.8,
     -1.2,
     0.8
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "st1 right blue",
   "color": {
    "region": [
     1.2,
     -0.8,
     2.8,
     0.8
    ]
   },
   "rgb": [
    0.05,
    0.05,
    0.9
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </M/tex.outputs:rgb>
        token outputs:surface
    }
    def Shader "tex"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @../textures/red_blue.png@
        float2 inputs:st.connect = </M/st.outputs:result>
        float3 outputs:rgb
        float outputs:r
        float outputs:a
    }
    def Shader "st"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st1"
        float2 outputs:result
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -2, 0), (4, -2, 0), (4, 2, 0), (-4, 2, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </M>
        texCoord2f[] primvars:st = [(0.25, 0.5)] (
            interpolation = "constant"
        )
        texCoord2f[] primvars:st1 = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
}
