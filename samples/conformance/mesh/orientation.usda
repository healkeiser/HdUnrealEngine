#usda 1.0
(
    doc = """orientation = leftHanded flips which side is the front: a clockwise-wound quad (as seen from the camera) with
leftHanded orientation faces the camera, so its normal points at the camera and it is lit like a counter-clockwise
rightHanded reference."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMesh",
 "feature": "orientation leftHanded",
 "frames": 1,
 "checks": [
  {
   "name": "leftHanded clockwise quad visible",
   "value": {
    "region": [
     1,
     -1,
     3,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "lit like the rightHanded reference",
   "ratio": [
    {
     "region": [
      1,
      -1,
      3,
      1
     ]
    },
    {
     "region": [
      -3,
      -1,
      -1,
      1
     ]
    }
   ],
   "min": 0.6,
   "max": 1.6
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Mesh "RightHanded"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3.5, -1.5, 0), (-0.5, -1.5, 0), (-0.5, 1.5, 0), (-3.5, 1.5, 0)]
        uniform token subdivisionScheme = "none"
}
def Mesh "LeftHanded"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 3, 2, 1]
        point3f[] points = [(0.5, -1.5, 0), (3.5, -1.5, 0), (3.5, 1.5, 0), (0.5, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        uniform token orientation = "leftHanded"
}
