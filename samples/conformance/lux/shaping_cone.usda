#usda 1.0
(
    doc = """shaping:cone:angle limits emission to a cone around the light's -Z axis. A 15 degree cone from z = 4 lights
a disc of radius about 1.6 on the wall; the wall at x = 3.5 stays dark."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdLux",
 "feature": "ShapingAPI cone angle",
 "frames": 1,
 "checks": [
  {
   "name": "cone centre lit",
   "value": {
    "region": [
     -0.5,
     -0.5,
     0.5,
     0.5
    ],
    "stat": "luma"
   },
   "min": 0.02
  },
  {
   "name": "outside the cone dark",
   "ratio": [
    {
     "region": [
      3.0,
      -0.5,
      4.0,
      0.5
     ]
    },
    {
     "region": [
      -0.5,
      -0.5,
      0.5,
      0.5
     ]
    }
   ],
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def Mesh "Wall"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -5, -2), (5, -5, -2), (5, 5, -2), (-5, 5, -2)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}
def SphereLight "L" (
    prepend apiSchemas = ["ShapingAPI"]
)
{
        float inputs:radius = 0.1
        float inputs:intensity = 1
        float inputs:exposure = 11
        float inputs:shaping:cone:angle = 15
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
