#usda 1.0
(
    doc = """A light illuminates only the members of its lightLink collection (includeRoot = 0, includes /Left): the left
sphere is lit, the right one receives no light."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdLux",
 "feature": "light linking (collection:lightLink)",
 "frames": 1,
 "checks": [
  {
   "name": "linked sphere lit",
   "value": {
    "region": [
     -3.0,
     -0.5,
     -2.0,
     0.5
    ],
    "stat": "luma"
   },
   "min": 0.02
  },
  {
   "name": "unlinked sphere dark",
   "ratio": [
    {
     "region": [
      2.0,
      -0.5,
      3.0,
      0.5
     ]
    },
    {
     "region": [
      -3.0,
      -0.5,
      -2.0,
      0.5
     ]
    }
   ],
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        prepend apiSchemas = ["CollectionAPI:lightLink"]
    )
    {
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = [</Left>]
    }
}
def Sphere "Left"
{
        double radius = 1.2
        double3 xformOp:translate = (-2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Sphere "Right"
{
        double radius = 1.2
        double3 xformOp:translate = (2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
