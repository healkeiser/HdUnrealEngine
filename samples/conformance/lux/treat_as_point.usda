#usda 1.0
(
    doc = """treatAsPoint is a hint that a sphere light may be treated as a point (a zero-radius sphere). A sphere light of
radius 1.5 at z = 4 shadows a cube at z = 1 onto a wall at z = -2: as an area light its penumbra lights the wall just
outside the cube's silhouette (frame 1); with treatAsPoint (frame 2) that spot is in a hard umbra. Each frame's
shadow spot is compared with an unshadowed spot of the same frame."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdLux SphereLight",
 "feature": "treatAsPoint",
 "frames": 2,
 "checks": [
  {
   "name": "area light: penumbra reaches the spot",
   "ratio": [
    {
     "region": [
      0.75,
      -0.1,
      0.9,
      0.1
     ],
     "stat": "luma",
     "frame": 1
    },
    {
     "region": [
      3.2,
      -0.1,
      3.4,
      0.1
     ],
     "stat": "luma",
     "frame": 1
    }
   ],
   "min": 0.15
  },
  {
   "name": "treatAsPoint: hard umbra",
   "ratio": [
    {
     "region": [
      0.75,
      -0.1,
      0.9,
      0.1
     ],
     "stat": "luma",
     "frame": 2
    },
    {
     "region": [
      3.2,
      -0.1,
      3.4,
      0.1
     ],
     "stat": "luma",
     "frame": 2
    }
   ],
   "max": 0.1
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def Mesh "Wall"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-5, -5, -2), (5, -5, -2), (5, 5, -2), (-5, 5, -2)]
    uniform token subdivisionScheme = "none"
    uniform bool doubleSided = 1
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}
def Cube "Occluder"
{
    double size = 1
    double3 xformOp:translate = (0, 0, 1)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def SphereLight "L"
{
    float inputs:radius = 1.5
    bool inputs:normalize = 1
    float inputs:exposure = 7
    bool treatAsPoint.timeSamples = {1: 0, 2: 1}
    double3 xformOp:translate = (0, 0, 4)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
