#usda 1.0
(
    doc = """Without normalize, intensity is the surface luminance: doubling a sphere light's radius quadruples its
area and the wall illuminance. Radius 0.25 in frame 1, 0.5 in frame 2."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdLux",
 "feature": "light size without normalize",
 "frames": 2,
 "checks": [
  {
   "name": "4x the power",
   "ratio": [
    {
     "region": [
      -2,
      -2,
      2,
      2
     ],
     "frame": 2
    },
    {
     "region": [
      -2,
      -2,
      2,
      2
     ],
     "frame": 1
    }
   ],
   "min": 3.2,
   "max": 4.8
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def Mesh "Wall"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -5, -2), (5, -5, -2), (5, 5, -2), (-5, 5, -2)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}
def SphereLight "L"
{
        float inputs:intensity = 1
        float inputs:exposure = 8
        float inputs:radius.timeSamples = {1: 0.25, 2: 0.5}
        double3 xformOp:translate = (0, 0, 2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
