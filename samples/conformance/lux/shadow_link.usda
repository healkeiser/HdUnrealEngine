#usda 1.0
(
    doc = """Only members of a light's shadowLink collection cast its shadows. The occluder between the light (z = 6) and
the wall is excluded, so the wall behind it stays lit."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdLux",
 "feature": "shadow linking (collection:shadowLink)",
 "frames": 1,
 "checks": [
  {
   "name": "no shadow behind the occluder",
   "ratio": [
    {
     "region": [
      -2.6,
      -0.3,
      -2.0,
      0.3
     ]
    },
    {
     "region": [
      -2.6,
      2.7,
      -2.0,
      3.3
     ]
    }
   ],
   "min": 0.6
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def Mesh "Wall"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-5, -5, -2), (5, -5, -2), (5, 5, -2), (-5, 5, -2)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}
def Sphere "Occluder"
{
        double radius = 0.8
        double3 xformOp:translate = (0, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def SphereLight "L" (
    prepend apiSchemas = ["CollectionAPI:shadowLink"]
)
{
        float inputs:radius = 0.05
        float inputs:intensity = 1
        float inputs:exposure = 12
        uniform bool collection:shadowLink:includeRoot = 1
        rel collection:shadowLink:excludes = [</Occluder>]
        double3 xformOp:translate = (3, 0, 6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
