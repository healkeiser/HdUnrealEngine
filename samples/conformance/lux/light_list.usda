#usda 1.0
(
    doc = """LightListAPI caches the lights beneath a prim (lightList) for discovery; a renderer may use or ignore the cache
but must render the scene's lights either way. The cache here lists both sphere lights, each lighting one half of the
wall, with lightList:cacheBehavior = consumeAndHalt."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdLux LightListAPI",
 "feature": "lightList, lightList:cacheBehavior (a discovery cache)",
 "frames": 1,
 "checks": [
  {
   "name": "left light renders",
   "value": {
    "region": [
     -4,
     -1,
     -2,
     1
    ],
    "stat": "luma"
   },
   "min": 0.01
  },
  {
   "name": "right light renders",
   "value": {
    "region": [
     2,
     -1,
     4,
     1
    ],
    "stat": "luma"
   },
   "min": 0.01
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def Mesh "Wall"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-5, -5, -2), (5, -5, -2), (5, 5, -2), (-5, 5, -2)]
    uniform token subdivisionScheme = "none"
    uniform bool doubleSided = 1
    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
}
def Xform "World" (
    prepend apiSchemas = ["LightListAPI"]
)
{
    rel lightList = [</World/Left>, </World/Right>]
    token lightList:cacheBehavior = "consumeAndHalt"
    def SphereLight "Left"
    {
        float inputs:radius = 0.25
        float inputs:exposure = 6
        double3 xformOp:translate = (-3, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def SphereLight "Right"
    {
        float inputs:radius = 0.25
        float inputs:exposure = 6
        double3 xformOp:translate = (3, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
