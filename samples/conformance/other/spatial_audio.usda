#usda 1.0
(
    doc = """usdMedia SpatialAudio describes a sound source; renderers ignore it. The scene must render as without it."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdMediaSpatialAudio",
 "feature": "SpatialAudio (ignored)",
 "frames": 1,
 "checks": [
  {
   "name": "the rest of the scene renders",
   "value": {
    "region": [
     -3.9,
     2.6,
     -3.1,
     3.4
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Cube "Reference"
{
    double size = 1.5
    double3 xformOp:translate = (-3.5, 3, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def SpatialAudio "Sound"
{
    uniform token auralMode = "spatial"
    double gain = 1
}
