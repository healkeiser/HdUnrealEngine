#usda 1.0
(
    doc = """usdProc GenerativeProcedural is resolved by a procedural system (proceduralSystem); one nobody implements yields
nothing. The procedural draws nothing and the rest of the scene renders."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdProcGenerativeProcedural",
 "feature": "GenerativeProcedural with an unknown procedural (ignored)",
 "frames": 1,
 "checks": [
  {
   "name": "the rest of the scene renders",
   "value": {
    "region": [
     -3.9,
     2.6,
     -3.1,
     3.4
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "the procedural draws nothing",
   "value": {
    "region": [
     -1,
     -1,
     1,
     1
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Cube "Reference"
{
    double size = 1.5
    double3 xformOp:translate = (-3.5, 3, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def GenerativeProcedural "Proc"
{
    token proceduralSystem = "hydraGenerativeProcedural"
    token primvars:hdGp:proceduralType = "NoSuchProcedural"
}
