#usda 1.0
(
    doc = """Colours are authored in the OCIO config's scene_linear role and UE renders in linear Rec.709: hdUE converts
a constant displayColor (frame 1) and varying vertex displayColors of the same value (frame 2; one corner differs by
1e-4 so the colours vary) alike, so both frames render one colour. It renders with OCIO's ACES config ("env": its
scene_linear is ACEScg), where (0.6, 0.2, 0.1) converts to about (0.89, 0.15, 0.075): left unconverted, the varying
colours would read 0.67, 1.34 and 1.33 of the constant's per channel. Under Houdini's default config (scene_linear is
linear Rec.709) nothing would convert and the checks would pass whatever hdUE did."""
    customLayerData = {
        string conformance = """{
 "schema": "OCIO scene_linear",
 "feature": "varying vertex colours convert as constant colours do",
 "frames": 2,
 "env": {
  "OCIO": "ocio://cg-config-v2.2.0_aces-v1.3_ocio-v2.4"
 },
 "checks": [
  {
   "name": "varying vertex colours red = constant displayColor's",
   "ratio": [
    {
     "frame": 2,
     "region": [
      -3.0,
      -2.0,
      3.0,
      2.0
     ],
     "channel": 0
    },
    {
     "frame": 1,
     "region": [
      -3.0,
      -2.0,
      3.0,
      2.0
     ],
     "channel": 0
    }
   ],
   "min": 0.95,
   "max": 1.05
  },
  {
   "name": "varying vertex colours green = constant displayColor's",
   "ratio": [
    {
     "frame": 2,
     "region": [
      -3.0,
      -2.0,
      3.0,
      2.0
     ],
     "channel": 1
    },
    {
     "frame": 1,
     "region": [
      -3.0,
      -2.0,
      3.0,
      2.0
     ],
     "channel": 1
    }
   ],
   "min": 0.95,
   "max": 1.05
  },
  {
   "name": "varying vertex colours blue = constant displayColor's",
   "ratio": [
    {
     "frame": 2,
     "region": [
      -3.0,
      -2.0,
      3.0,
      2.0
     ],
     "channel": 2
    },
    {
     "frame": 1,
     "region": [
      -3.0,
      -2.0,
      3.0,
      2.0
     ],
     "channel": 2
    }
   ],
   "min": 0.95,
   "max": 1.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Mesh "Quad"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-4, -3, 0), (4, -3, 0), (4, 3, 0), (-4, 3, 0)]
    uniform token subdivisionScheme = "none"
    color3f[] primvars:displayColor (
        interpolation = "vertex"
    )
    color3f[] primvars:displayColor.timeSamples = {
        1: [(0.6, 0.2, 0.1), (0.6, 0.2, 0.1), (0.6, 0.2, 0.1), (0.6, 0.2, 0.1)],
        2: [(0.6, 0.2, 0.1), (0.6, 0.2, 0.1), (0.6, 0.2, 0.1), (0.6001, 0.2, 0.1)],
    }
}
