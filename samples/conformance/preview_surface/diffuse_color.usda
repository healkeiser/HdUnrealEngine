#usda 1.0
(
    doc = """diffuseColor is the albedo in the metallic workflow (fallback 0.18 grey). A red diffuse sphere renders red."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "diffuseColor",
 "frames": 1,
 "checks": [
  {
   "name": "red albedo",
   "color": {
    "region": [
     -0.5,
     -0.5,
     0.5,
     0.5
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "lit",
   "value": {
    "region": [
     -0.5,
     -0.5,
     0.5,
     0.5
    ],
    "stat": "luma"
   },
   "min": 0.02
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
        token outputs:surface
    }
}
def Sphere "Ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.5
        rel material:binding = </M>
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
