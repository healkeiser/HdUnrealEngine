#usda 1.0
(
    doc = """displacement given to a mesh UE already holds. The delegate is not restarted between the frames: frame 1
uploads the 4 x 4 quad without displacement and hdUE frees its arrays; frame 2 gives its material displacement 1, which
must reach the already-uploaded quad (its arrays come back from Hydra). Displaced, the quad moves 1 unit closer and
projects 10/9 larger: its edge passes x = 2.1, where the undisplaced quad ends at 2."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "displacement animated on an uploaded mesh",
 "frames": 2,
 "checks": [
  {
   "name": "frame 1 is not displaced",
   "value": {
    "frame": 1,
    "region": [
     2.05,
     -1,
     2.18,
     1
    ],
    "stat": "coverage"
   },
   "max": 0.1
  },
  {
   "name": "frame 2 is displaced",
   "value": {
    "frame": 2,
    "region": [
     2.05,
     -1,
     2.18,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "frame 1 body renders",
   "value": {
    "frame": 1,
    "region": [
     -1,
     -1,
     1,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "frame 2 body renders",
   "value": {
    "frame": 2,
    "region": [
     -1,
     -1,
     1,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ],
 "husk": [
  "--restart-delegate",
  "0"
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            float inputs:displacement.timeSamples = {
                1: 0,
                2: 1,
            }
        token outputs:surface
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        uniform token subdivisionScheme = "catmullClark"
        rel material:binding = </M>
}
over "Render"
{
    over "Settings"
    {
        # hdUE leaves subdivision surfaces unrefined by default, as UE's USD Stage Actor does (SubdivisionLevel 0).
        int unreal:subdivisionLevel = 2
    }
}
