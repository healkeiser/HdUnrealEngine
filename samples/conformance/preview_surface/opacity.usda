#usda 1.0
(
    doc = """opacity < 1 makes the surface partially present (opacityMode transparent, the default). A quad with opacity
0.4 over the empty background: its alpha is partial."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "opacity (presence)",
 "frames": 1,
 "checks": [
  {
   "name": "partial alpha",
   "value": {
    "region": [
     -1.5,
     -1.5,
     1.5,
     1.5
    ],
    "stat": "alpha"
   },
   "min": 0.2,
   "max": 0.65
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            float inputs:opacity = 0.4
        token outputs:surface
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </M>
}
