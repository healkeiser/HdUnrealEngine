#usda 1.0
(
    doc = """ior sets the dielectric Fresnel reflectance, F0 = ((ior - 1) / (ior + 1))^2: 0.04 at 1.5, 0.25 at 3. Black
glossy spheres under a uniform white dome: the ior 3 sphere reflects several times more."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "ior",
 "frames": 1,
 "checks": [
  {
   "name": "ior 3 reflects more than ior 1.5",
   "ratio": [
    {
     "region": [
      1.7,
      -0.8,
      3.3,
      0.8
     ]
    },
    {
     "region": [
      -3.3,
      -0.8,
      -1.7,
      0.8
     ]
    }
   ],
   "min": 2.5
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def DomeLight "Env"
{
    float inputs:intensity = 1
    float inputs:exposure = 0
}
def Material "Low"
{
    token outputs:surface.connect = </Low/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            float inputs:roughness = 0.2
            float inputs:ior = 1.5
        token outputs:surface
    }
}
def Material "High"
{
    token outputs:surface.connect = </High/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            float inputs:roughness = 0.2
            float inputs:ior = 3
        token outputs:surface
    }
}
def Sphere "Low_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </Low>
        double3 xformOp:translate = (-2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Sphere "High_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </High>
        double3 xformOp:translate = (2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
