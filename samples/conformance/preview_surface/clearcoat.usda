#usda 1.0
(
    doc = """clearcoat adds a second, white specular layer (IOR 1.5) with its own roughness. Black fully rough spheres
under a white dome: the right one, with clearcoat 1 and clearcoatRoughness 0.05, reflects more."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "clearcoat, clearcoatRoughness",
 "frames": 1,
 "checks": [
  {
   "name": "clearcoat adds reflection",
   "ratio": [
    {
     "region": [
      1.7,
      -0.8,
      3.3,
      0.8
     ]
    },
    {
     "region": [
      -3.3,
      -0.8,
      -1.7,
      0.8
     ]
    }
   ],
   "min": 1.3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def DomeLight "Env"
{
    float inputs:intensity = 1
    float inputs:exposure = 0
}
def Material "Base"
{
    token outputs:surface.connect = </Base/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
            float inputs:roughness = 1
        token outputs:surface
    }
}
def Material "Coat"
{
    token outputs:surface.connect = </Coat/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
            float inputs:roughness = 1
            float inputs:clearcoat = 1
            float inputs:clearcoatRoughness = 0.05
        token outputs:surface
    }
}
def Sphere "Base_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </Base>
        double3 xformOp:translate = (-2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Sphere "Coat_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </Coat>
        double3 xformOp:translate = (2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
