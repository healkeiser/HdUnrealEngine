#usda 1.0
(
    doc = """roughness widens the specular lobe: under the distant key light, a black glossy sphere's highlight peak is far
brighter at roughness 0.1 than at 0.7."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "roughness",
 "frames": 1,
 "checks": [
  {
   "name": "smooth peak brighter",
   "ratio": [
    {
     "region": [
      -3.7,
      -1.2,
      -1.3,
      1.2
     ],
     "stat": "max"
    },
    {
     "region": [
      1.3,
      -1.2,
      3.7,
      1.2
     ],
     "stat": "max"
    }
   ],
   "min": 3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Smooth"
{
    token outputs:surface.connect = </Smooth/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            float inputs:roughness = 0.1
        token outputs:surface
    }
}
def Material "Rough"
{
    token outputs:surface.connect = </Rough/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 0)
            float inputs:roughness = 0.7
        token outputs:surface
    }
}
def Sphere "Smooth_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </Smooth>
        double3 xformOp:translate = (-2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Sphere "Rough_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </Rough>
        double3 xformOp:translate = (2.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
