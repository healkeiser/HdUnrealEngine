#usda 1.0
(
    doc = """normal takes a tangent-space normal, typically from a UsdUVTexture with scale 2 and bias -1 (raw). The map
tilts every normal 60 degrees towards -X (tangent = +u = +X), away from the key light: the right quad renders much
darker than the left one without a map."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdPreviewSurface",
 "feature": "normal (tangent-space map)",
 "frames": 1,
 "checks": [
  {
   "name": "normal map darkens",
   "ratio": [
    {
     "region": [
      1.5,
      -1,
      3.5,
      1
     ]
    },
    {
     "region": [
      -3.5,
      -1,
      -1.5,
      1
     ]
    }
   ],
   "max": 0.5
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Plain"
{
    token outputs:surface.connect = </Plain/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
        token outputs:surface
    }
}
def Material "Normal"
{
    token outputs:surface.connect = </Normal/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            normal3f inputs:normal.connect = </Normal/n.outputs:rgb>
        token outputs:surface
    }
    def Shader "n"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @../textures/normal_tilt60.png@
        float2 inputs:st.connect = </Normal/st.outputs:result>
        token inputs:sourceColorSpace = "raw"
        float4 inputs:scale = (2, 2, 2, 1)
        float4 inputs:bias = (-1, -1, -1, 0)
        float3 outputs:rgb
        float outputs:r
        float outputs:a
    }
    def Shader "st"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }
}
def Mesh "PlainQuad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -1.5, 0), (-1, -1.5, 0), (-1, 1.5, 0), (-4, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Plain>
}
def Mesh "NormalQuad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(1, -1.5, 0), (4, -1.5, 0), (4, 1.5, 0), (1, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Normal>
}
