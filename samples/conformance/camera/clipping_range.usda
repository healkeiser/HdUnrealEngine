#usda 1.0
(
    doc = """clippingRange (near, far) bounds what renders. With (2, 8): the cube 1.5 from the camera (x = -2 on screen)
and the cube 10 away (centre) are clipped; the cube 5 away (x = 2 on screen) renders. hdUE applies the near plane
only: UE's views keep an infinite far plane (a finite one changed Lumen's lighting by 8% with nothing clipped), so the
far cube still renders; docs/conformance.md lists it under the gaps."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomCamera",
 "feature": "clippingRange",
 "frames": 1,
 "checks": [
  {
   "name": "inside the range",
   "value": {
    "region": [
     1.7,
     -0.3,
     2.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "before near",
   "value": {
    "region": [
     -2.2,
     -0.2,
     -1.8,
     0.2
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Camera"
{
    float2 clippingRange = (2, 8)
}
def Cube "Inside"
{
        double size = 0.5
        double3 xformOp:translate = (1, 0, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "Far"
{
        double size = 1
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "Near"
{
        double size = 0.2
        double3 xformOp:translate = (-0.3, 0, 8.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
