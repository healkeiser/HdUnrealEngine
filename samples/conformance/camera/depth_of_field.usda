#usda 1.0
(
    doc = """fStop and focusDistance define depth of field (fStop 0 disables it). fStop 4, focus 10 (the z = 0 plane):
the sphere at z = 0 is sharp, the one at z = -10 is blurred, with many more partially covered pixels."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomCamera",
 "feature": "fStop, focusDistance",
 "frames": 1,
 "checks": [
  {
   "name": "defocused edge is softer",
   "ratio": [
    {
     "region": [
      0.7,
      -1.3,
      3.3,
      1.3
     ],
     "stat": "soft"
    },
    {
     "region": [
      -3.3,
      -1.3,
      -0.7,
      1.3
     ],
     "stat": "soft"
    }
   ],
   "min": 2.5
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Camera"
{
    float fStop = 4
    float focusDistance = 10
}
def Sphere "Sharp"
{
        double radius = 0.8
        double3 xformOp:translate = (-2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Sphere "Blurred"
{
        double radius = 1.6
        double3 xformOp:translate = (4, 0, -10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
