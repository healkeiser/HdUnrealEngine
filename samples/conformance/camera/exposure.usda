#usda 1.0
(
    doc = """Camera exposure scales the image by 2^exposure (frame 2: +1 doubles); exposure:fStop/iso/time/responsivity
scale it by time * iso / 100 / fStop^2 * responsivity (frame 3: exposure:fStop 2 quarters it)."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomCamera",
 "feature": "exposure, exposure:fStop/iso/time",
 "frames": 3,
 "checks": [
  {
   "name": "exposure +1 doubles",
   "ratio": [
    {
     "region": [
      -1,
      -1,
      1,
      1
     ],
     "frame": 2
    },
    {
     "region": [
      -1,
      -1,
      1,
      1
     ],
     "frame": 1
    }
   ],
   "min": 1.8,
   "max": 2.2
  },
  {
   "name": "exposure:fStop 2 quarters",
   "ratio": [
    {
     "region": [
      -1,
      -1,
      1,
      1
     ],
     "frame": 3
    },
    {
     "region": [
      -1,
      -1,
      1,
      1
     ],
     "frame": 1
    }
   ],
   "min": 0.2,
   "max": 0.3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 3
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Camera"
{
    float exposure.timeSamples = {1: 0, 2: 1, 3: 0}
    float exposure:fStop.timeSamples = {1: 1, 2: 1, 3: 2}
}
def Mesh "Quad"
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        uniform token subdivisionScheme = "none"
}
