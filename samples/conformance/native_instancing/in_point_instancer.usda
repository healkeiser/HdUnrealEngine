#usda 1.0
(
    doc = """A PointInstancer prototype may be an instanceable prim. Instances at x = -3, 0, 3 of a prototype that
references the cube instanceably."""
    customLayerData = {
        string conformance = """{
 "schema": "native instancing",
 "feature": "native instance as a PointInstancer prototype",
 "frames": 1,
 "checks": [
  {
   "name": "instance at x=-3",
   "value": {
    "region": [
     -3.3,
     -0.3,
     -2.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=0",
   "value": {
    "region": [
     -0.3,
     -0.3,
     0.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=3",
   "value": {
    "region": [
     2.7,
     -0.3,
     3.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
class Xform "Proto"
{
    def Cube "cube"
    {
        double size = 1.2
    }
}
def PointInstancer "Instancer"
{
    point3f[] positions = [(-3, 0, 0), (0, 0, 0), (3, 0, 0)]
    int[] protoIndices = [0, 0, 0]
    rel prototypes = [</Instancer/Prototypes/ref>]
    def Scope "Prototypes"
    {
    def Xform "ref" (
            instanceable = true
            prepend references = </Proto>
        )
    {
    }
    }
}
