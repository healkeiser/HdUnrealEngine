#usda 1.0
(
    doc = """An instance's prototype may itself contain instances. Pair holds two instanced cubes at x = -1, 1; two Pair
instances at y = -2, 2 give four cubes."""
    customLayerData = {
        string conformance = """{
 "schema": "native instancing",
 "feature": "nested instancing",
 "frames": 1,
 "checks": [
  {
   "name": "cube (-1, -2)",
   "value": {
    "region": [
     -1.3,
     -2.3,
     -0.7,
     -1.7
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "cube (-1, 2)",
   "value": {
    "region": [
     -1.3,
     1.7,
     -0.7,
     2.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "cube (1, -2)",
   "value": {
    "region": [
     0.7,
     -2.3,
     1.3,
     -1.7
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "cube (1, 2)",
   "value": {
    "region": [
     0.7,
     1.7,
     1.3,
     2.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
class Xform "Proto"
{
    def Cube "cube"
    {
        double size = 1.2
    }
}
class Xform "Pair"
{
    def Xform "left" (
        instanceable = true
        prepend references = </Proto>
    )
    {
        double3 xformOp:translate = (-1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "right" (
        instanceable = true
        prepend references = </Proto>
    )
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
def Xform "P0" (
        instanceable = true
        prepend references = </Pair>
    )
{
        double3 xformOp:translate = (0, -2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Xform "P1" (
        instanceable = true
        prepend references = </Pair>
    )
{
        double3 xformOp:translate = (0, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
