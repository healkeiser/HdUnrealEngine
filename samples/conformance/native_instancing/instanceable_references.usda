#usda 1.0
(
    doc = """Prims marked instanceable that share the same composition arcs share one prototype; each instance renders
the prototype under its own transform. Three instances of one cube."""
    customLayerData = {
        string conformance = """{
 "schema": "native instancing",
 "feature": "instanceable references",
 "frames": 1,
 "checks": [
  {
   "name": "instance at x=-3",
   "value": {
    "region": [
     -3.3,
     -0.3,
     -2.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=0",
   "value": {
    "region": [
     -0.3,
     -0.3,
     0.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=3",
   "value": {
    "region": [
     2.7,
     -0.3,
     3.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "3 instances in the id AOVs",
   "value": {
    "stat": "instances"
   },
   "equals": 3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
class Xform "Proto"
{
    def Cube "cube"
    {
        double size = 1.2
    }
}
def Xform "A" (
        instanceable = true
        prepend references = </Proto>
    )
{
        double3 xformOp:translate = (-3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Xform "B" (
        instanceable = true
        prepend references = </Proto>
    )
{
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Xform "C" (
        instanceable = true
        prepend references = </Proto>
    )
{
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
