#usda 1.0
(
    doc = """material:binding:collection:<name> binds a material to the members of a collection. The World prim's
collection "reds" includes only /World/A: A renders red, B keeps its displayColor grey."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdShadeMaterialBindingAPI",
 "feature": "collection-based binding",
 "frames": 1,
 "checks": [
  {
   "name": "A in the collection",
   "color": {
    "region": [
     -2.3,
     -0.3,
     -1.7,
     0.3
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "B not in it",
   "color": {
    "region": [
     1.7,
     -0.3,
     2.3,
     0.3
    ]
   },
   "rgb": [
    0.33,
    0.34,
    0.33
   ],
   "tol": 0.08
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Red"
{
    token outputs:surface.connect = </Red/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
        token outputs:surface
    }
}
def Xform "World" (
    prepend apiSchemas = ["MaterialBindingAPI", "CollectionAPI:reds"]
)
{
    rel collection:reds:includes = [</World/A>]
    rel material:binding:collection:reds = [</World.collection:reds>, </Red>]
    def Sphere "A"
    {
            double radius = 1
            double3 xformOp:translate = (-2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "B"
    {
            double radius = 1
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    
}
