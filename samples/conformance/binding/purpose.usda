#usda 1.0
(
    doc = """Bindings may be restricted to a purpose: material:binding:full, material:binding:preview, or allPurpose
(material:binding). Final renders resolve RenderSettings materialBindingPurposes, by default ["full", ""]: full
first, then allPurpose. Sphere bound full red, preview blue, allPurpose green: it renders red."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdShadeMaterialBindingAPI",
 "feature": "material purpose: full vs preview vs allPurpose",
 "frames": 1,
 "checks": [
  {
   "name": "full binding wins",
   "color": {
    "region": [
     -0.6,
     -0.6,
     0.6,
     0.6
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Red"
{
    token outputs:surface.connect = </Red/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
        token outputs:surface
    }
}
def Material "Green"
{
    token outputs:surface.connect = </Green/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.05, 0.9, 0.05)
        token outputs:surface
    }
}
def Material "Blue"
{
    token outputs:surface.connect = </Blue/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.05, 0.05, 0.9)
        token outputs:surface
    }
}
def Sphere "Ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding = </Green>
        rel material:binding:full = </Red>
        rel material:binding:preview = </Blue>
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
