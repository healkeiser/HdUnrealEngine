#usda 1.0
(
    doc = """A binding on an ancestor applies to descendant gprims that have none. The Xform is bound red; its unbound
child cube renders red."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdShadeMaterialBindingAPI",
 "feature": "binding inherited from an ancestor",
 "frames": 1,
 "checks": [
  {
   "name": "child inherits red",
   "color": {
    "region": [
     -0.5,
     -0.5,
     0.5,
     0.5
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Red"
{
    token outputs:surface.connect = </Red/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
        token outputs:surface
    }
}
def Xform "Parent" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Red>
    def Cube "child"
    {
            double size = 1.6
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    
}
