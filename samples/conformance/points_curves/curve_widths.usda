#usda 1.0
(
    doc = """widths with vertex interpolation vary along the curve: 0.1 at the left end, 1.6 at the right."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomBasisCurves",
 "feature": "varying widths",
 "frames": 1,
 "checks": [
  {
   "name": "thick end",
   "value": {
    "region": [
     2.9,
     -0.6,
     4.1,
     0.6
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "thin end",
   "value": {
    "region": [
     -3.65,
     0.25,
     -3.35,
     0.55
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def BasisCurves "Curve"
{
    uniform token type = "linear"
    int[] curveVertexCounts = [2]
    point3f[] points = [(-4, 0, 0), (4, 0, 0)]
    float[] widths = [0.1, 1.6] (
        interpolation = "vertex"
    )
}
