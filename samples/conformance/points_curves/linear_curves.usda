#usda 1.0
(
    doc = """type = linear joins the vertices with straight segments, as tubes or ribbons of diameter widths. A
horizontal curve at y = 2, width 0.4, and a V at the bottom."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomBasisCurves",
 "feature": "linear curves, widths",
 "frames": 1,
 "checks": [
  {
   "name": "horizontal curve",
   "value": {
    "region": [
     -3,
     1.95,
     3,
     2.05
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "not above",
   "value": {
    "region": [
     -3,
     2.4,
     3,
     2.6
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "V tip",
   "value": {
    "region": [
     -0.1,
     -3.1,
     0.1,
     -2.9
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def BasisCurves "Curves"
{
    uniform token type = "linear"
    int[] curveVertexCounts = [2, 3]
    point3f[] points = [(-4, 2, 0), (4, 2, 0), (-3, -1, 0), (0, -3, 0), (3, -1, 0)]
    float[] widths = [0.4] (
        interpolation = "constant"
    )
}
