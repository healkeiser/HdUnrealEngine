#usda 1.0
(
    doc = """An hdUE post-process texture setting given an image file instead of a cooked /Game/ path: the backend
imports the file at render time. VignetteType Texture multiplies the frame by the texture's red channel at
VignetteIntensity 1 (frame 2) and leaves it alone at 0 (frame 1). textures/black_left.png is black on its left half and
white on its right, so on frame 2 the evenly lit wall goes dark on the left and keeps frame 1's brightness on the
right."""
    customLayerData = {
        string conformance = """{
 "schema": "hdUE post-process",
 "feature": "texture setting from an image file",
 "frames": 2,
 "checks": [
  {
   "name": "left half masked",
   "ratio": [
    {
     "frame": 2,
     "region": [
      -4.5,
      -2,
      -1,
      2
     ]
    },
    {
     "frame": 1,
     "region": [
      -4.5,
      -2,
      -1,
      2
     ]
    }
   ],
   "max": 0.1
  },
  {
   "name": "right half unchanged",
   "ratio": [
    {
     "frame": 2,
     "region": [
      1,
      -2,
      4.5,
      2
     ]
    },
    {
     "frame": 1,
     "region": [
      1,
      -2,
      4.5,
      2
     ]
    }
   ],
   "min": 0.9,
   "max": 1.1
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        bool unreal:tonemapper = 1
        token unreal:postProcess:VignetteType = "EVignetteType::Texture"
        float unreal:postProcess:VignetteIntensity.timeSamples = {
            1: 0,
            2: 1,
        }
        asset unreal:postProcess:VignetteTexture = @../textures/black_left.png@
    }
}
def Cube "Wall"
{
        double size = 1.0
        double3 xformOp:scale = (12, 12, 0.1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
}
