#usda 1.0
(
    doc = """The settings' camera relationship selects the render camera. It targets a second camera shifted to x = 2.5:
the cube at the origin appears at x = -2.5."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdRenderSettings",
 "feature": "camera relationship",
 "frames": 1,
 "checks": [
  {
   "name": "seen from the second camera",
   "value": {
    "region": [
     -2.8,
     -0.3,
     -2.2,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "not from the default camera",
   "value": {
    "region": [
     -0.3,
     -0.3,
     0.3,
     0.3
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        rel camera = </Camera2>
    }
}
def Camera "Camera2"
{
    float focalLength = 40
    float horizontalAperture = 40
    float verticalAperture = 40
    float2 clippingRange = (0.1, 1000)
    double3 xformOp:translate = (2.5, 0, 10)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "Cube"
{
        double size = 1.0
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
