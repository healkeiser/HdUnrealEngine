#usda 1.0
(
    doc = """aspectRatioConformPolicy reconciles a square 40 x 40 aperture with a 128 x 64 image. adjustApertureWidth: the width changes to match; vertical framing is kept.
A sphere of radius 2 at the origin covers about 0.41 of the image height."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdRenderSettings",
 "feature": "aspectRatioConformPolicy adjustApertureWidth",
 "frames": 1,
 "checks": [
  {
   "name": "sphere height fraction",
   "value": {
    "stat": "bbox_height"
   },
   "min": 0.36,
   "max": 0.46
  },
  {
   "name": "sphere pixel aspect",
   "value": {
    "stat": "bbox_aspect"
   },
   "min": 0.9,
   "max": 1.1
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        uniform int2 resolution = (128, 64)
        uniform token aspectRatioConformPolicy = "adjustApertureWidth"
    }
}
def Sphere "Ball"
{
        double radius = 2
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
