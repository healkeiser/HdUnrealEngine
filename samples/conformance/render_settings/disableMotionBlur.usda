#usda 1.0
(
    doc = """disableMotionBlur = true renders without motion blur even though the camera shutter is open (-0.5..0.5) and the
cube moves 2 units per frame: no smear past its edge."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdRenderSettings",
 "feature": "disableMotionBlur",
 "frames": 1,
 "checks": [
  {
   "name": "no smear",
   "value": {
    "region": [
     0.7,
     -0.2,
     1.3,
     0.2
    ],
    "stat": "alpha"
   },
   "max": 0.02
  },
  {
   "name": "cube",
   "value": {
    "region": [
     -0.3,
     -0.3,
     0.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        uniform bool disableMotionBlur = 1
    }
}
over "Camera"
{
    double shutter:open = -0.5
    double shutter:close = 0.5
}
def Cube "Moving"
{
        double size = 1.0
        double3 xformOp:translate.timeSamples = {0: (-2, 0, 0), 1: (0, 0, 0), 2: (2, 0, 0)}
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
