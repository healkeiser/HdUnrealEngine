#usda 1.0
(
    doc = """materialBindingPurposes orders the binding purposes to resolve. With ["preview", ""], a sphere bound full
red and preview blue renders blue."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdRenderSettings",
 "feature": "materialBindingPurposes",
 "frames": 1,
 "checks": [
  {
   "name": "preview binding used",
   "color": {
    "region": [
     -0.6,
     -0.6,
     0.6,
     0.6
    ]
   },
   "rgb": [
    0.05,
    0.05,
    0.9
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        uniform token[] materialBindingPurposes = ["preview", ""]
    }
}
def Material "Red"
{
    token outputs:surface.connect = </Red/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
        token outputs:surface
    }
}
def Material "Blue"
{
    token outputs:surface.connect = </Blue/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.05, 0.05, 0.9)
        token outputs:surface
    }
}
def Sphere "Ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        double radius = 1.2
        rel material:binding:full = </Red>
        rel material:binding:preview = </Blue>
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
