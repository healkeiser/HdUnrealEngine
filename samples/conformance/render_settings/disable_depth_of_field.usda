#usda 1.0
(
    doc = """disableDepthOfField = true ignores the camera's fStop: the sphere far behind the focus plane stays as sharp
as the one in focus."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdRenderSettings",
 "feature": "disableDepthOfField",
 "frames": 1,
 "checks": [
  {
   "name": "no defocus",
   "ratio": [
    {
     "region": [
      0.7,
      -1.3,
      3.3,
      1.3
     ],
     "stat": "soft"
    },
    {
     "region": [
      -3.3,
      -1.3,
      -0.7,
      1.3
     ],
     "stat": "soft"
    }
   ],
   "max": 2
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        uniform bool disableDepthOfField = 1
    }
}
over "Camera"
{
    float fStop = 4
    float focusDistance = 10
}
def Sphere "Sharp"
{
        double radius = 0.8
        double3 xformOp:translate = (-2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Sphere "Blurred"
{
        double radius = 1.6
        double3 xformOp:translate = (4, 0, -10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
}
