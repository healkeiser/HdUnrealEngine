#usda 1.0
(
    doc = """At r.ScreenPercentage 50 UE renders at half the output size and upscales after its post-process inputs.
hdUE's HDRI background and depth AOV run before that upscale, so they must cover the render-resolution rectangle: the
dome's blue upper hemisphere fills the top of the frame and its red lower hemisphere the bottom, and the depth AOV
puts the near cube nearer than the far one, both nearer than the background, where they are. Realtime only: the Path
Tracer always renders at 100 %."""
    customLayerData = {
        string conformance = """{
 "schema": "UE screen percentage",
 "feature": "HDRI background and depth AOV at a reduced screen percentage",
 "frames": 1,
 "modes": [
  "realtime"
 ],
 "checks": [
  {
   "name": "top of the frame is the blue sky",
   "color": {
    "region": [
     -4.5,
     3.5,
     4.5,
     4.8
    ]
   },
   "rgb": [
    0.05,
    0.05,
    0.9
   ],
   "tol": 0.2
  },
  {
   "name": "bottom of the frame is the red ground",
   "color": {
    "region": [
     -4.5,
     -4.8,
     4.5,
     -3.5
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.2
  },
  {
   "name": "near < far",
   "ratio": [
    {
     "region": [
      -2.2,
      -0.2,
      -1.8,
      0.2
     ],
     "aov": "depth"
    },
    {
     "region": [
      1.8,
      -0.2,
      2.2,
      0.2
     ],
     "aov": "depth"
    }
   ],
   "max": 0.9999
  },
  {
   "name": "far < background",
   "ratio": [
    {
     "region": [
      1.8,
      -0.2,
      2.2,
      0.2
     ],
     "aov": "depth"
    },
    {
     "region": [
      -0.5,
      3.5,
      0.5,
      4.5
     ],
     "aov": "depth"
    }
   ],
   "max": 0.9999
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Lights"
{
    over "key" (
        active = false
    )
    {
    }
}
def DomeLight "L"
{
    float inputs:intensity = 1
    asset inputs:texture:file = @../textures/dome_top_blue_bottom_red.exr@
    token inputs:texture:format = "latlong"
}
over "Render"
{
    over "Settings"
    {
        rel products = [</Render/Beauty>, </Render/Depth>]
        float unreal:cvar:r:ScreenPercentage = 50
    }
    def RenderProduct "Depth"
    {
        token productName = "depth.$F4.exr"
        rel orderedVars = </Render/Vars/depth>
    }
    over "Vars"
    {
        def RenderVar "depth"
        {
            uniform token dataType = "float"
            uniform string sourceName = "depth"
            uniform token sourceType = "raw"
            string driver:parameters:aov:name = "depth"
        }
    }
}
def Cube "Near"
{
    double size = 0.5
    double3 xformOp:translate = (-1, 0, 5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "Far"
{
    double size = 1.0
    double3 xformOp:translate = (2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
