#usda 1.0
(
    doc = """scales[i] scales instance i about its prototype origin before rotation and translation. Unit cubes at x = -2
(scale 1) and x = 2 (scale 2): only the second reaches 0.85 from its centre."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "scales",
 "frames": 1,
 "checks": [
  {
   "name": "scaled cube corner",
   "value": {
    "region": [
     2.77,
     0.77,
     2.93,
     0.93
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "unscaled cube stays small",
   "value": {
    "region": [
     -1.23,
     0.77,
     -1.07,
     0.93
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "unscaled cube",
   "value": {
    "region": [
     -2.3,
     -0.3,
     -1.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer"
{
    point3f[] positions = [(-2, 0, 0), (2, 0, 0)]
    int[] protoIndices = [0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    float3[] scales = [(1, 1, 1), (2, 2, 2)]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
