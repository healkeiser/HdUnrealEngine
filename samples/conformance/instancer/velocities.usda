#usda 1.0
(
    doc = """velocities (units per second) move instances linearly within the shutter: the camera's shutter is open from
-0.5 to 0.5 frames, so an instance moving at 48 units/s (2 units per frame at 24 fps) smears 1 unit each side.
Top cube is still, bottom cube moves along +X."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "velocities motion blur",
 "frames": 1,
 "checks": [
  {
   "name": "moving instance smears past its edge",
   "value": {
    "region": [
     0.7,
     -2.2,
     1.3,
     -1.8
    ],
    "stat": "alpha"
   },
   "min": 0.1
  },
  {
   "name": "still instance stays sharp",
   "value": {
    "region": [
     0.7,
     1.8,
     1.3,
     2.2
    ],
    "stat": "alpha"
   },
   "max": 0.02
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer"
{
    point3f[] positions.timeSamples = {1: [(0, 2, 0), (0, -2, 0)]}
    int[] protoIndices = [0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    vector3f[] velocities = [(0, 0, 0), (48, 0, 0)]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
over "Camera"
{
    double shutter:open = -0.5
    double shutter:close = 0.5
}
