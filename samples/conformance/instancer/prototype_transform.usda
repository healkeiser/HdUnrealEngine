#usda 1.0
(
    doc = """The instance transform applies the prototype root's own local transform first, then scales, orientations,
positions and the instancer's transform. The prototype cube is translated by (0, 1.5, 0); instances at y = -1 must
appear at y = 0.5."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "prototype root transform",
 "frames": 1,
 "checks": [
  {
   "name": "x=-2 lifted by the prototype transform",
   "value": {
    "region": [
     -2.3,
     0.2,
     -1.7,
     0.8
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "x=-2 not at its raw position",
   "value": {
    "region": [
     -2.15,
     -1.35,
     -1.85,
     -1.05
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "x=2 lifted",
   "value": {
    "region": [
     1.7,
     0.2,
     2.3,
     0.8
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer"
{
    point3f[] positions = [(-2, -1, 0), (2, -1, 0)]
    int[] protoIndices = [0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.0
            double3 xformOp:translate = (0, 1.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
