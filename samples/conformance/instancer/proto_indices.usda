#usda 1.0
(
    doc = """protoIndices[i] picks prototypes[protoIndices[i]] for instance i, placed at positions[i]. Four instances at
x = -3, -1, 1, 3 with protoIndices [0, 1, 1, 0] over prototypes [cube 1.6, sphere r 0.8]: cubes at the ends, spheres
in the middle; four distinct (primId, instanceId) pairs."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "protoIndices, positions, prototypes",
 "frames": 1,
 "checks": [
  {
   "name": "instance at x=-3",
   "value": {
    "region": [
     -3.45,
     -0.45,
     -2.55,
     0.45
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=-1",
   "value": {
    "region": [
     -1.45,
     -0.45,
     -0.55,
     0.45
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=1",
   "value": {
    "region": [
     0.55,
     -0.45,
     1.45,
     0.45
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance at x=3",
   "value": {
    "region": [
     2.55,
     -0.45,
     3.45,
     0.45
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "cube corner at x=-3",
   "value": {
    "region": [
     -3.73,
     0.57,
     -3.57,
     0.73
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "cube corner at x=3",
   "value": {
    "region": [
     3.57,
     0.57,
     3.73,
     0.73
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "sphere corner at x=-1",
   "value": {
    "region": [
     -0.43,
     0.57,
     -0.27,
     0.73
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "sphere corner at x=1",
   "value": {
    "region": [
     1.57,
     0.57,
     1.73,
     0.73
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "4 instances in the id AOVs",
   "value": {
    "stat": "instances"
   },
   "equals": 4
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer"
{
    point3f[] positions = [(-3, 0, 0), (-1, 0, 0), (1, 0, 0), (3, 0, 0)]
    int[] protoIndices = [0, 1, 1, 0]
    rel prototypes = [</Instancer/Prototypes/cube>, </Instancer/Prototypes/ball>]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.6
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "ball"
    {
            double radius = 0.8
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
