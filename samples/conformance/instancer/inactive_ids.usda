#usda 1.0
(
    doc = """inactiveIds (int64 list-op prim metadata) masks instances over all time; without ids it holds indices into
protoIndices. inactiveIds = [2]: the third instance (x = 1) is not rendered."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "inactiveIds metadata",
 "frames": 1,
 "checks": [
  {
   "name": "index 0",
   "value": {
    "region": [
     -3.3,
     -0.3,
     -2.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "index 1",
   "value": {
    "region": [
     -1.3,
     -0.3,
     -0.7,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "index 2 inactive",
   "value": {
    "region": [
     0.7,
     -0.3,
     1.3,
     0.3
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "index 3",
   "value": {
    "region": [
     2.7,
     -0.3,
     3.3,
     0.3
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "3 instances in the id AOVs",
   "value": {
    "stat": "instances"
   },
   "equals": 3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer" (
    inactiveIds = [2]
)
{
    point3f[] positions = [(-3, 0, 0), (-1, 0, 0), (1, 0, 0), (3, 0, 0)]
    int[] protoIndices = [0, 0, 0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
