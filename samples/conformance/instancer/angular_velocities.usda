#usda 1.0
(
    doc = """angularVelocities (degrees per second, per instance) rotate instances within the shutter (open -0.5 to 0.5
frames); motion:nonlinearSampleCount (3 by default) sets how many samples an intermediate layer takes. The bottom
instance spins at 720 degrees/s about Z (30 degrees a frame, +-15 within the shutter), so its corners smear; the top
one is still. hdUE does not blur angularVelocities (README) and must say so."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "angularVelocities (unsupported, warned)",
 "frames": 1,
 "checks": [
  {
   "name": "warning names angularVelocities",
   "log": "hdUE warning:.*angularVelocities",
   "present": true
  },
  {
   "name": "both instances render",
   "value": {
    "region": [
     -0.4,
     -2.4,
     0.4,
     2.4
    ],
    "stat": "coverage"
   },
   "min": 0.3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Camera"
{
    double shutter:open = -0.5
    double shutter:close = 0.5
}
def PointInstancer "Instancer" (
    prepend apiSchemas = ["MotionAPI"]
)
{
    point3f[] positions = [(0, 2, 0), (0, -2, 0)]
    int[] protoIndices = [0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    vector3f[] angularVelocities = [(0, 0, 0), (0, 0, 720)]
    int motion:nonlinearSampleCount = 3
    def Scope "Prototypes"
    {
        def Cube "cube"
        {
            double size = 1.6
        }
    }
}
