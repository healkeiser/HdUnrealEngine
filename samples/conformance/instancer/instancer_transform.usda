#usda 1.0
(
    doc = """Least locally, the PointInstancer prim's own transform applies to every instance. The instancer is
translated by (0, 2, 0) and scaled by 0.5: instances at x = -4, 4 appear at (-2, 2) and (2, 2), half size."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "PointInstancer's own transform",
 "frames": 1,
 "checks": [
  {
   "name": "instance 0 moved",
   "value": {
    "region": [
     -2.15,
     1.85,
     -1.85,
     2.15
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "instance 1 moved",
   "value": {
    "region": [
     1.85,
     1.85,
     2.15,
     2.15
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "not at raw position",
   "value": {
    "region": [
     -4.3,
     -0.3,
     -3.7,
     0.3
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "half size",
   "value": {
    "region": [
     -2.05,
     2.4,
     -1.95,
     2.5
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer"
{
    point3f[] positions = [(-4, 0, 0), (4, 0, 0)]
    int[] protoIndices = [0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    double3 xformOp:translate = (0, 2, 0)
    double3 xformOp:scale = (0.5, 0.5, 0.5)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
