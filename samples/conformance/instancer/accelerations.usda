#usda 1.0
(
    doc = """accelerations (units per second squared) add 0.5 a t^2 to velocity extrapolation. Both bottom instances move at
24 units/s; the right one also accelerates at 4608 units/s^2 (4 units per frame^2), so over the -0.5..0.5 frame
shutter its smear is longer on the +X side."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPointInstancer",
 "feature": "accelerations motion blur",
 "frames": 1,
 "checks": [
  {
   "name": "accelerated smear exceeds plain smear",
   "ratio": [
    {
     "region": [
      3.6,
      -2.2,
      4.4,
      -1.8
     ],
     "stat": "alpha"
    },
    {
     "region": [
      -2.4,
      -2.2,
      -1.6,
      -1.8
     ],
     "stat": "alpha"
    }
   ],
   "min": 1.3
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def PointInstancer "Instancer"
{
    point3f[] positions.timeSamples = {1: [(-3, -2, 0), (3, -2, 0)]}
    int[] protoIndices = [0, 0]
    rel prototypes = [</Instancer/Prototypes/cube>]
    vector3f[] velocities = [(24, 0, 0), (24, 0, 0)]
    vector3f[] accelerations = [(0, 0, 0), (4608, 0, 0)]
    def Scope "Prototypes"
    {
    def Cube "cube"
    {
            double size = 1.0
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    }
}
over "Camera"
{
    double shutter:open = -0.5
    double shutter:close = 0.5
}
