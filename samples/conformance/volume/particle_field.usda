#usda 1.0
(
    doc = """ParticleField3DGaussianSplat: 3D Gaussian splats (positions, orientations, scales, opacities, spherical
harmonics radiance). Three opaque splats of scale 0.5 on y = 0, red, green and blue (DC terms). hdUE renders them as
Hydra's HdsiParticleFieldConversionSceneIndex approximation (spheres coloured by the DC term, not Gaussian splats) and
says so; the rest of the scene renders."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdVolParticleField3DGaussianSplat",
 "feature": "ParticleField3DGaussianSplat (as points, warned)",
 "frames": 1,
 "checks": [
  {
   "name": "warning names the particle field",
   "log": "hdUE warning:.*(?i:particle ?field|gaussian)",
   "present": true
  },
  {
   "name": "the left splat renders red",
   "color": {
    "region": [
     -2.1,
     -0.1,
     -1.9,
     0.1
    ]
   },
   "rgb": [
    1,
    0,
    0
   ],
   "tol": 0.25
  },
  {
   "name": "the rest of the scene renders",
   "value": {
    "region": [
     -3.9,
     2.6,
     -3.1,
     3.4
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Cube "Reference"
{
    double size = 1.5
    double3 xformOp:translate = (-3.5, 3, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def ParticleField3DGaussianSplat "Splats"
{
    point3f[] positions = [(-2, 0, 0), (0, 0, 0), (2, 0, 0)]
    quatf[] orientations = [(1, 0, 0, 0), (1, 0, 0, 0), (1, 0, 0, 0)]
    float3[] scales = [(0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, 0.5)]
    float[] opacities = [1, 1, 1]
    uniform int radiance:sphericalHarmonicsDegree = 0
    float3[] radiance:sphericalHarmonicsCoefficients = [(1, 0, 0), (0, 1, 0), (0, 0, 1)]
}
