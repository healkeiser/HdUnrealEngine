#usda 1.0
(
    doc = """A cooked Sparse Volume Texture placed through unreal:asset on an Xform: the Cornell sample's CC0 fog sphere
(samples/cornell/fog.vdb) imported by HdUEPrepare as /Game/HdUE/SVT_HdUEFog, rendered as UE's Heterogeneous Volume
with an instance of UE's SparseVolumeMaterial: partial alpha and light in the frame."""
    customLayerData = {
        string conformance = """{
 "schema": "hdUE native asset",
 "feature": "unreal:asset with a cooked Sparse Volume Texture",
 "frames": 1,
 "checks": [
  {
   "name": "volume has partial alpha",
   "value": {
    "stat": "alpha"
   },
   "min": 0.02
  },
  {
   "name": "volume scatters light",
   "value": {
    "stat": "luma"
   },
   "min": 0.002
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
# The bounds mesh a host's proxy would author (scripts/asset_proxy.py): the SVT keeps the VDB's transform (0.05 voxels,
# its metres read as UE centimetres), so it spans UE x [-2.825, -0.375], y [-1.125, 1.125], z [-1.225, 1.225] cm, here
# as USD's (y, z, -x) m. Scaled 300x (the VDB's metres as stage metres, then 3x as volume/openvdb) and centred.
def Mesh "Fog"
{
    string primvars:unreal:asset = "/Game/HdUE/SVT_HdUEFog.SVT_HdUEFog" (
        interpolation = "constant"
    )
    point3f[] points = [(-0.01125, -0.01225, 0.00375), (-0.01125, -0.01225, 0.02825), (-0.01125, 0.01225, 0.00375), (-0.01125, 0.01225, 0.02825), (0.01125, -0.01225, 0.00375), (0.01125, -0.01225, 0.02825), (0.01125, 0.01225, 0.00375), (0.01125, 0.01225, 0.02825)]
    int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
    int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
    uniform token subdivisionScheme = "none"
    float3[] extent = [(-0.01125, -0.01225, 0.00375), (0.01125, 0.01225, 0.02825)]
    double3 xformOp:translate = (0, 0, -4.8)
    double3 xformOp:scale = (300, 300, 300)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
