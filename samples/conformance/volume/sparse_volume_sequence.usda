#usda 1.0
(
    doc = """An animated Sparse Volume Texture: a two-file VDB sequence (vdb_sequence/SVT_HdUEPuff.*.vdb, a fog ball at VDB y -1 m
then +1 m) imported by HdUEPrepare as /Game/HdUE/SVT_HdUEPuff. primvars:unreal:volume:frame keys UE's Frame on the
asset prim (frame 0 at time 1, 1 at time 2), as Sequencer keys it, and its bounds mesh inherits it. The delegate is not
restarted between the frames, so the second frame changes the live volume's frame: the ball leaves the left of the
frame for the right."""
    customLayerData = {
        string conformance = """{
 "schema": "hdUE native asset",
 "feature": "primvars:unreal:volume:frame on an animated Sparse Volume Texture",
 "frames": 2,
 "checks": [
  {
   "name": "the ball leaves the left",
   "ratio": [
    {
     "frame": 2,
     "region": [
      -2.6,
      -0.6,
      -1.4,
      0.6
     ]
    },
    {
     "frame": 1,
     "region": [
      -2.6,
      -0.6,
      -1.4,
      0.6
     ]
    }
   ],
   "max": 0.3
  },
  {
   "name": "the ball reaches the right",
   "ratio": [
    {
     "frame": 1,
     "region": [
      1.4,
      -0.6,
      2.6,
      0.6
     ]
    },
    {
     "frame": 2,
     "region": [
      1.4,
      -0.6,
      2.6,
      0.6
     ]
    }
   ],
   "max": 0.3
  }
 ],
 "husk": [
  "--restart-delegate",
  "0"
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 2
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Xform "Puff"
{
    float primvars:unreal:volume:frame.timeSamples = {
        1: 0,
        2: 1,
    }
    # VDB metres read as UE centimetres, here 2 m per VDB metre: the ball sits at x = -2 m, then +2 m.
    double3 xformOp:scale = (200, 200, 200)
    uniform token[] xformOpOrder = ["xformOp:scale"]

    # The bounds mesh a host's proxy would author (scripts/asset_proxy.py): the sequence's union, UE x [-0.5, 0.5],
    # y [-1.5, 1.5], z [-0.5, 0.5] cm, as USD's (y, z, -x) m.
    def Mesh "__HdUEAssetProxy"
    {
        string primvars:unreal:asset = "/Game/HdUE/SVT_HdUEPuff.SVT_HdUEPuff" (
            interpolation = "constant"
        )
        point3f[] points = [(-0.015, -0.005, -0.005), (-0.015, -0.005, 0.005), (-0.015, 0.005, -0.005), (-0.015, 0.005, 0.005), (0.015, -0.005, -0.005), (0.015, -0.005, 0.005), (0.015, 0.005, -0.005), (0.015, 0.005, 0.005)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        uniform token subdivisionScheme = "none"
        float3[] extent = [(-0.015, -0.005, -0.005), (0.015, 0.005, 0.005)]
    }
}
