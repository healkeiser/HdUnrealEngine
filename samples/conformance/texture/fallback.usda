#usda 1.0
(
    doc = """fallback is the value used when the texture cannot be read. The file does not exist and fallback is green:
the quad renders green."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdUVTexture",
 "feature": "fallback when the file cannot be read",
 "frames": 1,
 "checks": [
  {
   "name": "fallback green",
   "color": {
    "region": [
     -1,
     -1,
     1,
     1
    ]
   },
   "rgb": [
    0.05,
    0.9,
    0.05
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </M/t.outputs:rgb>
            int inputs:useSpecularWorkflow = 1
            color3f inputs:specularColor = (0, 0, 0)
        token outputs:surface
    }
    def Shader "t"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @../textures/does_not_exist.png@
        float2 inputs:st.connect = </M/st.outputs:result>
        float4 inputs:fallback = (0, 1, 0, 1)
        float3 outputs:rgb
        float outputs:r
        float outputs:a
    }
    def Shader "st"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </M>
}
