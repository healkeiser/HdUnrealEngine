#usda 1.0
(
    doc = """A float output (outputs:r) can drive a float input. The red | blue texture's red channel drives metallic: the
left (red, metallic 1) half is a smooth metal and much darker under the key light than the right (metallic 0)."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdUVTexture",
 "feature": "single-channel output (outputs:r)",
 "frames": 1,
 "checks": [
  {
   "name": "metallic from outputs:r",
   "ratio": [
    {
     "region": [
      -3,
      -1,
      -1,
      1
     ]
    },
    {
     "region": [
      1,
      -1,
      3,
      1
     ]
    }
   ],
   "max": 0.4
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
            float inputs:roughness = 0.05
            float inputs:metallic.connect = </M/t.outputs:r>
        token outputs:surface
    }
    def Shader "t"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @../textures/red_blue.png@
        float2 inputs:st.connect = </M/st.outputs:result>
        token inputs:sourceColorSpace = "raw"
        float3 outputs:rgb
        float outputs:r
        float outputs:a
    }
    def Shader "st"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -2, 0), (4, -2, 0), (4, 2, 0), (-4, 2, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </M>
}
