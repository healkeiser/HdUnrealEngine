#usda 1.0
(
    doc = """A texture's alpha output drives opacity; with opacityThreshold 0.5 the transparent right half of the texture
is cut out."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdUVTexture",
 "feature": "outputs:a to opacity with opacityThreshold",
 "frames": 1,
 "checks": [
  {
   "name": "opaque half",
   "value": {
    "region": [
     -3,
     -1,
     -1,
     1
    ],
    "stat": "coverage"
   },
   "min": 0.9
  },
  {
   "name": "transparent half cut out",
   "value": {
    "region": [
     1,
     -1,
     3,
     1
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "M"
{
    token outputs:surface.connect = </M/S.outputs:surface>
    def Shader "S"
    {
        uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
            float inputs:opacity.connect = </M/t.outputs:a>
            float inputs:opacityThreshold = 0.5
        token outputs:surface
    }
    def Shader "t"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @../textures/alpha_left.png@
        float2 inputs:st.connect = </M/st.outputs:result>
        float3 outputs:rgb
        float outputs:r
        float outputs:a
    }
    def Shader "st"
    {
        uniform token info:id = "UsdPrimvarReader_float2"
        string inputs:varname = "st"
        float2 outputs:result
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -2, 0), (4, -2, 0), (4, 2, 0), (-4, 2, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </M>
}
