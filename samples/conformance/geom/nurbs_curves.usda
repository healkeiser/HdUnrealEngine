#usda 1.0
(
    doc = """NurbsCurves: one clamped cubic curve (order 4, knots [0, 0, 0, 0, 1, 1, 1, 1]) through control points
(-4, -2), (-1.33, 3), (1.33, 3), (4, -2): a Bezier arc that peaks at y = 1.75 at x = 0, well below its control hull
(y = 3). widths 0.3."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomNurbsCurves",
 "feature": "NurbsCurves (evaluated, not the control hull)",
 "frames": 1,
 "checks": [
  {
   "name": "curve passes through its peak",
   "value": {
    "region": [
     -0.4,
     1.55,
     0.4,
     1.95
    ],
    "stat": "coverage"
   },
   "min": 0.3
  },
  {
   "name": "curve stays below the control hull",
   "value": {
    "region": [
     -0.5,
     2.8,
     0.5,
     3.2
    ],
    "stat": "coverage"
   },
   "max": 0.05
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def NurbsCurves "Curve"
{
    int[] curveVertexCounts = [4]
    int[] order = [4]
    double[] knots = [0, 0, 0, 0, 1, 1, 1, 1]
    double2[] ranges = [(0, 1)]
    point3f[] points = [(-4, -2, 0), (-1.333, 3, 0), (1.333, 3, 0), (4, -2, 0)]
    float[] widths = [0.3] (
        interpolation = "constant"
    )
}
