#usda 1.0
(
    doc = """TetMesh: a tetrahedral mesh whose surfaceFaceVertexIndices list its boundary triangles; renderers draw that
surface. One tetrahedron with a front face in the z = 1 plane, (-2.5, -2), (2.5, -2), (0, 2.5), and its apex behind."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomTetMesh",
 "feature": "TetMesh surface",
 "frames": 1,
 "checks": [
  {
   "name": "its surface renders",
   "value": {
    "region": [
     -0.4,
     -1,
     0.4,
     -0.2
    ],
    "stat": "coverage"
   },
   "min": 0.9
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def TetMesh "Tet"
{
    point3f[] points = [(-2.5, -2, 1), (2.5, -2, 1), (0, 2.5, 1), (0, 0, -2)]
    int4[] tetVertexIndices = [(0, 1, 2, 3)]
    int3[] surfaceFaceVertexIndices = [(0, 1, 2), (0, 3, 1), (1, 3, 2), (2, 3, 0)]
    uniform bool doubleSided = 1
}
