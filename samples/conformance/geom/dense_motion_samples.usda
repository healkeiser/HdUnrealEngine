        1.65: [(0.8, -2.5, 0), (1.8, -2.5, 0), (1.8, -1.5, 0), (0.8, -1.5, 0)],
        1.7: [(0.9, -2.5, 0), (1.9, -2.5, 0), (1.9, -1.5, 0), (0.9, -1.5, 0)],
        1.75: [(1, -2.5, 0), (2, -2.5, 0), (2, -1.5, 0), (1, -1.5, 0)],
        1.8: [(1.1, -2.5, 0), (2.1, -2.5, 0), (2.1, -1.5, 0), (1.1, -1.5, 0)],
        1.85: [(1.2, -2.5, 0), (2.2, -2.5, 0), (2.2, -1.5, 0), (1.2, -1.5, 0)],
        1.9: [(1.3, -2.5, 0), (2.3, -2.5, 0), (2.3, -1.5, 0), (1.3, -1.5, 0)],
        1.95: [(1.4, -2.5, 0), (2.4, -2.5, 0), (2.4, -1.5, 0), (1.4, -1.5, 0)],
        2: [(1.5, -2.5, 0), (2.5, -2.5, 0), (2.5, -1.5, 0), (1.5, -1.5, 0)],
    }
    uniform token subdivisionScheme = "none"
}
