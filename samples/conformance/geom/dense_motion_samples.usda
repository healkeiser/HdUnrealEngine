#usda 1.0
(
    doc = """Points and instance positions cached every 0.05 frame have 41 samples inside hdUE's one-frame-either-side
motion window, more than the 16 it keeps. Before this was fixed, the samples past the 16th were read past the end of a
16-entry array. The bottom quad's points and the top cube instance move 2 units per frame along +X with the shutter
open from -0.5 to 0.5 frames: both smear 1 unit each side, and the quad's centre stays covered."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomPrimvarsAPI",
 "feature": "more than 16 motion samples in the shutter window",
 "frames": 1,
 "checks": [
  {
   "name": "dense deforming mesh smears past its edge",
   "value": {
    "region": [
     0.7,
     -2.2,
     1.3,
     -1.8
    ],
    "stat": "alpha"
   },
   "min": 0.1
  },
  {
   "name": "dense instancer smears past its edge",
   "value": {
    "region": [
     0.7,
     1.8,
     1.3,
     2.2
    ],
    "stat": "alpha"
   },
   "min": 0.1
  },
  {
   "name": "the mesh centre stays covered",
   "note": "0.5 is the ceiling: the 1-unit quad sweeps 2 units over the shutter, so it covers each centre point for half of it",
   "value": {
    "region": [
     -0.2,
     -2.2,
     0.2,
     -1.8
    ],
    "stat": "alpha"
   },
   "min": 0.4
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Camera"
{
    double shutter:open = -0.5
    double shutter:close = 0.5
}
def Mesh "Deforming"
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points.timeSamples = {
        0: [(-2.5, -2.5, 0), (-1.5, -2.5, 0), (-1.5, -1.5, 0), (-2.5, -1.5, 0)],
        0.05: [(-2.4, -2.5, 0), (-1.4, -2.5, 0), (-1.4, -1.5, 0), (-2.4, -1.5, 0)],
        0.1: [(-2.3, -2.5, 0), (-1.3, -2.5, 0), (-1.3, -1.5, 0), (-2.3, -1.5, 0)],
