#usda 1.0
(
    doc = """MotionAPI motion:blurScale (inherited) scales the rendered motion blur per object: 0 removes it, 2 doubles it.
Two cubes move 2 units per frame along +X with the shutter open from -0.5 to 0.5 frames: the bottom one (blurScale 1)
smears 1 unit each side; the top one has blurScale 0 and must stay sharp."""
    customLayerData = {
        string conformance = """{
 "schema": "UsdGeomMotionAPI",
 "feature": "motion:blurScale",
 "frames": 1,
 "checks": [
  {
   "name": "blurScale 0 keeps the top cube sharp",
   "value": {
    "region": [
     0.7,
     1.8,
     1.3,
     2.2
    ],
    "stat": "alpha"
   },
   "max": 0.02
  },
  {
   "name": "the default cube is blurred",
   "value": {
    "region": [
     0.7,
     -2.2,
     1.3,
     -1.8
    ],
    "stat": "alpha"
   },
   "min": 0.1
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Camera"
{
    double shutter:open = -0.5
    double shutter:close = 0.5
}
def Cube "Sharp" (
    prepend apiSchemas = ["MotionAPI"]
)
{
    double size = 1
    float motion:blurScale = 0
    double3 xformOp:translate.timeSamples = {0: (-2, 2, 0), 1: (0, 2, 0), 2: (2, 2, 0)}
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Cube "Blurred" (
    prepend apiSchemas = ["MotionAPI"]
)
{
    double size = 1
    double3 xformOp:translate.timeSamples = {0: (-2, -2, 0), 1: (0, -2, 0), 2: (2, -2, 0)}
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
