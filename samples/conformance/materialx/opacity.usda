#usda 1.0
(
    doc = """MaterialX opacity as Unreal's Interchange imports it (UE 5.8, Substrate): an authored or connected opacity makes
the material masked, cut at UMaterial's default OpacityMaskClipValue 0.3333; a standard_surface with transmission is
translucent instead. The MaterialX spec (and Karma) treat opacity as fractional coverage with no threshold: this scene
encodes the UE import, not the spec. Left: opacity 0.25 (cut out); middle: 0.4 (fully opaque); right: opacity 0.25
with transmission 0.5 (translucent, partly see-through)."""
    customLayerData = {
        string conformance = """{
 "schema": "MaterialX standard_surface (as UE Interchange imports it)",
 "feature": "opacity (masked at OpacityMaskClipValue 1/3)",
 "frames": 1,
 "checks": [
  {
   "name": "opacity 0.25 cut at UE's 1/3 clip",
   "value": {
    "region": [
     -4.5,
     -1,
     -3,
     1
    ],
    "stat": "coverage"
   },
   "max": 0.05
  },
  {
   "name": "opacity 0.4 kept fully opaque",
   "value": {
    "region": [
     -1.5,
     -1,
     0,
     1
    ],
    "stat": "alpha"
   },
   "min": 0.95
  },
  {
   "name": "transmission makes it translucent, not cut",
   "value": {
    "region": [
     1.5,
     -1,
     3,
     1
    ],
    "stat": "alpha"
   },
   "min": 0.05,
   "max": 0.95
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Cut"
{
    token outputs:mtlx:surface.connect = </Cut/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:opacity = (0.25, 0.25, 0.25)
        token outputs:out
    }
}
def Material "Keep"
{
    token outputs:mtlx:surface.connect = </Keep/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:opacity = (0.4, 0.4, 0.4)
        token outputs:out
    }
}
def Material "Transmissive"
{
    token outputs:mtlx:surface.connect = </Transmissive/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:opacity = (0.25, 0.25, 0.25)
            float inputs:transmission = 0.5
        token outputs:out
    }
}
def Mesh "CutQuad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4.75, -1.5, 0), (-2.75, -1.5, 0), (-2.75, 1.5, 0), (-4.75, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Cut>
}
def Mesh "KeepQuad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1.75, -1.5, 0), (0.25, -1.5, 0), (0.25, 1.5, 0), (-1.75, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Keep>
}
def Mesh "TransmissiveQuad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(1.25, -1.5, 0), (3.25, -1.5, 0), (3.25, 1.5, 0), (1.25, 1.5, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </Transmissive>
}
