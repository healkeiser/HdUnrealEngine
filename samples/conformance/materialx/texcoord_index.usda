#usda 1.0
(
    doc = """MaterialX texcoord reads the UV set of its index. UE names UV set i st, st1, st2, ... when it writes USD
(UsdUtils::GetUVSetName) and its USD import fills UV sets from the texCoord2f primvars in name order, so index 1 reads
st1. Both quads carry st and st1, with st1 mirrored in u. The red | blue texture through texcoord index 1 shows
blue | red (top); through index 0 it shows red | blue (bottom)."""
    customLayerData = {
        string conformance = """{
 "schema": "MaterialX",
 "feature": "texcoord index",
 "frames": 1,
 "checks": [
  {
   "name": "no MaterialX node left untranslated",
   "log": "not translated",
   "present": false
  },
  {
   "name": "index 1 left blue",
   "color": {
    "region": [
     -3.6,
     1.4,
     -1.4,
     3.6
    ]
   },
   "rgb": [
    0.05,
    0.05,
    0.9
   ],
   "tol": 0.25
  },
  {
   "name": "index 1 right red",
   "color": {
    "region": [
     1.4,
     1.4,
     3.6,
     3.6
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "index 0 left red",
   "color": {
    "region": [
     -3.6,
     -3.6,
     -1.4,
     -1.4
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "index 0 right blue",
   "color": {
    "region": [
     1.4,
     -3.6,
     3.6,
     -1.4
    ]
   },
   "rgb": [
    0.05,
    0.05,
    0.9
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Index1"
{
    token outputs:mtlx:surface.connect = </Index1/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
        color3f inputs:base_color.connect = </Index1/image.outputs:out>
        token outputs:out
    }
    def Shader "image"
    {
        uniform token info:id = "ND_image_color3"
        asset inputs:file = @../textures/red_blue.png@
        float2 inputs:texcoord.connect = </Index1/uv.outputs:out>
        color3f outputs:out
    }
    def Shader "uv"
    {
        uniform token info:id = "ND_texcoord_vector2"
        int inputs:index = 1
        float2 outputs:out
    }
}
def Material "Index0"
{
    token outputs:mtlx:surface.connect = </Index0/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
        color3f inputs:base_color.connect = </Index0/image.outputs:out>
        token outputs:out
    }
    def Shader "image"
    {
        uniform token info:id = "ND_image_color3"
        asset inputs:file = @../textures/red_blue.png@
        float2 inputs:texcoord.connect = </Index0/uv.outputs:out>
        color3f outputs:out
    }
    def Shader "uv"
    {
        uniform token info:id = "ND_texcoord_vector2"
        int inputs:index = 0
        float2 outputs:out
    }
}
def Mesh "Index1Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, 1, 0), (4, 1, 0), (4, 4, 0), (-4, 4, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st1 = [(1, 0), (0, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Index1>
}
def Mesh "Index0Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -4, 0), (4, -4, 0), (4, -1, 0), (-4, -1, 0)]
        uniform token subdivisionScheme = "none"
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st1 = [(1, 0), (0, 0), (0, 1), (1, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Index0>
}
