#usda 1.0
(
    doc = """A masked MaterialX cutout keeps its alpha coverage with distance, as UE's "scale mips for alpha coverage"
(UTexture bDoScaleMipsForAlphaCoverage) keeps it: four cards with the same thin-branch texture (1-texel branches,
binary alpha read as opacity through extract/convert, the way samples/sponza/materials.usda reads its leaves), each
at 1, 3, 9 and 27 times the distance, scaled to the same size on screen and its texture repeated as many times. Averaged mips drop thin branches below
the 0.3333 clip (Lumen: 9x keeps 5% of the near card's coverage, 27x none); coverage-scaled mips keep 42% and 11%. The
near card's thin branches cover more pixels than texels (magnified, filtered), and the 4x4 and smaller mips cannot hold
8% coverage, so the distant cards stay below it. The Path Tracer samples the top mip at every distance."""
    customLayerData = {
        string conformance = """{
 "schema": "MaterialX standard_surface (as UE Interchange imports it)",
 "feature": "opacity cutout keeps coverage with distance (alpha-coverage mips)",
 "frames": 1,
 "checks": [
  {
   "name": "near card covered",
   "value": {"region": [-4.5, 0.5, -0.5, 4.5], "stat": "alpha"},
   "min": 0.04
  },
  {
   "name": "9x distance keeps the near card's coverage",
   "ratio": [
    {"region": [-4.5, -4.5, -0.5, -0.5], "stat": "alpha"},
    {"region": [-4.5, 0.5, -0.5, 4.5], "stat": "alpha"}
   ],
   "min": 0.3
  },
  {
   "name": "27x distance keeps the near card's coverage",
   "ratio": [
    {"region": [0.5, -4.5, 4.5, -0.5], "stat": "alpha"},
    {"region": [-4.5, 0.5, -0.5, 4.5], "stat": "alpha"}
   ],
   "min": 0.06
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
over "Render"
{
    over "Settings"
    {
        uniform int2 resolution = (256, 256)
    }
}
def Material "Branches"
{
    token outputs:mtlx:surface.connect = </Branches/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
        color3f inputs:base_color.connect = </Branches/color.outputs:out>
        color3f inputs:opacity.connect = </Branches/coverage.outputs:out>
        token outputs:out
    }
    def Shader "uv"
    {
        uniform token info:id = "ND_geompropvalue_vector2"
        string inputs:geomprop = "st"
        float2 outputs:out
    }
    def Shader "color"
    {
        uniform token info:id = "ND_image_color3"
        asset inputs:file = @../textures/branches.png@ (
            colorSpace = "srgb_texture"
        )
        float2 inputs:texcoord.connect = </Branches/uv.outputs:out>
        color3f outputs:out
    }
    def Shader "rgba"
    {
        uniform token info:id = "ND_image_color4"
        asset inputs:file = @../textures/branches.png@
        float2 inputs:texcoord.connect = </Branches/uv.outputs:out>
        color4f outputs:out
    }
    def Shader "alpha"
    {
        uniform token info:id = "ND_extract_color4"
        color4f inputs:in.connect = </Branches/rgba.outputs:out>
        int inputs:index = 3
        float outputs:out
    }
    def Shader "coverage"
    {
        uniform token info:id = "ND_convert_float_color3"
        float inputs:in.connect = </Branches/alpha.outputs:out>
        color3f outputs:out
    }
}
# Card k: centre (cx, cy) and half size 2.2 on the z = 0 plane, pushed to distance 10 s from the camera (z = 10 - 10 s)
# and scaled by s with its texture repeated s x s times: the same pixels show s times the texels per pixel, as an
# s-times-larger patch of foliage cards seen at s times the distance.
class "Card" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2.2, -2.2, 0), (2.2, -2.2, 0), (2.2, 2.2, 0), (-2.2, 2.2, 0)]
    uniform token subdivisionScheme = "none"
    texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
        interpolation = "vertex"
    )
    rel material:binding = </Branches>
}
def Mesh "Near" (
    inherits = </Card>
)
{
    double3 xformOp:translate = (-2.5, 2.5, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
def Mesh "Far3" (
    inherits = </Card>
)
{
    double3 xformOp:translate = (7.5, 7.5, -20)
    float3 xformOp:scale = (3, 3, 3)
    texCoord2f[] primvars:st = [(0, 0), (3, 0), (3, 3), (0, 3)] (
        interpolation = "vertex"
    )
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
def Mesh "Far9" (
    inherits = </Card>
)
{
    double3 xformOp:translate = (-22.5, -22.5, -80)
    float3 xformOp:scale = (9, 9, 9)
    texCoord2f[] primvars:st = [(0, 0), (9, 0), (9, 9), (0, 9)] (
        interpolation = "vertex"
    )
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
def Mesh "Far27" (
    inherits = </Card>
)
{
    double3 xformOp:translate = (67.5, -67.5, -260)
    float3 xformOp:scale = (27, 27, 27)
    texCoord2f[] primvars:st = [(0, 0), (27, 0), (27, 27), (0, 27)] (
        interpolation = "vertex"
    )
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}
