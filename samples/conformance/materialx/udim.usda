#usda 1.0
(
    doc = """A MaterialX image file with a <UDIM> pattern reads tile 1001 for u, v in [0, 1], 1002 for u in [1, 2] and 1011 for v
in [1, 2]: a quad whose st spans 0..2 on both axes shows 1001 bottom left (its image red over green: the image top at v = 1), 1002 (blue) bottom right, 1011 (green)
top left and 1012 (yellow, a 4x4 image among 8x8 ones) top right. hdUE builds UE's virtual texture of the set at
runtime (docs/materials.md)."""
    customLayerData = {
        string conformance = """{
 "schema": "MaterialX",
 "feature": "image <UDIM> file pattern",
 "frames": 1,
 "checks": [
  {
   "name": "no warning about the UDIM texture",
   "log": "hdUE.*<UDIM>",
   "present": false
  },
  {
   "name": "tile 1001 (u 0-1, v 0-1): the image top (red) at v near 1",
   "color": {
    "region": [
     -2.3,
     -0.8,
     -1.7,
     -0.2
    ]
   },
   "rgb": [
    0.9,
    0.05,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "tile 1001: the image bottom (green) at v near 0",
   "color": {
    "region": [
     -2.3,
     -1.8,
     -1.7,
     -1.2
    ]
   },
   "rgb": [
    0.05,
    0.9,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "tile 1002 (u 1-2, v 0-1) blue",
   "color": {
    "region": [
     1.5,
     -1.5,
     2.5,
     -0.5
    ]
   },
   "rgb": [
    0.05,
    0.05,
    0.9
   ],
   "tol": 0.25
  },
  {
   "name": "tile 1011 (u 0-1, v 1-2) green",
   "color": {
    "region": [
     -2.5,
     0.5,
     -1.5,
     1.5
    ]
   },
   "rgb": [
    0.05,
    0.9,
    0.05
   ],
   "tol": 0.25
  },
  {
   "name": "tile 1012 (u 1-2, v 1-2) yellow, a smaller image",
   "color": {
    "region": [
     1.5,
     0.5,
     2.5,
     1.5
    ]
   },
   "rgb": [
    0.5,
    0.5,
    0.02
   ],
   "tol": 0.25
  }
 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)
def Material "Udim"
{
    token outputs:mtlx:surface.connect = </Udim/S.outputs:out>
    def Shader "S"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
        color3f inputs:base_color.connect = </Udim/color.outputs:out>
        token outputs:out
    }
    def Shader "uv"
    {
        uniform token info:id = "ND_geompropvalue_vector2"
        string inputs:geomprop = "st"
        float2 outputs:out
    }
    def Shader "color"
    {
        uniform token info:id = "ND_image_color3"
        asset inputs:file = @../textures/udim.<UDIM>.png@
        float2 inputs:texcoord.connect = </Udim/uv.outputs:out>
        color3f outputs:out
    }
}
def Mesh "Quad" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-4, -2, 0), (4, -2, 0), (4, 2, 0), (-4, 2, 0)]
    uniform token subdivisionScheme = "none"
    uniform bool doubleSided = 1
    texCoord2f[] primvars:st = [(0, 0), (2, 0), (2, 2), (0, 2)] (
        interpolation = "faceVarying"
    )
    int[] primvars:st:indices = [0, 1, 2, 3]
    rel material:binding = </Udim>
}
