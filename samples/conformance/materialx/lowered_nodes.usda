 ]
}"""
    }
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 1
    endTimeCode = 1
    timeCodesPerSecond = 24
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [@../common/stage.usda@]
)

def Scope "Looks"
{
    # transformmatrix of creatematrix's columns (0,1,0), (1,0,0), (0,0,1): M * (0.2, 0.6, 0.9)
    def Material "MatrixTransform"
    {
        token outputs:mtlx:surface.connect = </Looks/MatrixTransform/surface.outputs:out>
        def Shader "m"
        {
            uniform token info:id = "ND_creatematrix_vector3_matrix33"
            float3 inputs:in1 = (0, 1, 0)
            float3 inputs:in2 = (1, 0, 0)
            float3 inputs:in3 = (0, 0, 1)
            float outputs:out
        }
        def Shader "t"
        {
            uniform token info:id = "ND_transformmatrix_vector3"
            float3 inputs:in = (0.2, 0.6, 0.9)
            matrix3d inputs:mat.connect = </Looks/MatrixTransform/m.outputs:out>
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/MatrixTransform/t.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/MatrixTransform/c.outputs:out>
            token outputs:out
        }
    }
    # inverse of diag(2, 4, 5) applied to (0.4, 0.8, 1)
    def Material "MatrixInverse"
    {
        token outputs:mtlx:surface.connect = </Looks/MatrixInverse/surface.outputs:out>
        def Shader "inv"
        {
            uniform token info:id = "ND_invertmatrix_matrix33"
            matrix3d inputs:in = ( (2, 0, 0), (0, 4, 0), (0, 0, 5) )
            float outputs:out
        }
        def Shader "t"
        {
            uniform token info:id = "ND_transformmatrix_vector3"
            float3 inputs:in = (0.4, 0.8, 1)
            matrix3d inputs:mat.connect = </Looks/MatrixInverse/inv.outputs:out>
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/MatrixInverse/t.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/MatrixInverse/c.outputs:out>
            token outputs:out
        }
    }
    # determinant of diag(0.5, 0.6, 1) times transpose of itself: 0.09
    def Material "MatrixDeterminant"
    {
        token outputs:mtlx:surface.connect = </Looks/MatrixDeterminant/surface.outputs:out>
        def Shader "tr"
        {
            uniform token info:id = "ND_transpose_matrix33"
            matrix3d inputs:in = ( (0.5, 0, 0), (0, 0.6, 0), (0, 0, 1) )
            float outputs:out
        }
        def Shader "mul"
        {
            uniform token info:id = "ND_multiply_matrix33"
            matrix3d inputs:in1.connect = </Looks/MatrixDeterminant/tr.outputs:out>
            matrix3d inputs:in2 = ( (0.5, 0, 0), (0, 0.6, 0), (0, 0, 1) )
            float outputs:out
        }
        def Shader "d"
        {
            uniform token info:id = "ND_determinant_matrix33"
            matrix3d inputs:in.connect = </Looks/MatrixDeterminant/mul.outputs:out>
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/MatrixDeterminant/d.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/MatrixDeterminant/c.outputs:out>
            token outputs:out
        }
    }
    # (2 + 3) as a float, times 0.1
    def Material "Integers"
    {
        token outputs:mtlx:surface.connect = </Looks/Integers/surface.outputs:out>
        def Shader "add"
        {
            uniform token info:id = "ND_add_integer"
            int inputs:in1 = 2
            int inputs:in2 = 3
            float outputs:out
        }
        def Shader "f"
        {
            uniform token info:id = "ND_convert_integer_float"
            int inputs:in.connect = </Looks/Integers/add.outputs:out>
            float outputs:out
        }
        def Shader "m"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/Integers/f.outputs:out>
            float inputs:in2 = 0.1
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/Integers/m.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/Integers/c.outputs:out>
            token outputs:out
        }
    }
    # (true and false, true or false, not false) as floats
    def Material "Booleans"
    {
        token outputs:mtlx:surface.connect = </Looks/Booleans/surface.outputs:out>
        def Shader "a"
        {
            uniform token info:id = "ND_logical_and"
            bool inputs:in1 = 1
            bool inputs:in2 = 0
            float outputs:out
        }
        def Shader "o"
        {
            uniform token info:id = "ND_logical_or"
            bool inputs:in1 = 1
            bool inputs:in2 = 0
            float outputs:out
        }
        def Shader "n"
        {
            uniform token info:id = "ND_logical_not"
            bool inputs:in = 0
            float outputs:out
        }
        def Shader "fa"
        {
            uniform token info:id = "ND_convert_boolean_float"
            bool inputs:in.connect = </Looks/Booleans/a.outputs:out>
            float outputs:out
        }
        def Shader "fo"
        {
            uniform token info:id = "ND_convert_boolean_float"
            bool inputs:in.connect = </Looks/Booleans/o.outputs:out>
            float outputs:out
        }
        def Shader "fn"
        {
            uniform token info:id = "ND_convert_boolean_float"
            bool inputs:in.connect = </Looks/Booleans/n.outputs:out>
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/Booleans/fa.outputs:out>
            float inputs:in2.connect = </Looks/Booleans/fo.outputs:out>
            float inputs:in3.connect = </Looks/Booleans/fn.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/Booleans/c.outputs:out>
            token outputs:out
        }
    }
    # Houdini's MaterialX 1.38 swizzle bgr of (0.1, 0.5, 0.9)
    def Material "Swizzle"
    {
        token outputs:mtlx:surface.connect = </Looks/Swizzle/surface.outputs:out>
        def Shader "s"
        {
            uniform token info:id = "ND_swizzle_color3_color3"
            color3f inputs:in = (0.1, 0.5, 0.9)
            string inputs:channels = "bgr"
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/Swizzle/s.outputs:out>
            token outputs:out
        }
    }
    # curveadjust of 0.25 through the knots (0, 0), (0.5, 0.8), (1, 1): linear, 0.4
    def Material "CurveAdjust"
    {
        token outputs:mtlx:surface.connect = </Looks/CurveAdjust/surface.outputs:out>
        def Shader "k"
        {
            uniform token info:id = "ND_curveadjust_float"
            float inputs:in = 0.25
            float2[] inputs:knots = [(0, 0), (0.5, 0.8), (1, 1)]
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/CurveAdjust/k.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/CurveAdjust/c.outputs:out>
            token outputs:out
        }
    }
    # Houdini's MaterialX 1.38 atan2(1, 1) = pi / 4
    def Material "Atan2"
    {
        token outputs:mtlx:surface.connect = </Looks/Atan2/surface.outputs:out>
        def Shader "a"
        {
            uniform token info:id = "ND_atan2_float_1_38"
            float inputs:in1 = 1
            float inputs:in2 = 1
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/Atan2/a.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/Atan2/c.outputs:out>
            token outputs:out
        }
    }
    # frame / 10 at frame 1 (24 fps)
    def Material "Frame"
    {
        token outputs:mtlx:surface.connect = </Looks/Frame/surface.outputs:out>
        def Shader "f"
        {
            uniform token info:id = "ND_frame_float"
            float outputs:out
        }
        def Shader "m"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/Frame/f.outputs:out>
            float inputs:in2 = 0.1
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/Frame/m.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/Frame/c.outputs:out>
            token outputs:out
        }
    }
    # ambientocclusion: 1 (UE occludes the lighting itself)
    def Material "AmbientOcclusion"
    {
        token outputs:mtlx:surface.connect = </Looks/AmbientOcclusion/surface.outputs:out>
        def Shader "a"
        {
            uniform token info:id = "ND_ambientocclusion_float"
            float outputs:out
        }
        def Shader "m"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/AmbientOcclusion/a.outputs:out>
            float inputs:in2 = 0.7
            float outputs:out
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/AmbientOcclusion/m.outputs:out>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/AmbientOcclusion/c.outputs:out>
            token outputs:out
        }
    }
    # flake3d presence, flakes of 5 cm at coverage 0.5 (hdUE's import runs MaterialX's flake code): the mean of MaterialX's mx_flake over the region, 0.25 to 0.28 as the plane's orientation varies
    def Material "Flake3D"
    {
        token outputs:mtlx:surface.connect = </Looks/Flake3D/surface.outputs:out>
        def Shader "f"
        {
            uniform token info:id = "ND_flake3d"
            float inputs:size = 0.05
            float inputs:coverage = 0.5
            float outputs:presence
        }
        def Shader "c"
        {
            uniform token info:id = "ND_convert_float_color3"
            float inputs:in.connect = </Looks/Flake3D/f.outputs:presence>
            color3f outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 0
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/Flake3D/c.outputs:out>
            token outputs:out
        }
    }
}

