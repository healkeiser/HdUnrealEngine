{
  "HdUEHoudiniRendererPlugin": {
    "valid": "env:HDUE_HOUDINI_ENABLE",
    "menulabel": "Unreal Engine (hdUE)",
    "menupriority": 30,
    "allowbackgroundupdate": true,
    "viewportrenderer": false,
    "destroyifdeactivated": false,
    "pauseonupdate": false,
    "defaultpurposes": ["default", "render"],
    "drawmodesupport": false,
    "needsdepth": false,
    "needsselection": true,
    "depthstyle": "linear",
    "aovsupport": true,
    "statsdatapaths": {"rendererStage": "rendererStage", "totalClockTime": "totalClockTime", "percentDone": "percentDone"},
    "viewstats": ["nativeActors", "nativeMeshes", "completedSamples"]
  }
}
