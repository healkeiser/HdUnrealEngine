/// hdUE viewport settings (Display Options > Unreal Engine). Names match _Global.ds: keep them.
#include "$HFS/houdini/soho/parameters/CommonMacros.ds"
{
    name "hdUE"
    label "Unreal Engine"
    parmtag { spare_opfilter "!!SHOP/PROPERTIES!!" }
    parmtag { spare_classtags "render" }

    group {
        name "hdUE_Rendering"
        label "Rendering"
        parmtag { "uiscope" "viewport" }
        parm {
            name "xn__unrealrenderMode_41a"
            label "Render Mode"
            type string
            size 1
            default { "realtime" }
            menu { "realtime" "Realtime (Lumen)" "pathtraced" "Path Tracer" }
            parmtag { "spare_category" "Rendering" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name "xn__unrealwarmupFrames_e5a"
            label "Warmup Frames"
            type int
            size 1
            default { 32 }
            range { 0! 256 }
            help "Realtime frames before a frame counts as converged."
            parmtag { "spare_category" "Rendering" }
            parmtag { "uiscope" "viewport" }
            hidewhen "{ xn__unrealrenderMode_41a == pathtraced }"
        }
        parm {
            name "xn__unrealsamplesPerPixel_99a"
            label "Path Tracer Samples"
            type int
            size 1
            default { 64 }
            range { 1! 4096 }
            parmtag { "spare_category" "Rendering" }
            parmtag { "uiscope" "viewport" }
            hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
        }
        parm {
            name "xn__unrealdenoiser_vya"
            label "Denoiser"
            type string
            size 1
            default { "off" }
            menu { "off" "Off" "oidn" "Open Image Denoise" }
            help "Denoises the converged Path Tracer image."
            parmtag { "spare_category" "Rendering" }
            parmtag { "uiscope" "viewport" }
            hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
        }
        parm {
            name "xn__unrealdebugView_i0a"
            label "Debug View"
            type string
            size 1
            default { "off" }
            menu { "off" "Lit" "unlit" "Unlit" "lightingOnly" "Lighting Only" "detailLighting" "Detail Lighting" "reflections" "Reflections" "lightComplexity" "Light Complexity" "buffer:BaseColor" "Buffer: Base Color" "buffer:Metallic" "Buffer: Metallic" "buffer:Roughness" "Buffer: Roughness" "buffer:Specular" "Buffer: Specular" "buffer:WorldNormal" "Buffer: World Normal" "buffer:SceneDepth" "Buffer: Scene Depth" "buffer:ShadingModel" "Buffer: Shading Model" "nanite:Mask" "Nanite: Mask" "nanite:Triangles" "Nanite: Triangles" "nanite:Clusters" "Nanite: Clusters" "nanite:Primitives" "Nanite: Primitives" "nanite:Instances" "Nanite: Instances" "nanite:Overdraw" "Nanite: Overdraw" "lumen:Overview" "Lumen: Overview" "lumen:LumenScene" "Lumen: Lumen Scene" "lumen:SurfaceCache" "Lumen: Surface Cache" "lumen:GeometryNormals" "Lumen: Geometry Normals" "lumen:ReflectionView" "Lumen: Reflection View" "vsm:mip" "Virtual Shadow Map: Mip Level" "vsm:vpage" "Virtual Shadow Map: Virtual Page" "vsm:cache" "Virtual Shadow Map: Cached Page" }
            help "Shows one of UE's viewport view modes instead of the lit image, as its View Mode menu does: buffers, Nanite, Lumen and Virtual Shadow Map (with Virtual Shadow Maps on) visualizations. Realtime only; AOVs are unaffected."
            parmtag { "spare_category" "Rendering" }
            parmtag { "uiscope" "viewport" }
            hidewhen "{ xn__unrealrenderMode_41a == pathtraced }"
        }
        parm {
            name "xn__unrealmotionBlur_41a"
            label "Motion Blur"
            type toggle
            size 1
            default { 1 }
            parmtag { "spare_category" "Rendering" }
            parmtag { "uiscope" "viewport" }
        }
    }
    group {
        name "hdUE_Lighting"
        label "Lighting"
        parmtag { "uiscope" "viewport" }
        parm {
            name "xn__unreallumenEnabled_e5a"
            label "Lumen"
            type toggle
            size 1
            default { 1 }
            parmtag { "spare_category" "Lighting" }
            parmtag { "uiscope" "viewport" }
            hidewhen "{ xn__unrealrenderMode_41a == pathtraced }"
        }
        parm {
            name "xn__unrealautoViewerLight_99a"
            label "Light Unlit Scenes"
            type toggle
            size 1
            default { 1 }
            parmtag { "spare_category" "Lighting" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name "xn__unrealviewerLightIntensity_fjb"
            label "Viewer Light Intensity"
            type float
            size 1
            default { 4 }
            range { 0! 100! }
            help "Intensity of the unlit-scene lights and of the headlight."
            parmtag { "spare_category" "Lighting" }
            parmtag { "uiscope" "viewport" }
        }
    }
    group {
        name "hdUE_Geometry"
        label "Geometry and Post"
        parmtag { "uiscope" "viewport" }
        parm {
            name "xn__unrealsubdivisionLevel_wcb"
            label "Subdivision Level"
            type int
            size 1
            default { 0 }
            range { 0! 5 }
            parmtag { "spare_category" "Geometry" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name "xn__unrealtonemapper_41a"
            label "Unreal Tonemapper"
            type toggle
            size 1
            default { 0 }
            help "The beauty becomes UE's tone-mapped image (display-linear): view it with the default sRGB view, not Raw or ACES."
            parmtag { "spare_category" "Post-Processing" }
            parmtag { "uiscope" "viewport" }
        }
    }
    /// BEGIN generated by scripts/generate_render_settings.py: Engine Quality
    group {
        name "hdUE_Quality"
        label "Engine Quality"
        parmtag { "uiscope" "viewport" }
        parm {
            name    "xn__unrealcvarsgShadowQuality_shbec"
            label   "Shadows"
            type    int
            size    1
            default { 3 }
            menu { "0" "Low" "1" "Medium" "2" "High" "3" "Epic" "4" "Cinematic" }
            help    "UE scalability group: applies the console variables of this quality level (Engine/Config/BaseScalability.ini). Variables set here explicitly take precedence. Console variable sg.ShadowQuality (process-wide)."
            parmtag { "spare_category" "Scalability" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarsgGlobalIlluminationQuality_c1bec"
            label   "Global Illumination"
            type    int
            size    1
            default { 3 }
            menu { "0" "Low" "1" "Medium" "2" "High" "3" "Epic" "4" "Cinematic" }
            help    "UE scalability group: applies the console variables of this quality level (Engine/Config/BaseScalability.ini). Variables set here explicitly take precedence. Console variable sg.GlobalIlluminationQuality (process-wide)."
            parmtag { "spare_category" "Scalability" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarsgReflectionQuality_bobec"
            label   "Reflections"
            type    int
            size    1
            default { 3 }
            menu { "0" "Low" "1" "Medium" "2" "High" "3" "Epic" "4" "Cinematic" }
            help    "UE scalability group: applies the console variables of this quality level (Engine/Config/BaseScalability.ini). Variables set here explicitly take precedence. Console variable sg.ReflectionQuality (process-wide)."
            parmtag { "spare_category" "Scalability" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrAntiAliasingMethod_bobeb"
            label   "Anti-Aliasing Method"
            type    int
            size    1
            default { 4 }
            menu { "0" "None" "1" "FXAA" "2" "TAA" "4" "TSR" }
            help    "Engine default (project setting) for AntiAliasingMethod is (postprocess volume/camera/game setting still can override) 0: off (no anti-aliasing) 1: Fast Approximate Anti-Aliasing (FXAA) 2: Temporal Anti-Aliasing (TAA) 3: Multisample Anti-Aliasing (MSAA, Only available on the desktop forward renderer) 4: Temporal Super-Resolution (TSR, Default) 5: Subpixel Morphological Anti-Aliasing (SMAA) Console variable r.AntiAliasingMethod (process-wide)."
            parmtag { "spare_category" "Anti-Aliasing" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrNGXDLSSEnable_5fbebde"
            label   "NVIDIA DLSS"
            type    toggle
            size    1
            default { 0 }
            help    "NVIDIA DLSS Super Resolution in place of TAA or TSR: Screen Percentage picks the DLSS mode, 100 is DLAA. Needs NVIDIA's DLSS plugin in the backend (docs/building.md) and an RTX GPU; otherwise the anti-aliasing method renders. Realtime mode only. Console variable r.NGX.DLSS.Enable (process-wide)."
            parmtag { "spare_category" "Anti-Aliasing" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrScreenPercentage_1kbeb"
            label   "Screen Percentage"
            type    float
            size    1
            default { 100 }
            range   { 10! 200! }
            help    "To render in lower resolution and upscale for better performance (combined up with the blenable post process setting). 70 is a good value for low aliasing and performance, can be verified with 'show TestImage' in percent, >0 and <=100, larger numbers are possible (supersampling) but the downsampling quality is improvable.<=0 compute the screen percentage is determined by r.ScreenPercentage.Default cvars. Console variable r.ScreenPercentage (process-wide)."
            parmtag { "spare_category" "Anti-Aliasing" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrHdUEInteractiveResolution_pzbebe"
            label   "Lower Resolution While Moving"
            type    toggle
            size    1
            default { 1 }
            help    "Interactive hosts (Houdini's viewport): render at Moving Screen Percentage while the camera or scene changes, and at full Screen Percentage 250 ms after the last change. Realtime mode only. Console variable r.HdUE.InteractiveResolution (process-wide)."
            parmtag { "spare_category" "Anti-Aliasing" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrHdUEInteractiveScreenPercentage_h9bebe"
            label   "Moving Screen Percentage"
            type    float
            size    1
            default { 50 }
            range   { 10! 100! }
            help    "Screen percentage while moving, upsampled by the anti-aliasing method (TSR by default). Console variable r.HdUE.InteractiveScreenPercentage (process-wide)."
            parmtag { "spare_category" "Anti-Aliasing" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrLumenHardwareRayTracing_gwbebf"
            label   "Hardware Ray Tracing"
            type    toggle
            size    1
            default { 1 }
            help    "Uses Hardware Ray Tracing for Lumen features, when available. Lumen will fall back to Software Ray Tracing otherwise. Note: Hardware ray tracing has significant scene update costs for scenes with more than 100k instances. Console variable r.Lumen.HardwareRayTracing (process-wide)."
            parmtag { "spare_category" "Lumen Global Illumination" }
            parmtag { "uiscope" "viewport" }
        }
        parm {
            name    "xn__unrealcvarrShadowVirtualEnable_xpbebgh"
            label   "Virtual Shadow Maps"
            type    toggle
            size    1
            default { 1 }
            help    "Enable Virtual Shadow Maps. Renders geometry into virtualized shadow depth maps for shadowing. Provides high - quality shadows for next - gen projects with simplified setup.High efficiency culling when used with Nanite. Console variable r.Shadow.Virtual.Enable (process-wide)."
            parmtag { "spare_category" "Shadows" }
            parmtag { "uiscope" "viewport" }
        }
    }
    /// END generated
}
