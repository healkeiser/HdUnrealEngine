            HDUE_CONTROL("xn__unrealpostProcessColorCorrectionHighlightsMin_control_escl", "HighlightsMin")
            parm {
                name    "xn__unrealpostProcessColorCorrectionHighlightsMin_dfcl"
                label   "HighlightsMin"
                type    float
                size    1
                default { 0.5 }
                range   { -1 1 }
                help    "This value sets the lower threshold for what is considered to be the highlight region of the image."
                parmtag { "spare_category" "Color Grading|Highlights" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessColorCorrectionHighlightsMin_control_escl == block } { xn__unrealpostProcessColorCorrectionHighlightsMin_control_escl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorCorrectionHighlightsMax_control_escl", "HighlightsMax")
            parm {
                name    "xn__unrealpostProcessColorCorrectionHighlightsMax_dfcl"
                label   "HighlightsMax"
                type    float
                size    1
                default { 1 }
                range   { 1 10 }
                help    "This value sets the upper threshold for what is considered to be the highlight region of the image. This value should be larger than HighlightsMin. Default is 1.0, for backwards compatibility"
                parmtag { "spare_category" "Color Grading|Highlights" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessColorCorrectionHighlightsMax_control_escl == block } { xn__unrealpostProcessColorCorrectionHighlightsMax_control_escl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
