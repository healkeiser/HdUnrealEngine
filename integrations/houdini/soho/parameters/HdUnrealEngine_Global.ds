                help    "Allow effect of Tone Curve to be reduced (Set ToneCurveAmount and ExpandGamut to 0.0 to fully disable tone curve)"
                parmtag { "spare_category" "Color Grading|Misc" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessToneCurveAmount_control_75bl == block } { xn__unrealpostProcessToneCurveAmount_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessSceneColorTint_control_l4bl", "Scene Color Tint")
