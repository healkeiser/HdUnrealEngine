/// hdUE render settings, authored as unreal:* attributes on a UsdRenderSettings prim.
/// With the delegate registered, Render Settings LOPs show them on an "Unreal Engine" tab: an
/// Essential | Advanced strip, the main settings, then tabs of collapsible sections in UE's own categories.
/// Parameter names encode the attribute names: keep them. The whole tab is generated by
/// scripts/generate_render_settings.py (UE's settings from the engine source, hdUE's own from its HDUE list):
/// edit the script, not the block. scripts/build_render_settings_hda.py builds hdUE Render Settings from it.

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"

/// A setting's USD control menu, with the operations of the setting's usdvaluetype (as Karma's).
#define HDUE_CONTROL(NAME, LABEL) \
    parm { \
        name    NAME \
        label   LABEL \
        type    string \
        default { "none" } \
        menujoin { \
            [ "import loputils" ] \
            [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ] \
            [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ] \
            language python \
        } \
        help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's." \
        parmtag { "sidefx::look" "icon" } \
    }

/// Same, hidden with its parameter (a setting that applies to one render mode only).
#define HDUE_CONTROL_HIDE(NAME, LABEL, HIDE) \
    parm { \
        name    NAME \
        label   LABEL \
        type    string \
        default { "none" } \
        menujoin { \
            [ "import loputils" ] \
            [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ] \
            [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ] \
            language python \
        } \
        help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's." \
        parmtag { "sidefx::look" "icon" } \
        hidewhen HIDE \
    }

{
    name        "hdUE"
    label       "Unreal Engine"
    parmtag     { spare_opfilter        "!!SHOP/PROPERTIES!!" }
    parmtag     { spare_classtags       "render" }

    /// BEGIN generated by scripts/generate_render_settings.py: Unreal Engine
    HDUE_CONTROL("xn__unrealrenderMode_control_5fb", "Render Mode")
    parm {
        name    "xn__unrealrenderMode_41a"
        label   "Render Mode"
        type    string
        size    1
        default { "realtime" }
        menu { "realtime" "Realtime (Lumen)" "pathtraced" "Path Tracer" }
        help    "Realtime renders with UE's deferred renderer, Lumen and MegaLights, and is meant for final frames too. Path Tracer accumulates UE's reference path tracer."
        parmtag { "spare_category" "Rendering" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "token" }
        disablewhen R"({ xn__unrealrenderMode_control_5fb == block } { xn__unrealrenderMode_control_5fb == none })"
    }
    HDUE_CONTROL_HIDE("xn__unrealsamplesPerPixel_control_bob", "Path Tracer Samples", "{ xn__unrealrenderMode_41a != pathtraced }")
    parm {
        name    "xn__unrealsamplesPerPixel_99a"
        label   "Path Tracer Samples"
        type    int
        size    1
        default { 64 }
        range   { 1! 65536! }
        help    "Samples per pixel. Divided between motion-blur sub-frames."
        parmtag { "spare_category" "Rendering" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
        disablewhen R"({ xn__unrealsamplesPerPixel_control_bob == block } { xn__unrealsamplesPerPixel_control_bob == none })"
        hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
    }
    HDUE_CONTROL_HIDE("xn__unrealwarmupFrames_control_fjb", "Warmup Frames", "{ xn__unrealrenderMode_41a != realtime }")
    parm {
        name    "xn__unrealwarmupFrames_e5a"
        label   "Warmup Frames"
        type    int
        size    1
        default { 32 }
        range   { 1! 256 }
        help    "Realtime frames rendered before a frame counts as converged, so Lumen and temporal effects settle. In husk, only a sequence's first frame warms up: each later frame continues its history with one draw, as Movie Render Queue does."
        parmtag { "spare_category" "Rendering" }
        parmtag { "uiscope" "viewport" }
        parmtag { "usdvaluetype" "int" }
        disablewhen R"({ xn__unrealwarmupFrames_control_fjb == block } { xn__unrealwarmupFrames_control_fjb == none })"
        hidewhen "{ xn__unrealrenderMode_41a != realtime }"
    }
    HDUE_CONTROL_HIDE("xn__unrealdenoiser_control_wcb", "Denoiser", "{ xn__unrealrenderMode_41a != pathtraced }")
    parm {
        name    "xn__unrealdenoiser_vya"
        label   "Denoiser"
        type    string
        size    1
        default { "off" }
        menu { "off" "Off" "oidn" "Open Image Denoise" }
        help    "Denoises the converged Path Tracer image with Houdini's Open Image Denoise (on the GPU when available), guided by albedo and normal passes. AOVs and Lumen are unaffected."
        parmtag { "spare_category" "Rendering" }
        parmtag { "usdvaluetype" "token" }
        disablewhen R"({ xn__unrealdenoiser_control_wcb == block } { xn__unrealdenoiser_control_wcb == none })"
        hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
    }
    HDUE_CONTROL("xn__unrealtonemapper_control_5fb", "Unreal Tonemapper")
    parm {
        name    "xn__unrealtonemapper_41a"
        label   "Unreal Tonemapper"
        type    toggle
        size    1
        default { 0 }
        help    "Run UE's tonemapper, bloom, colour grading, vignette and grain. The beauty becomes UE's tone-mapped image (display-linear): view it with the default sRGB view, not Raw or ACES."
        parmtag { "spare_category" "Post-Processing" }
        parmtag { "usdvaluetype" "bool" }
        disablewhen R"({ xn__unrealtonemapper_control_5fb == block } { xn__unrealtonemapper_control_5fb == none })"
    }
    HDUE_CONTROL("xn__unrealpostProcessAutoExposureBias_control_u7bl", "Exposure Compensation")
    parm {
        name    "xn__unrealpostProcessAutoExposureBias_tubl"
        label   "Exposure Compensation"
        type    float
        size    1
        default { 0 }
        range   { -15 15 }
        help    "Logarithmic adjustment for the exposure. Only used if a tonemapper is specified. 0: no adjustment, -1:2x darker, -2:4x darker, 1:2x brighter, 2:4x brighter, ... hdUE adds the USD camera exposure to it."
        parmtag { "spare_category" "Lens|Exposure" }
        parmtag { "usdvaluetype" "float" }
        disablewhen R"({ xn__unrealpostProcessAutoExposureBias_control_u7bl == block } { xn__unrealpostProcessAutoExposureBias_control_u7bl == none } { xn__unrealtonemapper_41a == 0 })"
    }
    parm {
        name    "hdue_sepmain"
        label   "Separator"
        type    separator
        default { "" }
    }

    group {
        name "hdUE_Rendering_Tab"
        label "Rendering"

        groupcollapsible {
            name "hdUE_Rendering_AntiAliasing"
            label "Anti-Aliasing"
            grouptag { "group_default" "1" }
            HDUE_CONTROL_HIDE("xn__unrealcvarrAntiAliasingMethod_control_c1beb", "Anti-Aliasing Method", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrAntiAliasingMethod_bobeb"
                label   "Anti-Aliasing Method"
                type    int
                size    1
                default { 4 }
                menu { "0" "None" "1" "FXAA" "2" "TAA" "4" "TSR" }
                help    "Engine default (project setting) for AntiAliasingMethod is (postprocess volume/camera/game setting still can override) 0: off (no anti-aliasing) 1: Fast Approximate Anti-Aliasing (FXAA) 2: Temporal Anti-Aliasing (TAA) 3: Multisample Anti-Aliasing (MSAA, Only available on the desktop forward renderer) 4: Temporal Super-Resolution (TSR, Default) 5: Subpixel Morphological Anti-Aliasing (SMAA) Console variable r.AntiAliasingMethod (process-wide)."
                parmtag { "spare_category" "Anti-Aliasing" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrAntiAliasingMethod_control_c1beb == block } { xn__unrealcvarrAntiAliasingMethod_control_c1beb == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL("xn__unrealcvarrScreenPercentage_control_2xbeb", "Screen Percentage")
            parm {
                name    "xn__unrealcvarrScreenPercentage_1kbeb"
                label   "Screen Percentage"
                type    float
                size    1
                default { 100 }
                range   { 10! 200! }
                help    "To render in lower resolution and upscale for better performance (combined up with the blenable post process setting). 70 is a good value for low aliasing and performance, can be verified with 'show TestImage' in percent, >0 and <=100, larger numbers are possible (supersampling) but the downsampling quality is improvable.<=0 compute the screen percentage is determined by r.ScreenPercentage.Default cvars. Console variable r.ScreenPercentage (process-wide)."
                parmtag { "spare_category" "Anti-Aliasing" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealcvarrScreenPercentage_control_2xbeb == block } { xn__unrealcvarrScreenPercentage_control_2xbeb == none })"
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrHdUEInteractiveResolution_control_qdcebe", "Lower Resolution While Moving", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrHdUEInteractiveResolution_pzbebe"
                label   "Lower Resolution While Moving"
                type    toggle
                size    1
                default { 1 }
                help    "Interactive hosts (Houdini's viewport): render at Moving Screen Percentage while the camera or scene changes, and at full Screen Percentage 250 ms after the last change. Realtime mode only. Console variable r.HdUE.InteractiveResolution (process-wide)."
                parmtag { "spare_category" "Anti-Aliasing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealcvarrHdUEInteractiveResolution_control_qdcebe == block } { xn__unrealcvarrHdUEInteractiveResolution_control_qdcebe == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrHdUEInteractiveScreenPercentage_control_incebe", "Moving Screen Percentage", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrHdUEInteractiveScreenPercentage_h9bebe"
                label   "Moving Screen Percentage"
                type    float
                size    1
                default { 50 }
                range   { 10! 100! }
                help    "Screen percentage while moving, upsampled by the anti-aliasing method (TSR by default). Console variable r.HdUE.InteractiveScreenPercentage (process-wide)."
                parmtag { "spare_category" "Anti-Aliasing" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealcvarrHdUEInteractiveScreenPercentage_control_incebe == block } { xn__unrealcvarrHdUEInteractiveScreenPercentage_control_incebe == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Rendering_PathTracing"
            label "Path Tracing"
            grouptag { "group_default" "1" }
            hidewhentab "{ xn__unrealrenderMode_41a != pathtraced }"
            HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingMaxBounces_control_zgcl", "Max. Bounces", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealpostProcessPathTracingMaxBounces_y2bl"
                label   "Max. Bounces"
                type    int
                size    1
                default { 32 }
                range   { 0! 100! }
                help    "Sets the path tracing maximum bounces. Counts scattering events along a path: 0 shows only emission seen directly, 1 is direct light alone, N matches Karma's Diffuse Limit N - 1. One limit covers diffuse, specular, refraction and volume bounces."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealpostProcessPathTracingMaxBounces_control_zgcl == block } { xn__unrealpostProcessPathTracingMaxBounces_control_zgcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingMaxPathIntensity_control_rqcl", "Max Path Intensity", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealpostProcessPathTracingMaxPathIntensity_qdcl"
                label   "Max Path Intensity"
                type    float
                size    1
                default { 24 }
                range   { 1! 65504! }
                help    "Sets the maximum intensity of indirect samples to reduce fireflies. Lowering this value reduces noise at the expense of accuracy. Increasing it is more accurate but may lead to more noise."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessPathTracingMaxPathIntensity_control_rqcl == block } { xn__unrealpostProcessPathTracingMaxPathIntensity_control_rqcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingEnableEmissiveMaterials_control_51cl", "Emissive Materials", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealpostProcessPathTracingEnableEmissiveMaterials_4ocl"
                label   "Emissive Materials"
                type    toggle
                size    1
                default { 1 }
                help    "Should emissive materials contribute to scene lighting?"
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessPathTracingEnableEmissiveMaterials_control_51cl == block } { xn__unrealpostProcessPathTracingEnableEmissiveMaterials_control_51cl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingEnableReferenceDOF_control_0tcl", "Reference Depth Of Field", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealpostProcessPathTracingEnableReferenceDOF_zgcl"
                label   "Reference Depth Of Field"
                type    toggle
                size    1
                default { 1 }
                help    "Enables a reference quality depth-of-field which replaces the post-process effect. hdUE turns it on when the USD camera has depth of field."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessPathTracingEnableReferenceDOF_control_0tcl == block } { xn__unrealpostProcessPathTracingEnableReferenceDOF_control_0tcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingEnableReferenceAtmosphere_control_f5cl", "Reference Atmosphere", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealpostProcessPathTracingEnableReferenceAtmosphere_escl"
                label   "Reference Atmosphere"
                type    toggle
                size    1
                default { 0 }
                help    "Enables path tracing in the atmosphere instead of baking the sky atmosphere contribution into a skylight. Any skylight present in the scene will be automatically ignored when this is enabled."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessPathTracingEnableReferenceAtmosphere_control_f5cl == block } { xn__unrealpostProcessPathTracingEnableReferenceAtmosphere_control_f5cl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrPathTracingApproximateCaustics_control_vlcebl", "Approximate Caustics", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealcvarrPathTracingApproximateCaustics_u7bebl"
                label   "Approximate Caustics"
                type    toggle
                size    1
                default { 1 }
                help    "When true, the path tracer will approximate caustic paths to reduce noise. This reduces speckles and noise from low-roughness glass and metals. Console variable r.PathTracing.ApproximateCaustics (process-wide)."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealcvarrPathTracingApproximateCaustics_control_vlcebl == block } { xn__unrealcvarrPathTracingApproximateCaustics_control_vlcebl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrPathTracingFilterWidth_control_u7bebl", "Pixel Filter Width", "{ xn__unrealrenderMode_41a != pathtraced }")
            parm {
                name    "xn__unrealcvarrPathTracingFilterWidth_tubebl"
                label   "Pixel Filter Width"
                type    float
                size    1
                default { 3 }
                range   { 0! 6 }
                help    "Sets the anti-aliasing filter width (default = 3.0 which corresponds to a gaussian with standard deviation of a 1/2 pixel) Console variable r.PathTracing.FilterWidth (process-wide)."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealcvarrPathTracingFilterWidth_control_u7bebl == block } { xn__unrealcvarrPathTracingFilterWidth_control_u7bebl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }

            groupsimple {
                name "hdUE_Rendering_PathTracing_LightingComponents"
                label "Lighting Components"
                hidewhentab "{ xn__unrealrenderMode_41a != pathtraced }"
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeEmissive_control_4ocl", "Emissive", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeEmissive_3bcl"
                    label   "Emissive"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include directly visible emissive elements?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeEmissive_control_4ocl == block } { xn__unrealpostProcessPathTracingIncludeEmissive_control_4ocl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeDiffuse_control_incl", "Diffuse", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeDiffuse_h9bl"
                    label   "Diffuse"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include diffuse lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeDiffuse_control_incl == block } { xn__unrealpostProcessPathTracingIncludeDiffuse_control_incl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeIndirectDiffuse_control_j0cl", "Indirect Diffuse", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeIndirectDiffuse_incl"
                    label   "Indirect Diffuse"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include indirect diffuse lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeIndirectDiffuse_control_j0cl == block } { xn__unrealpostProcessPathTracingIncludeIndirectDiffuse_control_j0cl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeSpecular_control_4ocl", "Specular", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeSpecular_3bcl"
                    label   "Specular"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include specular lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeSpecular_control_4ocl == block } { xn__unrealpostProcessPathTracingIncludeSpecular_control_4ocl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeIndirectSpecular_control_51cl", "Indirect Specular", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeIndirectSpecular_4ocl"
                    label   "Indirect Specular"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include indirect specular lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeIndirectSpecular_control_51cl == block } { xn__unrealpostProcessPathTracingIncludeIndirectSpecular_control_51cl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeVolume_control_vlcl", "Volume", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeVolume_u7bl"
                    label   "Volume"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include volume lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeVolume_control_vlcl == block } { xn__unrealpostProcessPathTracingIncludeVolume_control_vlcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessPathTracingIncludeIndirectVolume_control_wycl", "Indirect Volume", "{ xn__unrealrenderMode_41a != pathtraced }")
                parm {
                    name    "xn__unrealpostProcessPathTracingIncludeIndirectVolume_vlcl"
                    label   "Indirect Volume"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include volume lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessPathTracingIncludeIndirectVolume_control_wycl == block } { xn__unrealpostProcessPathTracingIncludeIndirectVolume_control_wycl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != pathtraced }"
                }
            }
        }

        groupcollapsible {
            name "hdUE_Rendering_ViewMode"
            label "View Mode"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            HDUE_CONTROL_HIDE("xn__unrealdebugView_control_jeb", "Debug View", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealdebugView_i0a"
                label   "Debug View"
                type    string
                size    1
                default { "off" }
                menu { "off" "Lit" "unlit" "Unlit" "lightingOnly" "Lighting Only" "detailLighting" "Detail Lighting" "reflections" "Reflections" "lightComplexity" "Light Complexity" "buffer:BaseColor" "Buffer: Base Color" "buffer:Metallic" "Buffer: Metallic" "buffer:Roughness" "Buffer: Roughness" "buffer:Specular" "Buffer: Specular" "buffer:WorldNormal" "Buffer: World Normal" "buffer:SceneDepth" "Buffer: Scene Depth" "buffer:ShadingModel" "Buffer: Shading Model" "nanite:Mask" "Nanite: Mask" "nanite:Triangles" "Nanite: Triangles" "nanite:Clusters" "Nanite: Clusters" "nanite:Primitives" "Nanite: Primitives" "nanite:Instances" "Nanite: Instances" "nanite:Overdraw" "Nanite: Overdraw" "lumen:Overview" "Lumen: Overview" "lumen:LumenScene" "Lumen: Lumen Scene" "lumen:SurfaceCache" "Lumen: Surface Cache" "lumen:GeometryNormals" "Lumen: Geometry Normals" "lumen:ReflectionView" "Lumen: Reflection View" "vsm:mip" "Virtual Shadow Map: Mip Level" "vsm:vpage" "Virtual Shadow Map: Virtual Page" "vsm:cache" "Virtual Shadow Map: Cached Page" }
                help    "Renders one of UE's viewport view modes instead of the lit image, as its View Mode menu does: GBuffer channels, Nanite triangles and clusters, the Lumen scene and surface cache, Virtual Shadow Map pages (with Virtual Shadow Maps on). Nanite views show Nanite meshes: the viewport's, and native Nanite assets. Buffer views are linear data; the others are display-referred, like the Unreal Tonemapper's output. Realtime beauty only: AOVs are unaffected."
                parmtag { "spare_category" "Rendering" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealdebugView_control_jeb == block } { xn__unrealdebugView_control_jeb == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Rendering_Geometry"
            label "Geometry"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            HDUE_CONTROL("xn__unrealsubdivisionLevel_control_xpb", "Subdivision Level")
            parm {
                name    "xn__unrealsubdivisionLevel_wcb"
                label   "Subdivision Level"
                type    int
                size    1
                default { 0 }
                range   { 0! 5 }
                help    "Uniform refinement of catmullClark and loop meshes; each level has 4x the faces. 0, UE's USD Stage default, renders the cage; 3 matches Karma's surfaces closely."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealsubdivisionLevel_control_xpb == block } { xn__unrealsubdivisionLevel_control_xpb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealrequireNanite_control_1kb", "Require Nanite")
            parm {
                name    "xn__unrealrequireNanite_06a"
                label   "Require Nanite"
                type    toggle
                size    1
                default { 0 }
                help    "Meshes from the native asset catalog must render with Nanite (their cooked asset needs Nanite data). Meshes built from Hydra are unaffected."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealrequireNanite_control_1kb == block } { xn__unrealrequireNanite_control_1kb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealcullBackface_control_fjb", "Cull Backface")
            parm {
                name    "xn__unrealcullBackface_e5a"
                label   "Cull Backface"
                type    toggle
                size    1
                default { 1 }
                help    "Meshes whose USD doubleSided is off render their front faces only, as UE's USD importer does. Off, every mesh renders both sides, as in Karma."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealcullBackface_control_fjb == block } { xn__unrealcullBackface_control_fjb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealupAxis_control_n8a", "Stage Up Axis")
            parm {
                name    "xn__unrealupAxis_mva"
                label   "Stage Up Axis"
                type    string
                size    1
                default { "Y" }
                menu { "Y" "Y" "Z" "Z" }
                help    "Overrides the stage's upAxis metadata."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealupAxis_control_n8a == block } { xn__unrealupAxis_control_n8a == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Rendering_Materials"
            label "Materials"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            HDUE_CONTROL("xn__unrealmaterialxLibrary_control_xpb", "Cooked MaterialX Library")
            parm {
                name    "xn__unrealmaterialxLibrary_wcb"
                label   "Cooked MaterialX Library"
                type    file
                size    1
                default { "" }
                help    "library.json of MaterialX materials cooked to UE materials (scripts/Import-MaterialX.ps1). Unset: the runtime profile's materialx_library. Houdini's viewport prepares the bound MaterialX materials from it; husk renders the Preview Surface fallback and warns."
                parmtag { "spare_category" "Materials" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.json" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__unrealmaterialxLibrary_control_xpb == block } { xn__unrealmaterialxLibrary_control_xpb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealsubstrateLibrary_control_xpb", "Prepared Substrate Library")
            parm {
                name    "xn__unrealsubstrateLibrary_wcb"
                label   "Prepared Substrate Library"
                type    file
                size    1
                default { "" }
                help    "library.json of prepared Substrate materials (scripts/Prepare-Substrate.ps1). Unset: the runtime profile's substrate_library. Houdini's viewport prepares Substrate Builder materials from it; husk renders the Preview Surface fallback and warns."
                parmtag { "spare_category" "Materials" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.json" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__unrealsubstrateLibrary_control_xpb == block } { xn__unrealsubstrateLibrary_control_xpb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }
    }

    group {
        name "hdUE_Lens_Tab"
        label "Lens"

        groupcollapsible {
            name "hdUE_Lens_Bloom"
            label "Bloom"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessBloomMethod_control_pzbl", "Preferred Method")
            parm {
                name    "xn__unrealpostProcessBloomMethod_ombl"
                label   "Preferred Method"
                type    string
                size    1
                default { "BM_SOG" }
                menu { "BM_SOG" "Standard" "BM_FFT" "Convolution" }
                help    "Preferred bloom algorithm. A different method may be used if the preferred method is not available on the target platform, e.g. due to performance limits."
                parmtag { "spare_category" "Lens|Bloom" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessBloomMethod_control_pzbl == block } { xn__unrealpostProcessBloomMethod_control_pzbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessBloomIntensity_control_l4bl", "Intensity")
            parm {
                name    "xn__unrealpostProcessBloomIntensity_krbl"
                label   "Intensity"
                type    float
                size    1
                default { 0.675 }
                range   { 0! 8 }
                help    "Multiplier for all bloom contributions >=0: off, 1(default), >1 brighter"
                parmtag { "spare_category" "Lens|Bloom" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessBloomIntensity_control_l4bl == block } { xn__unrealpostProcessBloomIntensity_control_l4bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }

            groupsimple {
