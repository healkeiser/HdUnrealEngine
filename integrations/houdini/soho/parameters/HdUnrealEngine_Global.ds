        groupcollapsible {
            name "hdUE_Lens_Camera"
            label "Camera"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__unrealpostProcessCameraShutterSpeed_control_3bcl", "Shutter Speed (1/s)")
            parm {
                name    "xn__unrealpostProcessCameraShutterSpeed_2xbl"
                label   "Shutter Speed (1/s)"
                type    float
                size    1
                default { 60 }
                range   { 0.01! 8000! }
                help    "The camera shutter in 1/seconds."
                parmtag { "spare_category" "Lens|Camera" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessCameraShutterSpeed_control_3bcl == block } { xn__unrealpostProcessCameraShutterSpeed_control_3bcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessCameraISO_control_gwbl", "ISO")
            parm {
                name    "xn__unrealpostProcessCameraISO_fjbl"
                label   "ISO"
                type    float
                size    1
                default { 100 }
                range   { 1! 11 }
                help    "The camera sensor sensitivity in ISO."
                parmtag { "spare_category" "Lens|Camera" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessCameraISO_control_gwbl == block } { xn__unrealpostProcessCameraISO_control_gwbl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldFstop_control_h9bl", "Aperture (F-stop)")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldFstop_gwbl"
                label   "Aperture (F-stop)"
                type    float
                size    1
                default { 4 }
                range   { 1! 32! }
                help    "Defines the opening of the camera lens, Aperture is 1/fstop, typical lens go down to f/1.2 (large opening), larger numbers reduce the DOF effect. Set from the USD camera (fStop, focusDistance, focalLength); this overrides it."
                parmtag { "spare_category" "Lens|Camera" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldFstop_control_h9bl == block } { xn__unrealpostProcessDepthOfFieldFstop_control_h9bl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldMinFstop_control_dfcl", "Maximum Aperture (min F-stop)")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldMinFstop_c1bl"
                label   "Maximum Aperture (min F-stop)"
                type    float
                size    1
                default { 1.2 }
                range   { 0! 32! }
                help    "Defines the maximum opening of the camera lens to control the curvature of blades of the diaphragm. Set it to 0 to get straight blades."
                parmtag { "spare_category" "Lens|Camera" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldMinFstop_control_dfcl == block } { xn__unrealpostProcessDepthOfFieldMinFstop_control_dfcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldBladeCount_control_micl", "Number of diaphragm blades")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldBladeCount_l4bl"
                label   "Number of diaphragm blades"
                type    int
                size    1
                default { 5 }
                range   { 4! 16! }
                help    "Defines the number of blades of the diaphragm within the lens (between 4 and 16)."
                parmtag { "spare_category" "Lens|Camera" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldBladeCount_control_micl == block } { xn__unrealpostProcessDepthOfFieldBladeCount_control_micl == none })"
            }
        }

        groupcollapsible {
            name "hdUE_Lens_LocalExposure"
            label "Local Exposure"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureMethod_control_qdcl", "Method")
            parm {
                name    "xn__unrealpostProcessLocalExposureMethod_pzbl"
                label   "Method"
                type    string
                size    1
                default { "ELocalExposureMethod::Bilateral" }
                menu { "ELocalExposureMethod::Bilateral" "Bilateral" "ELocalExposureMethod::Fusion" "Fusion (Experimental)" }
                help    "Local Exposure algorithm"
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureMethod_control_qdcl == block } { xn__unrealpostProcessLocalExposureMethod_control_qdcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureHighlightContrastScale_control_s3cl", "Highlight Contrast")
            parm {
                name    "xn__unrealpostProcessLocalExposureHighlightContrastScale_rqcl"
                label   "Highlight Contrast"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Contrast of the base layer is reduced based on this value. Value less than 1 will enable local exposure. Good values are usually in the range 0.6 .. 1.0."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureHighlightContrastScale_control_s3cl == block } { xn__unrealpostProcessLocalExposureHighlightContrastScale_control_s3cl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureShadowContrastScale_control_wycl", "Shadow Contrast")
            parm {
                name    "xn__unrealpostProcessLocalExposureShadowContrastScale_vlcl"
                label   "Shadow Contrast"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Contrast of the base layer is reduced based on this value. Value less than 1 will enable local exposure. Good values are usually in the range 0.6 .. 1.0."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureShadowContrastScale_control_wycl == block } { xn__unrealpostProcessLocalExposureShadowContrastScale_control_wycl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureHighlightContrastCurve_control_s3cl", "Highlight Contrast Curve")
            parm {
                name    "xn__unrealpostProcessLocalExposureHighlightContrastCurve_rqcl"
                label   "Highlight Contrast Curve"
                type    string
                size    1
                default { "" }
                help    "Local Exposure Highlight Contrast based on the scene EV100. Used to calibrate Local Exposure differently depending on the average scene luminance. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureHighlightContrastCurve_control_s3cl == block } { xn__unrealpostProcessLocalExposureHighlightContrastCurve_control_s3cl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureShadowContrastCurve_control_wycl", "Shadow Contrast Curve")
            parm {
                name    "xn__unrealpostProcessLocalExposureShadowContrastCurve_vlcl"
                label   "Shadow Contrast Curve"
                type    string
                size    1
                default { "" }
                help    "Local Exposure Shadow Contrast based on the scene EV100. Used to calibrate Local Exposure differently depending on the average scene luminance. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureShadowContrastCurve_control_wycl == block } { xn__unrealpostProcessLocalExposureShadowContrastCurve_control_wycl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureHighlightThreshold_control_9wcl", "Highlight Threshold")
            parm {
                name    "xn__unrealpostProcessLocalExposureHighlightThreshold_8jcl"
                label   "Highlight Threshold"
                type    float
                size    1
                default { 0 }
                range   { 0 4 }
                help    "Threshold used to determine which regions of the screen are considered highlights."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureHighlightThreshold_control_9wcl == block } { xn__unrealpostProcessLocalExposureHighlightThreshold_control_9wcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureShadowThreshold_control_escl", "Shadow Threshold")
            parm {
                name    "xn__unrealpostProcessLocalExposureShadowThreshold_dfcl"
                label   "Shadow Threshold"
                type    float
                size    1
                default { 0 }
                range   { 0 4 }
                help    "Threshold used to determine which regions of the screen are considered shadows."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureShadowThreshold_control_escl == block } { xn__unrealpostProcessLocalExposureShadowThreshold_control_escl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureDetailStrength_control_rqcl", "Detail Strength")
            parm {
                name    "xn__unrealpostProcessLocalExposureDetailStrength_qdcl"
                label   "Detail Strength"
                type    float
                size    1
                default { 1 }
                range   { 0 4 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Value different than 1 will enable local exposure. This value should be set to 1 in most cases."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureDetailStrength_control_rqcl == block } { xn__unrealpostProcessLocalExposureDetailStrength_control_rqcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureBlurredLuminanceBlend_control_51cl", "Blurred Luminance Blend")
            parm {
                name    "xn__unrealpostProcessLocalExposureBlurredLuminanceBlend_4ocl"
                label   "Blurred Luminance Blend"
                type    float
                size    1
                default { 0.6 }
                range   { 0 1 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Blend between bilateral filtered and blurred luminance as the base layer. Blurred luminance helps preserve image appearance and specular highlights, and reduce ringing. Good values are usually in the range 0.4 .. 0.6"
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureBlurredLuminanceBlend_control_51cl == block } { xn__unrealpostProcessLocalExposureBlurredLuminanceBlend_control_51cl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureBlurredLuminanceKernelSizePercent_control_pmdl", "Blurred Luminance Kernel Size Percent")
            parm {
                name    "xn__unrealpostProcessLocalExposureBlurredLuminanceKernelSizePercent_o8cl"
                label   "Blurred Luminance Kernel Size Percent"
                type    float
                size    1
                default { 50 }
                range   { 0 100 }
                help    "Kernel size (percentage of screen) used to blur frame luminance."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureBlurredLuminanceKernelSizePercent_control_pmdl == block } { xn__unrealpostProcessLocalExposureBlurredLuminanceKernelSizePercent_control_pmdl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureHighlightThresholdStrength_control_bbdl", "Highlight Threshold Strength")
            parm {
                name    "xn__unrealpostProcessLocalExposureHighlightThresholdStrength_9wcl"
                label   "Highlight Threshold Strength"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Strength of the highlight threshold."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureHighlightThresholdStrength_control_bbdl == block } { xn__unrealpostProcessLocalExposureHighlightThresholdStrength_control_bbdl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureShadowThresholdStrength_control_f5cl", "Shadow Threshold Strength")
            parm {
                name    "xn__unrealpostProcessLocalExposureShadowThresholdStrength_escl"
                label   "Shadow Threshold Strength"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Strength of the shadow threshold."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLocalExposureShadowThresholdStrength_control_f5cl == block } { xn__unrealpostProcessLocalExposureShadowThresholdStrength_control_f5cl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLocalExposureMiddleGreyBias_control_rqcl", "Middle Grey Bias")
            parm {
                name    "xn__unrealpostProcessLocalExposureMiddleGreyBias_qdcl"
                label   "Middle Grey Bias"
                type    float
                size    1
                default { 0 }
                range   { -15 15 }
                help    "Logarithmic adjustment for the local exposure middle grey. 0: no adjustment, -1:2x darker, -2:4x darker, 1:2x brighter, 2:4x brighter, ..."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
