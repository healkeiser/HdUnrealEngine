                parmtag { "spare_category" "Lens|Image Effects" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessVignetteSoftness_control_u7bl == block } { xn__unrealpostProcessVignetteSoftness_control_u7bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessVignetteTexture_control_75bl", "Vignette Texture")
            parm {
                name    "xn__unrealpostProcessVignetteTexture_6sbl"
                label   "Vignette Texture"
                type    file
                size    1
                default { "" }
                help    "Defines the shape of the vignette when VignetteType is set to Texture. An image file, imported at render time, or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Image Effects" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                parmtag { "usdvaluetype" "asset" }
                disablewhen R"({ xn__unrealpostProcessVignetteTexture_control_75bl == block } { xn__unrealpostProcessVignetteTexture_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Lens_DepthofField"
            label "Depth of Field"
            grouptag { "group_default" "0" }
            grouptag { "sidefx::header_toggle" "xn__unrealpostProcessDepthOfFieldEnabled_pzbl" }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldEnabled_control_qdcl", "Enabled")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldEnabled_pzbl"
                label   "Enabled"
                type    toggle
                size    1
                default { 1 }
                help    "When false, post-process depth of field will not be used. When true, DoF may be used depending on lens and scalability settings."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldEnabled_control_qdcl == block } { xn__unrealpostProcessDepthOfFieldEnabled_control_qdcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldSensorWidth_control_8jcl", "Sensor Width (mm)")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldSensorWidth_75bl"
                label   "Sensor Width (mm)"
                type    float
                size    1
                default { 24.576 }
                range   { 0.1! 1000 }
                help    "Width of the camera sensor to assume, in mm. Set from the USD camera (fStop, focusDistance, focalLength); this overrides it."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldSensorWidth_control_8jcl == block } { xn__unrealpostProcessDepthOfFieldSensorWidth_control_8jcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldSqueezeFactor_control_incl", "Squeeze Factor")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldSqueezeFactor_h9bl"
                label   "Squeeze Factor"
                type    float
                size    1
                default { 1 }
                range   { 1! 2! }
                help    "This is the squeeze factor for the DOF, which emulates the properties of anamorphic lenses. Set from the USD camera (fStop, focusDistance, focalLength); this overrides it."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldSqueezeFactor_control_incl == block } { xn__unrealpostProcessDepthOfFieldSqueezeFactor_control_incl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldFocalDistance_control_incl", "Focal Distance")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldFocalDistance_h9bl"
                label   "Focal Distance"
                type    float
                size    1
                default { 0 }
                range   { 0! 10000 }
                help    "Distance in which the Depth of Field effect should be sharp, in unreal units (cm). Set from the USD camera (fStop, focusDistance, focalLength); this overrides it."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldFocalDistance_control_incl == block } { xn__unrealpostProcessDepthOfFieldFocalDistance_control_incl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldDepthBlurAmount_control_rqcl", "Depth Blur km for 50%")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldDepthBlurAmount_qdcl"
                label   "Depth Blur km for 50%"
                type    float
                size    1
                default { 1 }
                range   { 1e-06! 100! }
                help    "CircleDOF only: Depth blur km for 50%"
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldDepthBlurAmount_control_rqcl == block } { xn__unrealpostProcessDepthOfFieldDepthBlurAmount_control_rqcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldDepthBlurRadius_control_rqcl", "Depth Blur Radius")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldDepthBlurRadius_qdcl"
                label   "Depth Blur Radius"
                type    float
                size    1
                default { 0 }
                range   { 0! 4 }
                help    "CircleDOF only: Depth blur radius in pixels at 1920x"
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldDepthBlurRadius_control_rqcl == block } { xn__unrealpostProcessDepthOfFieldDepthBlurRadius_control_rqcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldPetzvalBokeh_control_vlcl", "Petzval Bokeh")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldPetzvalBokeh_u7bl"
                label   "Petzval Bokeh"
                type    float
                size    1
                default { 0 }
                range   { -10! 10! }
                help    "Simulate stretching in blur and bokeh. Positive values for sagittal (swirly bokeh), negative values for tangential."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldPetzvalBokeh_control_vlcl == block } { xn__unrealpostProcessDepthOfFieldPetzvalBokeh_control_vlcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldPetzvalBokehFalloff_control_9wcl", "Petzval Bokeh Falloff")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldPetzvalBokehFalloff_8jcl"
                label   "Petzval Bokeh Falloff"
                type    float
                size    1
                default { 1 }
                range   { 0! 10 }
                help    "How quickly does the Petzval bokeh effect increase towards the edge of the image"
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldPetzvalBokehFalloff_control_9wcl == block } { xn__unrealpostProcessDepthOfFieldPetzvalBokehFalloff_control_9wcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxExtents_control_o8cl", "Petzval Bokeh Exclusion Box")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxExtents_nvcl"
                label   "Petzval Bokeh Exclusion Box"
                type    float
                size    2
                default { 0 0 }
                range   { 0! 1! }
                help    "Box, centered on screen, around which the Petzval effect is applied."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float2" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxExtents_control_o8cl == block } { xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxExtents_control_o8cl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxRadius_control_16cl", "Petzval Bokeh Exclusion Box Radius")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxRadius_0tcl"
                label   "Petzval Bokeh Exclusion Box Radius"
                type    float
                size    1
                default { 0 }
                range   { 0! 1! }
                help    "Corner radius"
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxRadius_control_16cl == block } { xn__unrealpostProcessDepthOfFieldPetzvalExclusionBoxRadius_control_16cl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldAspectRatioScalar_control_0tcl", "Aspect Ratio Scalar")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldAspectRatioScalar_zgcl"
                label   "Aspect Ratio Scalar"
                type    float
                size    1
                default { 1 }
                range   { 0! 10 }
                help    "Amount to scale the output viewport's aspect ratio by when computing depth of field properties."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldAspectRatioScalar_control_0tcl == block } { xn__unrealpostProcessDepthOfFieldAspectRatioScalar_control_0tcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldBarrelRadius_control_vlcl", "Barrel Radius")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldBarrelRadius_u7bl"
                label   "Barrel Radius"
                type    float
                size    1
                default { 5 }
                range   { 0! 100 }
                help    "The lens barrel creates vignetting and occludes bokeh, i.e. cat's eye bokeh"
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldBarrelRadius_control_vlcl == block } { xn__unrealpostProcessDepthOfFieldBarrelRadius_control_vlcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldBarrelLength_control_vlcl", "Barrel Length")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldBarrelLength_u7bl"
                label   "Barrel Length"
                type    float
                size    1
                default { 0 }
                range   { 0! 150 }
                help    "The lens barrel creates vignetting and occludes bokeh, i.e. cat's eye bokeh"
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldBarrelLength_control_vlcl == block } { xn__unrealpostProcessDepthOfFieldBarrelLength_control_vlcl == none })"
            }
            HDUE_CONTROL("xn__unrealpostProcessDepthOfFieldUseHairDepth_control_vlcl", "Use Hair Depth")
            parm {
                name    "xn__unrealpostProcessDepthOfFieldUseHairDepth_u7bl"
                label   "Use Hair Depth"
                type    toggle
                size    1
                default { 0 }
                help    "For depth of field to use the hair depth for computing circle of confusion size. Otherwise use an interpolated distance between the hair depth and the scene depth based on the hair coverage (default)."
                parmtag { "spare_category" "Lens|Depth of Field" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessDepthOfFieldUseHairDepth_control_vlcl == block } { xn__unrealpostProcessDepthOfFieldUseHairDepth_control_vlcl == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }
    }

    group {
        name "hdUE_ColorGrading_Tab"
        label "Color Grading"
        grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }

        groupcollapsible {
            name "hdUE_ColorGrading_Temperature"
            label "Temperature"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessTemperatureType_control_75bl", "Temperature Type")
            parm {
                name    "xn__unrealpostProcessTemperatureType_6sbl"
                label   "Temperature Type"
                type    string
                size    1
                default { "TEMP_WhiteBalance" }
                menu { "TEMP_WhiteBalance" "White Balance" "TEMP_ColorTemperature" "Color Temperature" }
                help    "Selects the type of temperature calculation. White Balance uses the Temperature value to control the virtual camera's White Balance. This is the default selection. Color Temperature uses the Temperature value to adjust the color temperature of the scene, which is the inverse of the White Balance operation."
                parmtag { "spare_category" "Color Grading|Temperature" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessTemperatureType_control_75bl == block } { xn__unrealpostProcessTemperatureType_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessWhiteTemp_control_gwbl", "Temp")
            parm {
                name    "xn__unrealpostProcessWhiteTemp_fjbl"
                label   "Temp"
                type    float
                size    1
                default { 6500 }
                range   { 1500 15000 }
                help    "Controls the color temperature or white balance in degrees Kelvin which the scene considers as white light."
                parmtag { "spare_category" "Color Grading|Temperature" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessWhiteTemp_control_gwbl == block } { xn__unrealpostProcessWhiteTemp_control_gwbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessWhiteTint_control_gwbl", "Tint")
            parm {
                name    "xn__unrealpostProcessWhiteTint_fjbl"
                label   "Tint"
                type    float
                size    1
                default { 0 }
                range   { -1 1 }
                help    "Controls the color of the scene along the magenta - green axis (orthogonal to the color temperature). This feature is equivalent to color tint in digital cameras."
                parmtag { "spare_category" "Color Grading|Temperature" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessWhiteTint_control_gwbl == block } { xn__unrealpostProcessWhiteTint_control_gwbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_ColorGrading_Global"
            label "Global"
            grouptag { "group_default" "1" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessColorSaturation_control_75bl", "Saturation")
            parm {
                name    "xn__unrealpostProcessColorSaturation_6sbl"
                label   "Saturation"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the intensity of the color(hue) for the entire image.Higher values will result in more vibrant colors."
                parmtag { "spare_category" "Color Grading|Global" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorSaturation_control_75bl == block } { xn__unrealpostProcessColorSaturation_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorContrast_control_y2bl", "Contrast")
            parm {
                name    "xn__unrealpostProcessColorContrast_xpbl"
                label   "Contrast"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the range of light and dark values in your scene. Lower values will reduce the difference between bright and dark areas while higher values will increase the difference between the bright and dark areas."
                parmtag { "spare_category" "Color Grading|Global" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorContrast_control_y2bl == block } { xn__unrealpostProcessColorContrast_control_y2bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGamma_control_2xbl", "Gamma")
            parm {
                name    "xn__unrealpostProcessColorGamma_1kbl"
                label   "Gamma"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the luminance curve of the scene. Raising or lowering this value will result brightening or darkening the mid-tones of the entire image."
                parmtag { "spare_category" "Color Grading|Global" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGamma_control_2xbl == block } { xn__unrealpostProcessColorGamma_control_2xbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGain_control_gwbl", "Gain")
            parm {
                name    "xn__unrealpostProcessColorGain_fjbl"
                label   "Gain"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "This value multiplies the colors of the image. Raising or lowering this value will result in brightening or darkening the entire scene."
                parmtag { "spare_category" "Color Grading|Global" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGain_control_gwbl == block } { xn__unrealpostProcessColorGain_control_gwbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorOffset_control_pzbl", "Offset")
            parm {
                name    "xn__unrealpostProcessColorOffset_ombl"
                label   "Offset"
                type    float
                size    4
                default { 0 0 0 0 }
                range   { -1 1 }
                help    "This value is added to the colors of the scene. Raising or lowering this value will result in the image being more or less washed-out."
                parmtag { "spare_category" "Color Grading|Global" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorOffset_control_pzbl == block } { xn__unrealpostProcessColorOffset_control_pzbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_ColorGrading_Shadows"
            label "Shadows"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessColorSaturationShadows_control_micl", "Saturation")
            parm {
                name    "xn__unrealpostProcessColorSaturationShadows_l4bl"
                label   "Saturation"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the intensity of the colors (hue) in the shadow region of the image. Higher values will result in more vibrant colors."
                parmtag { "spare_category" "Color Grading|Shadows" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorSaturationShadows_control_micl == block } { xn__unrealpostProcessColorSaturationShadows_control_micl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorContrastShadows_control_dfcl", "Contrast")
            parm {
                name    "xn__unrealpostProcessColorContrastShadows_c1bl"
                label   "Contrast"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the range of light and dark values in your scene. Lower values will reduce the difference between bright and dark areas while higher values will increase the difference between the bright and dark areas."
                parmtag { "spare_category" "Color Grading|Shadows" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorContrastShadows_control_dfcl == block } { xn__unrealpostProcessColorContrastShadows_control_dfcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGammaShadows_control_h9bl", "Gamma")
            parm {
                name    "xn__unrealpostProcessColorGammaShadows_gwbl"
                label   "Gamma"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the luminance curve of the shadow region. Raising or lowering this value will result brightening or darkening the mid-tones of the shadow region."
                parmtag { "spare_category" "Color Grading|Shadows" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGammaShadows_control_h9bl == block } { xn__unrealpostProcessColorGammaShadows_control_h9bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGainShadows_control_u7bl", "Gain")
            parm {
                name    "xn__unrealpostProcessColorGainShadows_tubl"
                label   "Gain"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "This value multiplies the colors in the shadow region. Raising or lowering this value will result in brightening or darkening the affected region."
                parmtag { "spare_category" "Color Grading|Shadows" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGainShadows_control_u7bl == block } { xn__unrealpostProcessColorGainShadows_control_u7bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorOffsetShadows_control_3bcl", "Offset")
            parm {
                name    "xn__unrealpostProcessColorOffsetShadows_2xbl"
                label   "Offset"
                type    float
                size    4
                default { 0 0 0 0 }
                range   { -1 1 }
                help    "This value is added to the colors in the shadow region. Raising or lowering this value will result in the shadows being more or less washed-out."
                parmtag { "spare_category" "Color Grading|Shadows" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorOffsetShadows_control_3bcl == block } { xn__unrealpostProcessColorOffsetShadows_control_3bcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorCorrectionShadowsMax_control_incl", "ShadowsMax")
            parm {
                name    "xn__unrealpostProcessColorCorrectionShadowsMax_h9bl"
                label   "ShadowsMax"
                type    float
                size    1
                default { 0.09 }
                range   { -1 1 }
                help    "This value sets the threshold for what is considered to be the shadow region of the image."
                parmtag { "spare_category" "Color Grading|Shadows" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessColorCorrectionShadowsMax_control_incl == block } { xn__unrealpostProcessColorCorrectionShadowsMax_control_incl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_ColorGrading_Midtones"
            label "Midtones"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessColorSaturationMidtones_control_8jcl", "Saturation")
            parm {
                name    "xn__unrealpostProcessColorSaturationMidtones_75bl"
                label   "Saturation"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the intensity of the colors (hue) in the mid-tone region of the image. Higher values will result in more vibrant colors."
                parmtag { "spare_category" "Color Grading|Midtones" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorSaturationMidtones_control_8jcl == block } { xn__unrealpostProcessColorSaturationMidtones_control_8jcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorContrastMidtones_control_zgcl", "Contrast")
            parm {
                name    "xn__unrealpostProcessColorContrastMidtones_y2bl"
                label   "Contrast"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the range of light and dark values in the mid-tone region. Lower values will reduce the difference between bright and dark areas while higher values will increase the difference between the bright and dark areas."
                parmtag { "spare_category" "Color Grading|Midtones" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorContrastMidtones_control_zgcl == block } { xn__unrealpostProcessColorContrastMidtones_control_zgcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGammaMidtones_control_3bcl", "Gamma")
            parm {
                name    "xn__unrealpostProcessColorGammaMidtones_2xbl"
                label   "Gamma"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the luminance curve of the mid-tone region of the image. Raising or lowering this value will result brightening or darkening the mid-tones of the image."
                parmtag { "spare_category" "Color Grading|Midtones" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGammaMidtones_control_3bcl == block } { xn__unrealpostProcessColorGammaMidtones_control_3bcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGainMidtones_control_h9bl", "Gain")
            parm {
                name    "xn__unrealpostProcessColorGainMidtones_gwbl"
                label   "Gain"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "This value multiplies the colors in the mid-tone region of the image. Raising or lowering this value will result in brightening or darkening the affected region."
                parmtag { "spare_category" "Color Grading|Midtones" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGainMidtones_control_h9bl == block } { xn__unrealpostProcessColorGainMidtones_control_h9bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorOffsetMidtones_control_qdcl", "Offset")
            parm {
                name    "xn__unrealpostProcessColorOffsetMidtones_pzbl"
                label   "Offset"
                type    float
                size    4
                default { 0 0 0 0 }
                range   { -1 1 }
                help    "This value is added to the colors in the mid-tone region of the image. Raising or lowering this value will result in the mid-tones being more or less washed-out."
                parmtag { "spare_category" "Color Grading|Midtones" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorOffsetMidtones_control_qdcl == block } { xn__unrealpostProcessColorOffsetMidtones_control_qdcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
