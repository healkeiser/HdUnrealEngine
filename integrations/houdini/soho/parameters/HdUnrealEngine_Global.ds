                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLensFlareBokehSize_control_3bcl", "BokehSize")
            parm {
                name    "xn__unrealpostProcessLensFlareBokehSize_2xbl"
                label   "BokehSize"
                type    float
                size    1
                default { 3 }
                range   { 0 32 }
                help    "Size of the Lens Blur (in percent of the view width) that is done with the Bokeh texture (note: performance cost is radius*radius)"
                parmtag { "spare_category" "Lens|Lens Flares" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLensFlareBokehSize_control_3bcl == block } { xn__unrealpostProcessLensFlareBokehSize_control_3bcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLensFlareThreshold_control_3bcl", "Threshold")
            parm {
                name    "xn__unrealpostProcessLensFlareThreshold_2xbl"
                label   "Threshold"
                type    float
                size    1
                default { 8 }
                range   { 0.1 32 }
                help    "Minimum brightness the lens flare starts having effect (this should be as high as possible to avoid the performance cost of blurring content that is too dark too see)"
                parmtag { "spare_category" "Lens|Lens Flares" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessLensFlareThreshold_control_3bcl == block } { xn__unrealpostProcessLensFlareThreshold_control_3bcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessLensFlareBokehShape_control_qdcl", "BokehShape")
            parm {
                name    "xn__unrealpostProcessLensFlareBokehShape_pzbl"
                label   "BokehShape"
                type    file
                size    1
                default { "" }
                help    "Defines the shape of the Bokeh when the image base lens flares are blurred, cannot be blended. An image file, imported at render time, or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Lens Flares" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                parmtag { "usdvaluetype" "asset" }
                disablewhen R"({ xn__unrealpostProcessLensFlareBokehShape_control_qdcl == block } { xn__unrealpostProcessLensFlareBokehShape_control_qdcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

