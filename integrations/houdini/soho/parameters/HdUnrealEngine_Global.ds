            parm {
                name    "xn__unrealpostProcessColorContrastHighlights_75bl"
                label   "Contrast"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the range of light and dark values in the highlights region. Lower values will reduce the difference between bright and dark areas while higher values will increase the difference between the bright and dark areas."
                parmtag { "spare_category" "Color Grading|Highlights" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorContrastHighlights_control_8jcl == block } { xn__unrealpostProcessColorContrastHighlights_control_8jcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGammaHighlights_control_dfcl", "Gamma")
            parm {
                name    "xn__unrealpostProcessColorGammaHighlights_c1bl"
                label   "Gamma"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "Control the luminance curve of the highlight region. Raising or lowering this value will result brightening or darkening the mid-tones of the highlight region."
                parmtag { "spare_category" "Color Grading|Highlights" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGammaHighlights_control_dfcl == block } { xn__unrealpostProcessColorGammaHighlights_control_dfcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGainHighlights_control_qdcl", "Gain")
            parm {
                name    "xn__unrealpostProcessColorGainHighlights_pzbl"
                label   "Gain"
                type    float
                size    4
                default { 1 1 1 1 }
                range   { 0 2 }
                help    "This value multiplies the colors in the highlight region. Raising or lowering this value will result in brightening or darkening the affected region."
                parmtag { "spare_category" "Color Grading|Highlights" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorGainHighlights_control_qdcl == block } { xn__unrealpostProcessColorGainHighlights_control_qdcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorOffsetHighlights_control_zgcl", "Offset")
            parm {
                name    "xn__unrealpostProcessColorOffsetHighlights_y2bl"
                label   "Offset"
                type    float
                size    4
                default { 0 0 0 0 }
                range   { -1 1 }
                help    "This value is added to the colors in the highlight region. Raising or lowering this value will result in the highlights being more or less washed-out."
                parmtag { "spare_category" "Color Grading|Highlights" }
                parmtag { "usdvaluetype" "float4" }
                disablewhen R"({ xn__unrealpostProcessColorOffsetHighlights_control_zgcl == block } { xn__unrealpostProcessColorOffsetHighlights_control_zgcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
