                    disablewhen R"({ xn__unrealpostProcessBloomGaussianIntensity_control_micl == block } { xn__unrealpostProcessBloomGaussianIntensity_control_micl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomThreshold_control_l4bl", "Threshold")
                parm {
                    name    "xn__unrealpostProcessBloomThreshold_krbl"
                    label   "Threshold"
                    type    float
                    size    1
                    default { -1 }
                    range   { -1! 8 }
                    help    "minimum brightness the bloom starts having effect -1:all pixels affect bloom equally (physically correct, faster as a threshold pass is omitted), 0:all pixels affect bloom brights more, 1(default), >1 brighter"
                    parmtag { "spare_category" "Lens|Bloom|Gaussian" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessBloomThreshold_control_l4bl == block } { xn__unrealpostProcessBloomThreshold_control_l4bl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomSizeScale_control_l4bl", "Size scale")
                parm {
                    name    "xn__unrealpostProcessBloomSizeScale_krbl"
