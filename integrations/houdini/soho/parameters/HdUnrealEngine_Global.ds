        groupcollapsible {
            name "hdUE_ColorGrading_Misc"
            label "Misc"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessBlueCorrection_control_l4bl", "Blue Correction")
            parm {
                name    "xn__unrealpostProcessBlueCorrection_krbl"
                label   "Blue Correction"
                type    float
                size    1
                default { 0.6 }
                range   { 0! 1! }
                help    "Correct for artifacts with \"electric\" blues due to the ACEScg color space. Bright blue desaturates instead of going to violet."
                parmtag { "spare_category" "Color Grading|Misc" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessBlueCorrection_control_l4bl == block } { xn__unrealpostProcessBlueCorrection_control_l4bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessExpandGamut_control_pzbl", "Expand Gamut")
            parm {
                name    "xn__unrealpostProcessExpandGamut_ombl"
                label   "Expand Gamut"
                type    float
                size    1
                default { 1 }
                range   { 0! 1 }
                help    "Expand bright saturated colors outside the sRGB gamut to fake wide gamut rendering."
                parmtag { "spare_category" "Color Grading|Misc" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessExpandGamut_control_pzbl == block } { xn__unrealpostProcessExpandGamut_control_pzbl == none } { xn__unrealtonemapper_41a == 0 })"
