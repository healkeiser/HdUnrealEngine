                disablewhen R"({ xn__unrealpostProcessSceneColorTint_control_l4bl == block } { xn__unrealpostProcessSceneColorTint_control_l4bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGradingIntensity_control_zgcl", "Color Grading LUT Intensity")
            parm {
                name    "xn__unrealpostProcessColorGradingIntensity_y2bl"
                label   "Color Grading LUT Intensity"
                type    float
                size    1
                default { 1 }
                range   { 0! 1! }
                help    "Color grading lookup table intensity. 0 = no intensity, 1=full intensity"
                parmtag { "spare_category" "Color Grading|Misc" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessColorGradingIntensity_control_zgcl == block } { xn__unrealpostProcessColorGradingIntensity_control_zgcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessColorGradingLUT_control_75bl", "Color Grading LUT")
            parm {
                name    "xn__unrealpostProcessColorGradingLUT_6sbl"
                label   "Color Grading LUT"
                type    file
                size    1
                default { "" }
                help    "Look up table texture to use or none of not used. An image file, imported at render time, or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Color Grading|Misc" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                parmtag { "usdvaluetype" "asset" }
                disablewhen R"({ xn__unrealpostProcessColorGradingLUT_control_75bl == block } { xn__unrealpostProcessColorGradingLUT_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_ColorGrading_Film"
            label "Film"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessTonemappingMethod_control_h9bl", "Method")
            parm {
                name    "xn__unrealpostProcessTonemappingMethod_gwbl"
                label   "Method"
                type    string
                size    1
                default { "ETonemappingMethod::Filmic" }
                menu { "ETonemappingMethod::Filmic" "Filmic" "ETonemappingMethod::StandardACES" "Standard ACES" }
                help    "Controls the method of tonemapping."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessTonemappingMethod_control_h9bl == block } { xn__unrealpostProcessTonemappingMethod_control_h9bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmSlope_control_gwbl", "Slope")
            parm {
                name    "xn__unrealpostProcessFilmSlope_fjbl"
                label   "Slope"
                type    float
                size    1
                default { 0.88 }
                range   { 0 1 }
                help    "Controls the overall steepness of the tonemapper curve. Larger values increase scene contrast and smaller values reduce contrast."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmSlope_control_gwbl == block } { xn__unrealpostProcessFilmSlope_control_gwbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmToe_control_6sbl", "Toe")
            parm {
                name    "xn__unrealpostProcessFilmToe_5fbl"
                label   "Toe"
                type    float
                size    1
                default { 0.55 }
                range   { 0 1 }
                help    "Controls the contrast of the dark end of the tonemapper curve. Larger values increase contrast and smaller values decrease contrast."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmToe_control_6sbl == block } { xn__unrealpostProcessFilmToe_control_6sbl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmShoulder_control_c1bl", "Shoulder")
            parm {
                name    "xn__unrealpostProcessFilmShoulder_bobl"
                label   "Shoulder"
                type    float
                size    1
                default { 0.26 }
                range   { 0 1 }
                help    "Sometimes referred to as highlight rolloff. Controls the contrast of the bright end of the tonemapper curve. Larger values increase contrast and smaller values decrease contrast."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmShoulder_control_c1bl == block } { xn__unrealpostProcessFilmShoulder_control_c1bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmBlackClip_control_y2bl", "Black clip")
            parm {
                name    "xn__unrealpostProcessFilmBlackClip_xpbl"
                label   "Black clip"
                type    float
                size    1
                default { 0 }
                range   { 0 1 }
                help    "Lowers the toe of the tonemapper curve by this amount. Increasing this value causes more of the scene to clip to black. For most purposes, this property should remain 0"
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmBlackClip_control_y2bl == block } { xn__unrealpostProcessFilmBlackClip_control_y2bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmWhiteClip_control_y2bl", "White clip")
            parm {
                name    "xn__unrealpostProcessFilmWhiteClip_xpbl"
                label   "White clip"
                type    float
                size    1
                default { 0.04 }
                range   { 0 1 }
                help    "Controls the height of the tonemapper curve. Raising this value can cause bright values to more quickly approach fully-saturated white."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmWhiteClip_control_y2bl == block } { xn__unrealpostProcessFilmWhiteClip_control_y2bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

