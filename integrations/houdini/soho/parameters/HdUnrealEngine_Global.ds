                disablewhen R"({ xn__unrealpostProcessRayTracingTranslucencyRefraction_control_wycl == block } { xn__unrealpostProcessRayTracingTranslucencyRefraction_control_wycl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime } { xn__unrealpostProcessTranslucencyType_tubl != \"ETranslucencyType::RayTraced_Deprecated\" }"
            }
            parm {
                name    "xn__unrealpostProcessRayTracingTranslucencyUseRayTracedRefraction_control_gjdl"
                label   "Use Ray Traced Refraction"
                type    string
                default { "none" }
                menujoin {
                    [ "import loputils" ]
                    [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ]
                    [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ]
                    language python
                }
                help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's."
                parmtag { "sidefx::look" "icon" }
                hidewhen "{ xn__unrealrenderMode_41a != realtime } { xn__unrealpostProcessTranslucencyType_tubl != \"ETranslucencyType::RayTraced\" }"
            }
            parm {
                name    "xn__unrealpostProcessRayTracingTranslucencyUseRayTracedRefraction_f5cl"
                label   "Use Ray Traced Refraction"
                type    toggle
                size    1
                default { 0 }
                help    "Whether to use ray traced refraction which currently doesn't work well with rough refraction or simulate it using a screen space effect"
                parmtag { "spare_category" "Rendering Features|Translucency" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessRayTracingTranslucencyUseRayTracedRefraction_control_gjdl == block } { xn__unrealpostProcessRayTracingTranslucencyUseRayTracedRefraction_control_gjdl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime } { xn__unrealpostProcessTranslucencyType_tubl != \"ETranslucencyType::RayTraced\" }"
            }
        }
    }

