                help    "Control over the grain intensity in the mid-tone region of the image."
                parmtag { "spare_category" "Film Grain" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainIntensityMidtones_control_4ocl == block } { xn__unrealpostProcessFilmGrainIntensityMidtones_control_4ocl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmGrainIntensityHighlights_control_escl", "Film Grain Intensity Highlights")
            parm {
                name    "xn__unrealpostProcessFilmGrainIntensityHighlights_dfcl"
                label   "Film Grain Intensity Highlights"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Control over the grain intensity in the regions of the image considered highlight areas."
                parmtag { "spare_category" "Film Grain" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainIntensityHighlights_control_escl == block } { xn__unrealpostProcessFilmGrainIntensityHighlights_control_escl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmGrainShadowsMax_control_qdcl", "Film Grain Shadows Max")
            parm {
                name    "xn__unrealpostProcessFilmGrainShadowsMax_pzbl"
                label   "Film Grain Shadows Max"
                type    float
                size    1
                default { 0.09 }
                range   { 0 1 }
                help    "Sets the upper bound used for Film Grain Shadow Intensity."
                parmtag { "spare_category" "Film Grain" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainShadowsMax_control_qdcl == block } { xn__unrealpostProcessFilmGrainShadowsMax_control_qdcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmGrainHighlightsMin_control_micl", "Film Grain Highlights Min")
            parm {
                name    "xn__unrealpostProcessFilmGrainHighlightsMin_l4bl"
                label   "Film Grain Highlights Min"
                type    float
                size    1
                default { 0.5 }
                range   { 0 1 }
                help    "Sets the lower bound used for Film Grain Highlight Intensity."
                parmtag { "spare_category" "Film Grain" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainHighlightsMin_control_micl == block } { xn__unrealpostProcessFilmGrainHighlightsMin_control_micl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmGrainHighlightsMax_control_micl", "Film Grain Highlights Max")
            parm {
                name    "xn__unrealpostProcessFilmGrainHighlightsMax_l4bl"
                label   "Film Grain Highlights Max"
                type    float
                size    1
                default { 1 }
                range   { 1 10 }
                help    "Sets the upper bound used for Film Grain Highlight Intensity. This value should be larger than HighlightsMin.. Default is 1.0, for backwards compatibility"
                parmtag { "spare_category" "Film Grain" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainHighlightsMax_control_micl == block } { xn__unrealpostProcessFilmGrainHighlightsMax_control_micl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmGrainScale_control_l4bl", "Film Grain Scale")
            parm {
                name    "xn__unrealpostProcessFilmGrainScale_krbl"
                label   "Film Grain Scale"
                type    float
                size    2
                default { 1 1 }
                range   { 0 4 }
                help    "Controls the size of the film grain. Size of texel of FilmGrainTexture on screen."
                parmtag { "spare_category" "Film Grain" }
                parmtag { "usdvaluetype" "float2" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainScale_control_l4bl == block } { xn__unrealpostProcessFilmGrainScale_control_l4bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessFilmGrainTexture_control_u7bl", "Film Grain Texture")
            parm {
                name    "xn__unrealpostProcessFilmGrainTexture_tubl"
                label   "Film Grain Texture"
                type    file
                size    1
                default { "" }
                help    "Defines film grain texture to use. An image file, imported at render time, or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Film Grain" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                parmtag { "usdvaluetype" "asset" }
                disablewhen R"({ xn__unrealpostProcessFilmGrainTexture_control_u7bl == block } { xn__unrealpostProcessFilmGrainTexture_control_u7bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }
    }

    group {
        name "hdUE_Lighting_Tab"
        label "Lighting"
        grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealrenderMode_41a != realtime }" }

        groupcollapsible {
            name "hdUE_Lighting_GlobalIllumination"
            label "Global Illumination"
            grouptag { "group_default" "1" }
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            HDUE_CONTROL_HIDE("xn__unreallumenEnabled_control_fjb", "Lumen", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unreallumenEnabled_e5a"
                label   "Lumen"
                type    toggle
                size    1
                default { 1 }
                help    "Lumen global illumination and reflections in realtime mode. Per-light MegaLights is on the lights' Unreal Engine tab."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unreallumenEnabled_control_fjb == block } { xn__unreallumenEnabled_control_fjb == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessDynamicGlobalIlluminationMethod_control_9wcl", "Method", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessDynamicGlobalIlluminationMethod_8jcl"
                label   "Method"
                type    string
                size    1
                default { "EDynamicGlobalIlluminationMethod::Lumen" }
                menu { "EDynamicGlobalIlluminationMethod::None" "None" "EDynamicGlobalIlluminationMethod::Lumen" "Lumen" "EDynamicGlobalIlluminationMethod::ScreenSpace" "Screen Space (Deprecated)" "EDynamicGlobalIlluminationMethod::Plugin" "Plugin" }
                help    "Chooses the Dynamic Global Illumination method. Not compatible with Forward Shading. Overrides unreal:lumenEnabled."
                parmtag { "spare_category" "Global Illumination" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessDynamicGlobalIlluminationMethod_control_9wcl == block } { xn__unrealpostProcessDynamicGlobalIlluminationMethod_control_9wcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessIndirectLightingColor_control_zgcl", "Indirect Lighting Color", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessIndirectLightingColor_y2bl"
                label   "Indirect Lighting Color"
                type    color
                size    3
                default { 1 1 1 }
                help    "Adjusts indirect lighting color. (1,1,1) is default. (0,0,0) to disable GI. The show flag 'Global Illumination' must be enabled to use this property."
                parmtag { "spare_category" "Global Illumination" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealpostProcessIndirectLightingColor_control_zgcl == block } { xn__unrealpostProcessIndirectLightingColor_control_zgcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessIndirectLightingIntensity_control_incl", "Indirect Lighting Intensity", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessIndirectLightingIntensity_h9bl"
                label   "Indirect Lighting Intensity"
                type    float
                size    1
                default { 1 }
                range   { 0! 4 }
                help    "Scales the indirect lighting contribution. A value of 0 disables GI. Default is 1. The show flag 'Global Illumination' must be enabled to use this property."
                parmtag { "spare_category" "Global Illumination" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessIndirectLightingIntensity_control_incl == block } { xn__unrealpostProcessIndirectLightingIntensity_control_incl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }

            groupsimple {
                name "hdUE_Lighting_GlobalIllumination_LumenGlobalIllumination"
                label "Lumen Global Illumination"
                hidewhentab "{ xn__unrealrenderMode_41a != realtime } { xn__unrealpostProcessDynamicGlobalIlluminationMethod_8jcl != \"EDynamicGlobalIlluminationMethod::Lumen\" }"
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenRayLightingMode_control_dfcl", "Ray Lighting Mode", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenRayLightingMode_c1bl"
                    label   "Ray Lighting Mode"
                    type    string
                    size    1
                    default { "ELumenRayLightingModeOverride::Default" }
                    menu { "ELumenRayLightingModeOverride::Default" "Project Default" "ELumenRayLightingModeOverride::SurfaceCache" "Surface Cache" "ELumenRayLightingModeOverride::HitLightingForReflections" "Hit Lighting for Reflections" "ELumenRayLightingModeOverride::HitLighting" "Hit Lighting" }
                    help    "Controls how Lumen rays are lit when Lumen is using Hardware Ray Tracing. By default, Lumen uses the Surface Cache for best performance, but can be set to 'Hit Lighting' for higher quality."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "token" }
                    disablewhen R"({ xn__unrealpostProcessLumenRayLightingMode_control_dfcl == block } { xn__unrealpostProcessLumenRayLightingMode_control_dfcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSceneLightingQuality_control_incl", "Lumen Scene Lighting Quality", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSceneLightingQuality_h9bl"
                    label   "Lumen Scene Lighting Quality"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 2 }
                    help    "Scales Lumen Scene's quality. Larger scales cause Lumen Scene to be calculated with a higher fidelity, which can be visible in reflections, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenSceneLightingQuality_control_incl == block } { xn__unrealpostProcessLumenSceneLightingQuality_control_incl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSceneDetail_control_u7bl", "Lumen Scene Detail", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSceneDetail_tubl"
                    label   "Lumen Scene Detail"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 4 }
                    help    "Controls the size of instances that can be represented in Lumen Scene. Larger values will ensure small objects are represented, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenSceneDetail_control_u7bl == block } { xn__unrealpostProcessLumenSceneDetail_control_u7bl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSceneViewDistance_control_micl", "Lumen Scene View Distance", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSceneViewDistance_l4bl"
                    label   "Lumen Scene View Distance"
                    type    float
                    size    1
                    default { 20000 }
                    range   { 1! 2097152 }
                    help    "Sets the maximum view distance of the scene that Lumen maintains for ray tracing against. Larger values will increase the effective range of sky shadowing and Global Illumination, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenSceneViewDistance_control_micl == block } { xn__unrealpostProcessLumenSceneViewDistance_control_micl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenFinalGatherQuality_control_8jcl", "Final Gather Quality", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenFinalGatherQuality_75bl"
                    label   "Final Gather Quality"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 2 }
                    help    "Scales Lumen's Final Gather quality. Larger scales reduce noise, but greatly increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenFinalGatherQuality_control_8jcl == block } { xn__unrealpostProcessLumenFinalGatherQuality_control_8jcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenFinalGatherScreenTraces_control_escl", "Screen Traces", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenFinalGatherScreenTraces_dfcl"
                    label   "Screen Traces"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Whether to use screen space traces for Lumen Global Illumination. Screen space traces bypass Lumen Scene and instead sample Scene Depth and Scene Color. This improves quality, as it bypasses Lumen Scene, but causes view dependent lighting."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessLumenFinalGatherScreenTraces_control_escl == block } { xn__unrealpostProcessLumenFinalGatherScreenTraces_control_escl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenMaxTraceDistance_control_zgcl", "Max Trace Distance", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenMaxTraceDistance_y2bl"
                    label   "Max Trace Distance"
                    type    float
                    size    1
                    default { 20000 }
                    range   { 1! 2097152 }
                    help    "Controls the maximum distance that Lumen should trace while solving lighting. Values that are too small will cause lighting to leak into large caves, while values that are large will increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenMaxTraceDistance_control_zgcl == block } { xn__unrealpostProcessLumenMaxTraceDistance_control_zgcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSurfaceCacheResolution_control_rqcl", "Lumen Surface Cache Resolution", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSurfaceCacheResolution_qdcl"
                    label   "Lumen Surface Cache Resolution"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.5! 1! }
                    help    "Scale factor for Lumen Surface Cache resolution. Smaller values save GPU memory, at a cost in quality. Defaults to 0.5 for Scene Captures if not overridden."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenSurfaceCacheResolution_control_rqcl == block } { xn__unrealpostProcessLumenSurfaceCacheResolution_control_rqcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealcvarrLumenHardwareRayTracing_control_h9bebf", "Hardware Ray Tracing", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealcvarrLumenHardwareRayTracing_gwbebf"
                    label   "Hardware Ray Tracing"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Uses Hardware Ray Tracing for Lumen features, when available. Lumen will fall back to Software Ray Tracing otherwise. Note: Hardware ray tracing has significant scene update costs for scenes with more than 100k instances. Console variable r.Lumen.HardwareRayTracing (process-wide)."
                    parmtag { "spare_category" "Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealcvarrLumenHardwareRayTracing_control_h9bebf == block } { xn__unrealcvarrLumenHardwareRayTracing_control_h9bebf == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSceneLightingUpdateSpeed_control_0tcl", "Lumen Scene Lighting Update Speed", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSceneLightingUpdateSpeed_zgcl"
                    label   "Lumen Scene Lighting Update Speed"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.5! 4 }
                    help    "Controls how much Lumen Scene is allowed to cache lighting results to improve performance. Larger scales cause lighting changes to propagate faster, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenSceneLightingUpdateSpeed_control_0tcl == block } { xn__unrealpostProcessLumenSceneLightingUpdateSpeed_control_0tcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenFinalGatherLightingUpdateSpeed_control_s3cl", "Final Gather Lighting Update Speed", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenFinalGatherLightingUpdateSpeed_rqcl"
                    label   "Final Gather Lighting Update Speed"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.5! 4 }
                    help    "Controls how much Lumen Final Gather is allowed to cache lighting results to improve performance. Larger scales cause lighting changes to propagate faster, but increase GPU cost and noise."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenFinalGatherLightingUpdateSpeed_control_s3cl == block } { xn__unrealpostProcessLumenFinalGatherLightingUpdateSpeed_control_s3cl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenDiffuseColorBoost_control_micl", "Diffuse Color Boost", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenDiffuseColorBoost_l4bl"
                    label   "Diffuse Color Boost"
                    type    float
                    size    1
                    default { 1 }
                    range   { 1! 4! }
                    help    "Allows brightening indirect lighting by calculating material diffuse color for indirect lighting. Values above 1 (original diffuse color) aren't physically correct, but they can be useful as an art direction knob to increase the amount of bounced light in the scene. Best to keep below 2 as it also causes reflections to be brighter than the scene."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenDiffuseColorBoost_control_micl == block } { xn__unrealpostProcessLumenDiffuseColorBoost_control_micl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenAmbientOcclusionIntensity_control_nvcl", "Ambient Occlusion Intensity", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenAmbientOcclusionIntensity_micl"
                    label   "Ambient Occlusion Intensity"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1! }
                    help    "Allows control over the strength of Lumen's Short Range Ambient Occlusion."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenAmbientOcclusionIntensity_control_nvcl == block } { xn__unrealpostProcessLumenAmbientOcclusionIntensity_control_nvcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSkylightLeaking_control_dfcl", "Skylight Leaking", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSkylightLeaking_c1bl"
                    label   "Skylight Leaking"
                    type    float
                    size    1
                    default { 0 }
                    range   { 0! 1! }
                    help    "Controls what fraction of the skylight intensity should be allowed to leak. This can be useful as an art direction knob (non-physically based) to keep indoor areas from going fully black."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenSkylightLeaking_control_dfcl == block } { xn__unrealpostProcessLumenSkylightLeaking_control_dfcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenSkylightLeakingTint_control_vlcl", "Skylight Leaking Tint", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenSkylightLeakingTint_u7bl"
                    label   "Skylight Leaking Tint"
                    type    color
                    size    3
                    default { 1 1 1 }
                    help    "Color tint for Lumen Skylight Leaking."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__unrealpostProcessLumenSkylightLeakingTint_control_vlcl == block } { xn__unrealpostProcessLumenSkylightLeakingTint_control_vlcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenFullSkylightLeakingDistance_control_wycl", "Full Skylight Leaking Distance", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenFullSkylightLeakingDistance_vlcl"
                    label   "Full Skylight Leaking Distance"
                    type    float
                    size    1
                    default { 1000 }
                    range   { 0.1! 2000 }
                    help    "Controls the distance from a receiving surface where skylight leaking reaches its full intensity. Smaller values make the skylight leaking flatter, while larger values create an Ambient Occlusion effect."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenFullSkylightLeakingDistance_control_wycl == block } { xn__unrealpostProcessLumenFullSkylightLeakingDistance_control_wycl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
            }
        }

        groupcollapsible {
            name "hdUE_Lighting_Reflections"
            label "Reflections"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            HDUE_CONTROL_HIDE("xn__unrealpostProcessReflectionMethod_control_u7bl", "Method", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessReflectionMethod_tubl"
                label   "Method"
                type    string
                size    1
                default { "EReflectionMethod::Lumen" }
                menu { "EReflectionMethod::None" "None" "EReflectionMethod::Lumen" "Lumen" "EReflectionMethod::ScreenSpace" "Screen Space" }
                help    "Chooses the Reflection method. Not compatible with Forward Shading. Overrides unreal:lumenEnabled."
                parmtag { "spare_category" "Reflections" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessReflectionMethod_control_u7bl == block } { xn__unrealpostProcessReflectionMethod_control_u7bl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }

            groupsimple {
                name "hdUE_Lighting_Reflections_LumenReflections"
                label "Lumen Reflections"
                hidewhentab "{ xn__unrealrenderMode_41a != realtime } { xn__unrealpostProcessReflectionMethod_tubl != \"EReflectionMethod::Lumen\" }"
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenReflectionQuality_control_micl", "Quality", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenReflectionQuality_l4bl"
                    label   "Quality"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 2 }
                    help    "Scales the Reflection quality. Larger scales reduce noise in reflections, but increase GPU cost."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenReflectionQuality_control_micl == block } { xn__unrealpostProcessLumenReflectionQuality_control_micl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenReflectionsScreenTraces_control_escl", "Screen Traces", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenReflectionsScreenTraces_dfcl"
                    label   "Screen Traces"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Whether to use screen space traces for Lumen Reflections. Screen space traces bypass Lumen Scene and instead sample Scene Depth and Scene Color. This improves quality, as it bypasses Lumen Scene, but causes view dependent lighting."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessLumenReflectionsScreenTraces_control_escl == block } { xn__unrealpostProcessLumenReflectionsScreenTraces_control_escl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenFrontLayerTranslucencyReflections_control_o8cl", "High Quality Translucency Reflections", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenFrontLayerTranslucencyReflections_nvcl"
                    label   "High Quality Translucency Reflections"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Whether to use high quality mirror reflections on the front layer of translucent surfaces. Other layers will use the lower quality Radiance Cache method that can only produce glossy reflections. Increases GPU cost when enabled."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealpostProcessLumenFrontLayerTranslucencyReflections_control_o8cl == block } { xn__unrealpostProcessLumenFrontLayerTranslucencyReflections_control_o8cl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenMaxRoughnessToTraceReflections_control_s3cl", "Max Roughness To Trace", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenMaxRoughnessToTraceReflections_rqcl"
                    label   "Max Roughness To Trace"
                    type    float
                    size    1
                    default { 0.4 }
                    range   { 0! 1! }
                    help    "Sets the maximum roughness value for which Lumen still traces dedicated reflection rays. Higher values improve reflection quality, but greatly increase GPU cost."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessLumenMaxRoughnessToTraceReflections_control_s3cl == block } { xn__unrealpostProcessLumenMaxRoughnessToTraceReflections_control_s3cl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenMaxReflectionBounces_control_incl", "Max Reflection Bounces", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenMaxReflectionBounces_h9bl"
                    label   "Max Reflection Bounces"
                    type    int
                    size    1
                    default { 1 }
                    range   { 1! 8! }
                    help    "Sets the maximum number of recursive reflection bounces. 1 means a single reflection ray (no secondary reflections in mirrors). Currently only supported by Hardware Ray Tracing with Hit Lighting."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "int" }
                    disablewhen R"({ xn__unrealpostProcessLumenMaxReflectionBounces_control_incl == block } { xn__unrealpostProcessLumenMaxReflectionBounces_control_incl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessLumenMaxRefractionBounces_control_incl", "Max Refraction Bounces", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessLumenMaxRefractionBounces_h9bl"
                    label   "Max Refraction Bounces"
                    type    int
                    size    1
                    default { 0 }
                    range   { 0! 64! }
                    help    "The maximum count of refraction event to trace. When hit lighting is used, Translucent meshes will be traced when LumenMaxRefractionBounces > 0, making the reflection tracing more expenssive."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "int" }
                    disablewhen R"({ xn__unrealpostProcessLumenMaxRefractionBounces_control_incl == block } { xn__unrealpostProcessLumenMaxRefractionBounces_control_incl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealcvarrLumenReflectionsHardwareRayTracing_control_escebfl", "Hardware Ray Traced Reflections", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealcvarrLumenReflectionsHardwareRayTracing_dfcebfl"
                    label   "Hardware Ray Traced Reflections"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Enables hardware ray tracing for Lumen reflections (Default = 1) Console variable r.Lumen.Reflections.HardwareRayTracing (process-wide)."
                    parmtag { "spare_category" "Lumen Reflections" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__unrealcvarrLumenReflectionsHardwareRayTracing_control_escebfl == block } { xn__unrealcvarrLumenReflectionsHardwareRayTracing_control_escebfl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
                }
            }

            groupsimple {
                name "hdUE_Lighting_Reflections_ScreenSpaceReflections"
                label "Screen Space Reflections"
                hidewhentab "{ xn__unrealrenderMode_41a != realtime } { xn__unrealpostProcessReflectionMethod_tubl != \"EReflectionMethod::ScreenSpace\" }"
                HDUE_CONTROL_HIDE("xn__unrealpostProcessScreenSpaceReflectionIntensity_control_nvcl", "Intensity", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessScreenSpaceReflectionIntensity_micl"
                    label   "Intensity"
                    type    float
                    size    1
                    default { 100 }
                    range   { 0! 100! }
                    help    "Enable/Fade/disable the Screen Space Reflection feature, in percent, avoid numbers between 0 and 1 fo consistency"
                    parmtag { "spare_category" "Reflections|Screen Space Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessScreenSpaceReflectionIntensity_control_nvcl == block } { xn__unrealpostProcessScreenSpaceReflectionIntensity_control_nvcl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessScreenSpaceReflectionQuality_control_escl", "Quality", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessScreenSpaceReflectionQuality_dfcl"
                    label   "Quality"
                    type    float
                    size    1
                    default { 50 }
                    range   { 0! 100 }
                    help    "0=lowest quality..100=maximum quality, only a few quality levels are implemented, no soft transition, 50 is the default for better performance."
                    parmtag { "spare_category" "Reflections|Screen Space Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessScreenSpaceReflectionQuality_control_escl == block } { xn__unrealpostProcessScreenSpaceReflectionQuality_control_escl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
                HDUE_CONTROL_HIDE("xn__unrealpostProcessScreenSpaceReflectionMaxRoughness_control_j0cl", "Max Roughness", "{ xn__unrealrenderMode_41a != realtime }")
                parm {
                    name    "xn__unrealpostProcessScreenSpaceReflectionMaxRoughness_incl"
                    label   "Max Roughness"
                    type    float
                    size    1
                    default { 0.6 }
                    range   { 0.01! 1! }
                    help    "Until what roughness we fade the screen space reflections, 0.8 works well, smaller can run faster"
                    parmtag { "spare_category" "Reflections|Screen Space Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessScreenSpaceReflectionMaxRoughness_control_j0cl == block } { xn__unrealpostProcessScreenSpaceReflectionMaxRoughness_control_j0cl == none })"
                    hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                }
            }
        }

        groupcollapsible {
            name "hdUE_Lighting_Shadows"
            label "Shadows"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualEnable_control_y2bebgh", "Virtual Shadow Maps", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualEnable_xpbebgh"
                label   "Virtual Shadow Maps"
                type    toggle
                size    1
                default { 1 }
                help    "Enable Virtual Shadow Maps. Renders geometry into virtualized shadow depth maps for shadowing. Provides high - quality shadows for next - gen projects with simplified setup.High efficiency culling when used with Nanite. Console variable r.Shadow.Virtual.Enable (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualEnable_control_y2bebgh == block } { xn__unrealcvarrShadowVirtualEnable_control_y2bebgh == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrRayTracingShadows_control_pzbebk", "Ray Traced Shadows", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrRayTracingShadows_ombebk"
                label   "Ray Traced Shadows"
                type    toggle
                size    1
                default { 0 }
                help    "0: use traditional rasterized shadow map (default) 1: use ray tracing shadows Console variable r.RayTracing.Shadows (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealcvarrRayTracingShadows_control_pzbebk == block } { xn__unrealcvarrRayTracingShadows_control_pzbebk == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualResolutionLodBiasDirectional_control_s3cebgh", "Directional Resolution Bias", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualResolutionLodBiasDirectional_rqcebgh"
                label   "Directional Resolution Bias"
                type    float
                size    1
                default { -1.5 }
                range   { -2 2 }
                help    "Bias applied to LOD calculations for directional lights. -1.0 doubles resolution, 1.0 halves it and so on. Console variable r.Shadow.Virtual.ResolutionLodBiasDirectional (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualResolutionLodBiasDirectional_control_s3cebgh == block } { xn__unrealcvarrShadowVirtualResolutionLodBiasDirectional_control_s3cebgh == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualResolutionLodBiasLocal_control_0tcebgh", "Local Resolution Bias", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualResolutionLodBiasLocal_zgcebgh"
                label   "Local Resolution Bias"
                type    float
                size    1
                default { 0 }
                range   { -2 2 }
                help    "Bias applied to LOD calculations for local lights. -1.0 doubles resolution, 1.0 halves it and so on. Console variable r.Shadow.Virtual.ResolutionLodBiasLocal (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualResolutionLodBiasLocal_control_0tcebgh == block } { xn__unrealcvarrShadowVirtualResolutionLodBiasLocal_control_0tcebgh == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualSMRTRayCountDirectional_control_nvcebghe", "Directional Soft Shadow Rays", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualSMRTRayCountDirectional_micebghe"
                label   "Directional Soft Shadow Rays"
                type    int
                size    1
                default { 8 }
                range   { 0! 16 }
                help    "Ray count for shadow map tracing of directional lights. 0 = disabled. Console variable r.Shadow.Virtual.SMRT.RayCountDirectional (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualSMRTRayCountDirectional_control_nvcebghe == block } { xn__unrealcvarrShadowVirtualSMRTRayCountDirectional_control_nvcebghe == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualSMRTSamplesPerRayDirectional_control_s3cebghe", "Directional Samples per Ray", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualSMRTSamplesPerRayDirectional_rqcebghe"
                label   "Directional Samples per Ray"
                type    int
                size    1
                default { 4 }
                range   { 0! 16 }
                help    "Shadow map samples per ray for directional lights Console variable r.Shadow.Virtual.SMRT.SamplesPerRayDirectional (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualSMRTSamplesPerRayDirectional_control_s3cebghe == block } { xn__unrealcvarrShadowVirtualSMRTSamplesPerRayDirectional_control_s3cebghe == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualSMRTRayCountLocal_control_vlcebghe", "Local Soft Shadow Rays", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualSMRTRayCountLocal_u7bebghe"
                label   "Local Soft Shadow Rays"
                type    int
                size    1
                default { 8 }
                range   { 0! 16 }
                help    "Ray count for shadow map tracing of local lights. 0 = disabled. Console variable r.Shadow.Virtual.SMRT.RayCountLocal (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualSMRTRayCountLocal_control_vlcebghe == block } { xn__unrealcvarrShadowVirtualSMRTRayCountLocal_control_vlcebghe == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowVirtualSMRTSamplesPerRayLocal_control_0tcebghe", "Local Samples per Ray", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowVirtualSMRTSamplesPerRayLocal_zgcebghe"
                label   "Local Samples per Ray"
                type    int
                size    1
                default { 4 }
                range   { 0! 16 }
                help    "Shadow map samples per ray for local lights Console variable r.Shadow.Virtual.SMRT.SamplesPerRayLocal (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrShadowVirtualSMRTSamplesPerRayLocal_control_0tcebghe == block } { xn__unrealcvarrShadowVirtualSMRTSamplesPerRayLocal_control_0tcebghe == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrShadowFilterMethod_control_c1bebg", "Shadow Map Filter", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrShadowFilterMethod_bobebg"
                label   "Shadow Map Filter"
                type    int
                size    1
                default { 0 }
                menu { "0" "PCF" "1" "PCSS" }
                help    "Chooses the shadow filtering method. 0: Uniform PCF (default) 1: PCSS (experimental) Console variable r.Shadow.FilterMethod (process-wide)."
                parmtag { "spare_category" "Shadows" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrShadowFilterMethod_control_c1bebg == block } { xn__unrealcvarrShadowFilterMethod_control_c1bebg == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Lighting_DomeandViewerLights"
            label "Dome and Viewer Lights"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            HDUE_CONTROL("xn__unrealdomeResolution_control_omb", "Environment Cube Resolution")
            parm {
                name    "xn__unrealdomeResolution_n8a"
                label   "Environment Cube Resolution"
                type    int
                size    1
                default { 512 }
                menu { "32" "32" "64" "64" "128" "128" "256" "256" "512" "512" "1024" "1024" "2048" "2048" }
                help    "Face size of the cubemap dome lights are baked into, for lighting, reflections and the background."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealdomeResolution_control_omb == block } { xn__unrealdomeResolution_control_omb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealautoViewerLight_control_bob", "Light Unlit Scenes")
            parm {
                name    "xn__unrealautoViewerLight_99a"
                label   "Light Unlit Scenes"
                type    toggle
                size    1
                default { 1 }
                help    "Add a camera-relative key and fill light when the scene has no lights, so unlit scenes are reviewable."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealautoViewerLight_control_bob == block } { xn__unrealautoViewerLight_control_bob == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealviewerLightIntensity_control_gwb", "Viewer Light Intensity")
            parm {
                name    "xn__unrealviewerLightIntensity_fjb"
                label   "Viewer Light Intensity"
                type    float
                size    1
                default { 4 }
                range   { 0! 100 }
                help    "Intensity of the unlit-scene lights and of the viewport's headlight."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealviewerLightIntensity_control_gwb == block } { xn__unrealviewerLightIntensity_control_gwb == none })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }
    }

    group {
        name "hdUE_Fog_Tab"
        label "Fog"
        HDUE_CONTROL("xn__unrealheightFog_control_jeb", "Exponential Height Fog")
        parm {
            name    "xn__unrealheightFog_i0a"
            label   "Exponential Height Fog"
            type    toggle
            size    1
            default { 0 }
            help    "Place UE's Exponential Height Fog in the scene, as an Exponential Height Fog actor in a level. Turn on Volumetric Fog for lit, shadowed fog (light shafts); the Path Tracer renders the fog only with Volumetric Fog on. Lights scatter into it by their Volumetric Scattering Intensity."
            parmtag { "spare_category" "Fog" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unrealheightFog_control_jeb == block } { xn__unrealheightFog_control_jeb == none })"
        }
        HDUE_CONTROL("xn__unrealheightFogHeight_control_bob", "Fog Height")
        parm {
            name    "xn__unrealheightFogHeight_99a"
            label   "Fog Height"
            type    float
            size    1
            default { 0 }
            range   { -100 100 }
            help    "Height of the fog actor, in scene units along the stage's up axis: the fog's density is Fog Density there and grows below it."
            parmtag { "spare_category" "Fog" }
            parmtag { "uiscope" "viewport" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unrealheightFogHeight_control_bob == block } { xn__unrealheightFogHeight_control_bob == none } { xn__unrealheightFog_i0a == 0 })"
        }

        groupcollapsible {
            name "hdUE_Fog_ExponentialHeightFogComponent"
            label "Exponential Height Fog Component"
            grouptag { "group_default" "1" }
            HDUE_CONTROL("xn__unrealheightFogFogDensity_control_tubj", "Fog Density")
            parm {
                name    "xn__unrealheightFogFogDensity_shbj"
                label   "Fog Density"
                type    float
                size    1
                default { 0.02 }
                range   { 0 0.05 }
                help    "Global density factor."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFogDensity_control_tubj == block } { xn__unrealheightFogFogDensity_control_tubj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogFogHeightFalloff_control_l4bj", "Fog Height Falloff")
            parm {
                name    "xn__unrealheightFogFogHeightFalloff_krbj"
                label   "Fog Height Falloff"
                type    float
                size    1
                default { 0.2 }
                range   { 0.001 2 }
                help    "Height density factor, controls how the density increases as height decreases. Smaller values make the visible transition larger."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFogHeightFalloff_control_l4bj == block } { xn__unrealheightFogFogHeightFalloff_control_l4bj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogSecondFogData_control_pzbj", "Second Fog Data")
            parm {
                name    "xn__unrealheightFogSecondFogData_ombj"
                label   "Second Fog Data"
                type    float
                size    3
                default { 0 0.2 0 }
                help    "Settings for the second fog. Setting the density of this to 0 means it doesn't have any influence. Density, height falloff and height offset of the second fog (FExponentialHeightFogData); density 0 turns it off."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float3" }
                disablewhen R"({ xn__unrealheightFogSecondFogData_control_pzbj == block } { xn__unrealheightFogSecondFogData_control_pzbj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogFogInscatteringLuminance_control_micj", "Fog Inscattering Color")
            parm {
                name    "xn__unrealheightFogFogInscatteringLuminance_l4bj"
                label   "Fog Inscattering Color"
                type    color
                size    3
                default { 0 0 0 }
                help    "Note: when r.SupportExpFogMatchesVolumetricFog = 1, this value is ignored and the volumetric fog Emissive is used instead."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealheightFogFogInscatteringLuminance_control_micj == block } { xn__unrealheightFogFogInscatteringLuminance_control_micj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogSkyAtmosphereAmbientContributionColorScale_control_xcdj", "Sky Atmosphere Ambient Contribution Color Scale")
            parm {
                name    "xn__unrealheightFogSkyAtmosphereAmbientContributionColorScale_wycj"
                label   "Sky Atmosphere Ambient Contribution Color Scale"
                type    color
                size    3
                default { 1 1 1 }
                help    "Color used to modulate the SkyAtmosphere component contribution to the non directional component of the fog. Only effective when r.SupportSkyAtmosphereAffectsHeightFog>0"
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealheightFogSkyAtmosphereAmbientContributionColorScale_control_xcdj == block } { xn__unrealheightFogSkyAtmosphereAmbientContributionColorScale_control_xcdj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogFogMaxOpacity_control_pzbj", "Fog Max Opacity")
            parm {
                name    "xn__unrealheightFogFogMaxOpacity_ombj"
                label   "Fog Max Opacity"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Maximum opacity of the fog. A value of 1 means the fog can become fully opaque at a distance and replace scene color completely, A value of 0 means the fog color will not be factored in at all."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFogMaxOpacity_control_pzbj == block } { xn__unrealheightFogFogMaxOpacity_control_pzbj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogStartDistance_control_pzbj", "Start Distance")
            parm {
                name    "xn__unrealheightFogStartDistance_ombj"
                label   "Start Distance"
                type    float
                size    1
                default { 0 }
                range   { 0 5000 }
                help    "Distance from the camera that the fog will start, in world units."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogStartDistance_control_pzbj == block } { xn__unrealheightFogStartDistance_control_pzbj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogEndDistance_control_gwbj", "End Distance")
            parm {
                name    "xn__unrealheightFogEndDistance_fjbj"
                label   "End Distance"
                type    float
                size    1
                default { 0 }
                range   { 0 500000 }
                help    "Distance from the camera, on the horizontal XY plane, that the fog will end integrating the lighting and transmittance. Disabled when 0."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogEndDistance_control_gwbj == block } { xn__unrealheightFogEndDistance_control_gwbj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogFogCutoffDistance_control_75bj", "Fog Cutoff Distance")
            parm {
                name    "xn__unrealheightFogFogCutoffDistance_6sbj"
                label   "Fog Cutoff Distance"
                type    float
                size    1
                default { 0 }
                range   { 100000 20000000 }
                help    "Scene elements past this distance will not have fog applied. This is useful for excluding skyboxes which already have fog baked in."
                parmtag { "spare_category" "ExponentialHeightFogComponent" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFogCutoffDistance_control_75bj == block } { xn__unrealheightFogFogCutoffDistance_control_75bj == none } { xn__unrealheightFog_i0a == 0 })"
            }
        }

        groupcollapsible {
            name "hdUE_Fog_InscatteringTexture"
            label "Inscattering Texture"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__unrealheightFogInscatteringColorCubemap_control_micj", "Inscattering Color Cubemap")
            parm {
                name    "xn__unrealheightFogInscatteringColorCubemap_l4bj"
                label   "Inscattering Color Cubemap"
                type    string
                size    1
                default { "" }
                help    "Cubemap that can be specified for fog color, which is useful to make distant, heavily fogged scene elements match the sky. When the cubemap is specified, FogInscatteringColor is ignored and Directional inscattering is disabled. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__unrealheightFogInscatteringColorCubemap_control_micj == block } { xn__unrealheightFogInscatteringColorCubemap_control_micj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogSkyLightCaptureAffectsHeightFogStrength_control_16cj", "Sky Light Capture In-Scattering Strength")
            parm {
                name    "xn__unrealheightFogSkyLightCaptureAffectsHeightFogStrength_0tcj"
                label   "Sky Light Capture In-Scattering Strength"
                type    float
                size    1
                default { 0 }
                range   { 0! 1 }
                help    "When >0 and when r.SupportsSkyLightCaptureAffectsHeightFogInScattering is true, this will make the sky light capture inject scattered light into the height fog."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogSkyLightCaptureAffectsHeightFogStrength_control_16cj == block } { xn__unrealheightFogSkyLightCaptureAffectsHeightFogStrength_control_16cj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogSkyLightCaptureAffectsHeightFogRoughness_control_o8cj", "Sky Light Capture In-Scattering Roughness")
            parm {
                name    "xn__unrealheightFogSkyLightCaptureAffectsHeightFogRoughness_nvcj"
                label   "Sky Light Capture In-Scattering Roughness"
                type    float
                size    1
                default { 0.15 }
                range   { 0! 1! }
                help    "This is the roughness at which the sky light capture cubemap will be sample to simulate scattering dispersion due to a phase function."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogSkyLightCaptureAffectsHeightFogRoughness_control_o8cj == block } { xn__unrealheightFogSkyLightCaptureAffectsHeightFogRoughness_control_o8cj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogInscatteringColorCubemapAngle_control_rqcj", "Inscattering Color Cubemap Angle")
            parm {
                name    "xn__unrealheightFogInscatteringColorCubemapAngle_qdcj"
                label   "Inscattering Color Cubemap Angle"
                type    float
                size    1
                default { 0 }
                range   { 0 360 }
                help    "Angle to rotate the InscatteringColorCubemap around the Z axis."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogInscatteringColorCubemapAngle_control_rqcj == block } { xn__unrealheightFogInscatteringColorCubemapAngle_control_rqcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogInscatteringTextureTint_control_zgcj", "Inscattering Texture Tint")
            parm {
                name    "xn__unrealheightFogInscatteringTextureTint_y2bj"
                label   "Inscattering Texture Tint"
                type    color
                size    3
                default { 1 1 1 }
                help    "Tint color used when InscatteringColorCubemap is specified, for quick edits without having to reimport InscatteringColorCubemap."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealheightFogInscatteringTextureTint_control_zgcj == block } { xn__unrealheightFogInscatteringTextureTint_control_zgcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogFullyDirectionalInscatteringColorDistance_control_bbdj", "Fully Directional Inscattering Color Distance")
            parm {
                name    "xn__unrealheightFogFullyDirectionalInscatteringColorDistance_9wcj"
                label   "Fully Directional Inscattering Color Distance"
                type    float
                size    1
                default { 100000 }
                range   { 1000 1000000 }
                help    "Distance at which InscatteringColorCubemap should be used directly for the Inscattering Color."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFullyDirectionalInscatteringColorDistance_control_bbdj == block } { xn__unrealheightFogFullyDirectionalInscatteringColorDistance_control_bbdj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogNonDirectionalInscatteringColorDistance_control_16cj", "Non Directional Inscattering Color Distance")
            parm {
                name    "xn__unrealheightFogNonDirectionalInscatteringColorDistance_0tcj"
                label   "Non Directional Inscattering Color Distance"
                type    float
                size    1
                default { 1000 }
                range   { 1000 1000000 }
                help    "Distance at which only the average color of InscatteringColorCubemap should be used as Inscattering Color."
                parmtag { "spare_category" "InscatteringTexture" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogNonDirectionalInscatteringColorDistance_control_16cj == block } { xn__unrealheightFogNonDirectionalInscatteringColorDistance_control_16cj == none } { xn__unrealheightFog_i0a == 0 })"
            }
        }

        groupcollapsible {
            name "hdUE_Fog_DirectionalInscattering"
            label "Directional Inscattering"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__unrealheightFogDirectionalInscatteringExponent_control_0tcj", "Directional Inscattering Exponent")
            parm {
                name    "xn__unrealheightFogDirectionalInscatteringExponent_zgcj"
                label   "Directional Inscattering Exponent"
                type    float
                size    1
                default { 4 }
                range   { 2 64 }
                help    "Controls the size of the directional inscattering cone, which is used to approximate inscattering from a directional light. Note: - there must be a directional light with bUsedAsAtmosphereSunLight enabled for DirectionalInscattering to be used. - When r.SupportExpFogMatchesVolumetricFog = 1, this value is ignored and the volumetric fog Scattering Distribution is used instead."
                parmtag { "spare_category" "DirectionalInscattering" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogDirectionalInscatteringExponent_control_0tcj == block } { xn__unrealheightFogDirectionalInscatteringExponent_control_0tcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogDirectionalInscatteringStartDistance_control_51cj", "Directional Inscattering Start Distance")
            parm {
                name    "xn__unrealheightFogDirectionalInscatteringStartDistance_4ocj"
                label   "Directional Inscattering Start Distance"
                type    float
                size    1
                default { 10000 }
                help    "Controls the start distance from the viewer of the directional inscattering, which is used to approximate inscattering from a directional light. Note: - There must be a directional light with bUsedAsAtmosphereSunLight enabled for DirectionalInscattering to be used. - When r.SupportExpFogMatchesVolumetricFog = 1, this value is ignored."
                parmtag { "spare_category" "DirectionalInscattering" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogDirectionalInscatteringStartDistance_control_51cj == block } { xn__unrealheightFogDirectionalInscatteringStartDistance_control_51cj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogDirectionalInscatteringLuminance_control_nvcj", "Directional Inscattering Color")
            parm {
                name    "xn__unrealheightFogDirectionalInscatteringLuminance_micj"
                label   "Directional Inscattering Color"
                type    color
                size    3
                default { 0 0 0 }
                help    "Controls the color of the directional inscattering, which is used to approximate inscattering from a directional light. Note: - there must be a directional light with bUsedAsAtmosphereSunLight enabled for DirectionalInscattering to be used. - When r.SupportExpFogMatchesVolumetricFog = 1, this value is ignored."
                parmtag { "spare_category" "DirectionalInscattering" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealheightFogDirectionalInscatteringLuminance_control_nvcj == block } { xn__unrealheightFogDirectionalInscatteringLuminance_control_nvcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
        }

        groupcollapsible {
            name "hdUE_Fog_VolumetricFog"
            label "Volumetric Fog"
            grouptag { "group_default" "1" }
            HDUE_CONTROL("xn__unrealheightFogbEnableVolumetricFog_control_3bcj", "Volumetric Fog")
            parm {
                name    "xn__unrealheightFogbEnableVolumetricFog_2xbj"
                label   "Volumetric Fog"
                type    toggle
                size    1
                default { 0 }
                help    "Whether to enable Volumetric fog. Scalability settings control the resolution of the fog simulation. Note that Volumetric fog currently does not support StartDistance, FogMaxOpacity and FogCutoffDistance. Volumetric fog also can't match exponential height fog in general as exponential height fog has non-physical behavior."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbEnableVolumetricFog_control_3bcj == block } { xn__unrealheightFogbEnableVolumetricFog_control_3bcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogScatteringDistribution_control_j0cj", "Scattering Distribution")
            parm {
                name    "xn__unrealheightFogVolumetricFogScatteringDistribution_incj"
                label   "Scattering Distribution"
                type    float
                size    1
                default { 0.2 }
                range   { -0.9 0.9 }
                help    "Controls the scattering phase function - how much incoming light scatters in various directions. A distribution value of 0 scatters equally in all directions, while .9 scatters predominantly in the light direction. In order to have visible volumetric fog light shafts from the side, the distribution will need to be closer to 0."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogScatteringDistribution_control_j0cj == block } { xn__unrealheightFogVolumetricFogScatteringDistribution_control_j0cj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogAlbedo_control_h9bj", "Albedo")
            parm {
                name    "xn__unrealheightFogVolumetricFogAlbedo_gwbj"
                label   "Albedo"
                type    color
                size    3
                default { 1 1 1 }
                help    "The height fog particle reflectiveness used by volumetric fog. Water particles in air have an albedo near white, while dust has slightly darker value."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogAlbedo_control_h9bj == block } { xn__unrealheightFogVolumetricFogAlbedo_control_h9bj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogEmissive_control_qdcj", "Emissive")
            parm {
                name    "xn__unrealheightFogVolumetricFogEmissive_pzbj"
                label   "Emissive"
                type    color
                size    3
                default { 0 0 0 }
                help    "Light emitted by height fog. This is a density so more light is emitted the further you are looking through the fog. In most cases skylight is a better choice, however right now volumetric fog does not support precomputed lighting, So stationary skylights are unshadowed and static skylights don't affect volumetric fog at all."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogEmissive_control_qdcj == block } { xn__unrealheightFogVolumetricFogEmissive_control_qdcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogExtinctionScale_control_4ocj", "Extinction Scale")
            parm {
                name    "xn__unrealheightFogVolumetricFogExtinctionScale_3bcj"
                label   "Extinction Scale"
                type    float
                size    1
                default { 1 }
                range   { 0.1 10 }
                help    "Scales the height fog particle extinction amount used by volumetric fog. Values larger than 1 cause fog particles everywhere absorb more light."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogExtinctionScale_control_4ocj == block } { xn__unrealheightFogVolumetricFogExtinctionScale_control_4ocj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogDistance_control_qdcj", "View Distance")
            parm {
                name    "xn__unrealheightFogVolumetricFogDistance_pzbj"
                label   "View Distance"
                type    float
                size    1
                default { 6000 }
                range   { 1000 10000 }
                help    "Distance over which volumetric fog should be computed, after the start distance. Larger values extend the effect into the distance but expose under-sampling artifacts in details."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogDistance_control_qdcj == block } { xn__unrealheightFogVolumetricFogDistance_control_qdcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogStartDistance_control_vlcj", "Start Distance")
            parm {
                name    "xn__unrealheightFogVolumetricFogStartDistance_u7bj"
                label   "Start Distance"
                type    float
                size    1
                default { 0 }
                range   { 0 5000 }
                help    "Distance from the camera that the volumetric fog will start, in world units."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogStartDistance_control_vlcj == block } { xn__unrealheightFogVolumetricFogStartDistance_control_vlcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogNearFadeInDistance_control_0tcj", "Near Fade In Distance")
            parm {
                name    "xn__unrealheightFogVolumetricFogNearFadeInDistance_zgcj"
                label   "Near Fade In Distance"
                type    float
                size    1
                default { 0 }
                range   { 0 1000 }
                help    "Distance over which volumetric fog will fade in from the start distance."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogNearFadeInDistance_control_0tcj == block } { xn__unrealheightFogVolumetricFogNearFadeInDistance_control_0tcj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogVolumetricFogStaticLightingScatteringIntensity_control_gjdj", "Static Lighting Scattering Intensity")
            parm {
                name    "xn__unrealheightFogVolumetricFogStaticLightingScatteringIntensity_f5cj"
                label   "Static Lighting Scattering Intensity"
                type    float
                size    1
                default { 1 }
                range   { 0 10 }
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogVolumetricFogStaticLightingScatteringIntensity_control_gjdj == block } { xn__unrealheightFogVolumetricFogStaticLightingScatteringIntensity_control_gjdj == none } { xn__unrealheightFog_i0a == 0 })"
            }
            HDUE_CONTROL("xn__unrealheightFogbOverrideLightColorsWithFogInscatteringColors_control_thdj", "Override Light Colors With Fog Inscattering Colors")
            parm {
                name    "xn__unrealheightFogbOverrideLightColorsWithFogInscatteringColors_s3cj"
                label   "Override Light Colors With Fog Inscattering Colors"
                type    toggle
                size    1
                default { 0 }
                help    "Whether to use FogInscatteringColor for the Sky Light volumetric scattering color and DirectionalInscatteringColor for the Directional Light scattering color. Make sure your directional light has 'Atmosphere Sun Light' enabled! Enabling this allows Volumetric fog to better match Height fog in the distance, but produces non-physical volumetric lighting that may not match surface lighting."
                parmtag { "spare_category" "VolumetricFog" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbOverrideLightColorsWithFogInscatteringColors_control_thdj == block } { xn__unrealheightFogbOverrideLightColorsWithFogInscatteringColors_control_thdj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Fog_FogScreenSpaceScatteringEXPERIMENTAL"
            label "Fog Screen Space Scattering - EXPERIMENTAL"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            HDUE_CONTROL("xn__unrealheightFogbEnableFSSS_control_gwbj", "Enable Fog Screen Space Scattering")
            parm {
                name    "xn__unrealheightFogbEnableFSSS_fjbj"
                label   "Enable Fog Screen Space Scattering"
                type    toggle
                size    1
                default { 0 }
                help    "Enable FSSS (Fog Screen Space Scattering) to approximate multiple scattering."
                parmtag { "spare_category" "Fog Screen Space Scattering - EXPERIMENTAL" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbEnableFSSS_control_gwbj == block } { xn__unrealheightFogbEnableFSSS_control_gwbj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogFSSSSceneColorScatteringAmountScale_control_j0cj", "Scene Color Scattering Amount Scale")
            parm {
                name    "xn__unrealheightFogFSSSSceneColorScatteringAmountScale_incj"
                label   "Scene Color Scattering Amount Scale"
                type    float
                size    1
                default { 1 }
                range   { 0! 1 }
                help    "The amount of scene color injected into the fog screen space scattering technique. When 0, only the fog luminance will be scattered. When 1, fog and scene luminance will be scattered. When above 1, more scene color can be injected to increase the brightness of the multiple scattering effect, even when the fog is not too intense. We cannot scatter more than the scene color however."
                parmtag { "spare_category" "Fog Screen Space Scattering - EXPERIMENTAL" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFSSSSceneColorScatteringAmountScale_control_j0cj == block } { xn__unrealheightFogFSSSSceneColorScatteringAmountScale_control_j0cj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogFSSSSceneColorScatteringAmountPower_control_j0cj", "Scene Color Scattering Amount Power")
            parm {
                name    "xn__unrealheightFogFSSSSceneColorScatteringAmountPower_incj"
                label   "Scene Color Scattering Amount Power"
                type    float
                size    1
                default { 1 }
                range   { 0! 2 }
                help    "Apply a power over the amount of scattered scene luminance after it is evaluated using Scene Color Scattering Amount Scale. A value smaller than 1 can show more scattering where the fog is less intense."
                parmtag { "spare_category" "Fog Screen Space Scattering - EXPERIMENTAL" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFSSSSceneColorScatteringAmountPower_control_j0cj == block } { xn__unrealheightFogFSSSSceneColorScatteringAmountPower_control_j0cj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogFSSSSpreadScale_control_y2bj", "Spread Scale")
            parm {
                name    "xn__unrealheightFogFSSSSpreadScale_xpbj"
                label   "Spread Scale"
                type    float
                size    1
                default { 0.1 }
                range   { 0! 1 }
                help    "The scale of the spread for the fog multiple scattering. This basically scales mip level sampled from the blurred screen space FSSS texture. Increasing will make scene and thicker fog look fuzzier. But too high values can cause artifacts such as halos around depth discontinuities."
                parmtag { "spare_category" "Fog Screen Space Scattering - EXPERIMENTAL" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFSSSSpreadScale_control_y2bj == block } { xn__unrealheightFogFSSSSpreadScale_control_y2bj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogFSSSBlurControl_control_y2bj", "Blur Control")
            parm {
                name    "xn__unrealheightFogFSSSBlurControl_xpbj"
                label   "Blur Control"
                type    float
                size    1
                default { 0.5 }
                range   { 0! 1! }
                help    "When generating the the blurred screen space FSSS texture, this controls how much of the blurred lower mip levels is injected back into the sharper higher mip levels. A higher value will result in a blurrier result. But when = 1, multiple scattering will be a single average color of the FSSS texture."
                parmtag { "spare_category" "Fog Screen Space Scattering - EXPERIMENTAL" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealheightFogFSSSBlurControl_control_y2bj == block } { xn__unrealheightFogFSSSBlurControl_control_y2bj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Fog_Rendering"
            label "Rendering"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            HDUE_CONTROL("xn__unrealheightFogbHoldout_control_krbj", "Holdout")
            parm {
                name    "xn__unrealheightFogbHoldout_jebj"
                label   "Holdout"
                type    toggle
                size    1
                default { 0 }
                help    "If this is True, this primitive will render black with an alpha of 0, but all secondary effects (shadows, reflections, indirect lighting) remain. This feature requires activating the project setting(s) \"Alpha Output\", and \"Support Primitive Alpha Holdout\" if using the deferred renderer."
                parmtag { "spare_category" "Rendering" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbHoldout_control_krbj == block } { xn__unrealheightFogbHoldout_control_krbj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogbRenderInMainPass_control_75bj", "Render In Main Pass")
            parm {
                name    "xn__unrealheightFogbRenderInMainPass_6sbj"
                label   "Render In Main Pass"
                type    toggle
                size    1
                default { 1 }
                help    "If true, this component will be rendered in the main pass (basepass, transparency)"
                parmtag { "spare_category" "Rendering" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbRenderInMainPass_control_75bj == block } { xn__unrealheightFogbRenderInMainPass_control_75bj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogbVisibleInReflectionCaptures_control_4ocj", "Visible In Reflection Captures")
            parm {
                name    "xn__unrealheightFogbVisibleInReflectionCaptures_3bcj"
                label   "Visible In Reflection Captures"
                type    toggle
                size    1
                default { 1 }
                help    "If true, this component will be visible in reflection captures."
                parmtag { "spare_category" "Rendering" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbVisibleInReflectionCaptures_control_4ocj == block } { xn__unrealheightFogbVisibleInReflectionCaptures_control_4ocj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL("xn__unrealheightFogbVisibleInRealTimeSkyCaptures_control_rqcj", "Visible In Real Time Sky Captures")
            parm {
                name    "xn__unrealheightFogbVisibleInRealTimeSkyCaptures_qdcj"
                label   "Visible In Real Time Sky Captures"
                type    toggle
                size    1
                default { 1 }
                help    "If true, this component will be visible in real-time sky light reflection captures."
                parmtag { "spare_category" "Rendering" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealheightFogbVisibleInRealTimeSkyCaptures_control_rqcj == block } { xn__unrealheightFogbVisibleInRealTimeSkyCaptures_control_rqcj == none } { xn__unrealheightFog_i0a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }
    }

    group {
        name "hdUE_RenderingFeatures_Tab"
        label "Rendering Features"
        HDUE_CONTROL("xn__unrealpostProcessUserFlags_control_gwbl", "User Flags")
        parm {
            name    "xn__unrealpostProcessUserFlags_fjbl"
            label   "User Flags"
            type    int
            size    1
            default { 0 }
            help    "Per-view user flags accessible in materials via TestPostVolumeUserFlag node, allowing per-view overrides of material behavior."
            parmtag { "spare_category" "Rendering Features" }
            parmtag { "usdvaluetype" "int" }
            disablewhen R"({ xn__unrealpostProcessUserFlags_control_gwbl == block } { xn__unrealpostProcessUserFlags_control_gwbl == none })"
        }
        HDUE_CONTROL("xn__unrealpostProcessMaterials_control_gwb", "Post-Process Materials")
        parm {
            name    "xn__unrealpostProcessMaterials_fjb"
            label   "Post-Process Materials"
            type    string
            size    1
            default { "" }
            help    "Cooked post-process material paths, separated by spaces, added as blendables to the beauty. Before Tonemapping materials work with the Unreal tonemapper off."
            parmtag { "spare_category" "Post-Processing" }
            parmtag { "usdvaluetype" "string" }
            disablewhen R"({ xn__unrealpostProcessMaterials_control_gwb == block } { xn__unrealpostProcessMaterials_control_gwb == none })"
            parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
        }

        groupcollapsible {
            name "hdUE_RenderingFeatures_MotionBlur"
            label "Motion Blur"
            grouptag { "group_default" "0" }
            grouptag { "sidefx::header_toggle" "xn__unrealmotionBlur_41a" }
            HDUE_CONTROL("xn__unrealmotionBlur_control_5fb", "Motion Blur")
            parm {
                name    "xn__unrealmotionBlur_41a"
                label   "Motion Blur"
                type    toggle
                size    1
                default { 1 }
                help    "Average sub-frames over the camera shutter (shutter:open/close) when something moves. Depth of field comes from the camera's fStop and focusDistance."
                parmtag { "spare_category" "Motion Blur" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealmotionBlur_control_5fb == block } { xn__unrealmotionBlur_control_5fb == none })"
            }
            HDUE_CONTROL("xn__unrealmotionSamples_control_1kb", "Motion Samples")
            parm {
                name    "xn__unrealmotionSamples_06a"
                label   "Motion Samples"
                type    int
                size    1
                default { 16 }
                range   { 1! 64 }
                help    "Sub-frames per frame. Path Tracer samples and realtime warmup frames are divided between them; too few show discrete copies of fast objects."
                parmtag { "spare_category" "Motion Blur" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealmotionSamples_control_1kb == block } { xn__unrealmotionSamples_control_1kb == none } { xn__unrealmotionBlur_41a == 0 })"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessMotionBlurAmount_control_u7bl", "Amount", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessMotionBlurAmount_tubl"
                label   "Amount"
                type    float
                size    1
                default { 0.5 }
                range   { 0! 1! }
                help    "Strength of motion blur, 0:off"
                parmtag { "spare_category" "Rendering Features|Motion Blur" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessMotionBlurAmount_control_u7bl == block } { xn__unrealpostProcessMotionBlurAmount_control_u7bl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessMotionBlurMax_control_y2bl", "Max", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessMotionBlurMax_xpbl"
                label   "Max"
                type    float
                size    1
                default { 5 }
                range   { 0! 100! }
                help    "max distortion caused by motion blur, in percent of the screen width, 0:off"
                parmtag { "spare_category" "Rendering Features|Motion Blur" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessMotionBlurMax_control_y2bl == block } { xn__unrealpostProcessMotionBlurMax_control_y2bl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessMotionBlurTargetFPS_control_qdcl", "Target FPS", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessMotionBlurTargetFPS_pzbl"
                label   "Target FPS"
                type    int
                size    1
                default { 30 }
                range   { 0! 120! }
                help    "Defines the target FPS for motion blur. Makes motion blur independent of actual frame rate and relative to the specified target FPS instead. Higher target FPS results in shorter frames, which means shorter shutter times and less motion blur. Lower FPS means more motion blur. A value of zero makes the motion blur dependent on the actual frame rate."
                parmtag { "spare_category" "Rendering Features|Motion Blur" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealpostProcessMotionBlurTargetFPS_control_qdcl == block } { xn__unrealpostProcessMotionBlurTargetFPS_control_qdcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessMotionBlurPerObjectSize_control_8jcl", "Per Object Size", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessMotionBlurPerObjectSize_75bl"
                label   "Per Object Size"
                type    float
                size    1
                default { 0 }
                range   { 0! 100 }
                help    "The minimum projected screen radius for a primitive to be drawn in the velocity pass, percentage of screen width. smaller numbers cause more draw calls, default: 4%"
                parmtag { "spare_category" "Rendering Features|Motion Blur" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessMotionBlurPerObjectSize_control_8jcl == block } { xn__unrealpostProcessMotionBlurPerObjectSize_control_8jcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
        }

        groupcollapsible {
            name "hdUE_RenderingFeatures_MegaLights"
            label "MegaLights"
            grouptag { "group_default" "0" }
            grouptag { "sidefx::header_toggle" "xn__unrealpostProcessbMegaLights_ombl" }
            disablewhentab "{ xn__unrealpostProcessbMegaLights_ombl == 0 }"
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            HDUE_CONTROL_HIDE("xn__unrealpostProcessbMegaLights_control_pzbl", "MegaLights", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessbMegaLights_ombl"
                label   "MegaLights"
                type    toggle
                size    1
                default { 1 }
                help    "Allows forcing MegaLights on or off for this volume, regardless of the project setting for MegaLights. MegaLights will stochastically sample lights, which allows many shadow casting lights to be rendered efficiently, with a consistent and low GPU cost. When MegaLights is enabled, other direct lighting algorithms like Deferred Shading will no longer be used, and other shadowing methods like Ray Traced Shadows, Distance Field Shadows and Shadow Maps will no longer be used. MegaLights requires Hardware Ray Tracing and Shader Model 6."
                parmtag { "spare_category" "Rendering Features" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessbMegaLights_control_pzbl == block } { xn__unrealpostProcessbMegaLights_control_pzbl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessMegaLightsFrontLayerTranslucency_control_wycl", "MegaLights - High Quality Translucency", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessMegaLightsFrontLayerTranslucency_vlcl"
                label   "MegaLights - High Quality Translucency"
                type    toggle
                size    1
                default { 0 }
                help    "Whether to use high quality direct lighting on the front layer of translucent surfaces. Other layers will use the lower quality Translucency Lighting Volume. Increases GPU cost when enabled."
                parmtag { "spare_category" "Rendering Features" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessMegaLightsFrontLayerTranslucency_control_wycl == block } { xn__unrealpostProcessMegaLightsFrontLayerTranslucency_control_wycl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrMegaLightsNumSamplesPerPixel_control_micebk", "Samples per Pixel", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrMegaLightsNumSamplesPerPixel_l4bebk"
                label   "Samples per Pixel"
                type    int
                size    1
                default { 4 }
                menu { "2" "2" "4" "4" "8" "8" "16" "16" }
                help    "Number of samples per downsampled pixel for the opaque lighting pass. Final number of samples depends also on the downsampling mode. Supported values: 1, 2 and 4. Console variable r.MegaLights.NumSamplesPerPixel (process-wide)."
                parmtag { "spare_category" "MegaLights" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrMegaLightsNumSamplesPerPixel_control_micebk == block } { xn__unrealcvarrMegaLightsNumSamplesPerPixel_control_micebk == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealcvarrMegaLightsDefaultShadowMethod_control_8jcebk", "Default Shadow Method", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealcvarrMegaLightsDefaultShadowMethod_75bebk"
                label   "Default Shadow Method"
                type    int
                size    1
                default { 0 }
                menu { "0" "Ray Tracing" "1" "Virtual Shadow Maps" }
                help    "The default shadowing method for MegaLights, unless over-ridden on the light component. 0 - Ray Tracing. Preferred method, which guarantees fixed MegaLights cost and correct area shadows, but is dependent on the BVH representation quality. 1 - Virtual Shadow Maps. Has a significant per light cost, but can cast shadows directly from the Nanite geometry using rasterization. Console variable r.MegaLights.DefaultShadowMethod (process-wide)."
                parmtag { "spare_category" "MegaLights" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__unrealcvarrMegaLightsDefaultShadowMethod_control_8jcebk == block } { xn__unrealcvarrMegaLightsDefaultShadowMethod_control_8jcebk == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_RenderingFeatures_AmbientCubemap"
            label "Ambient Cubemap"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientCubemapTint_control_3bcl", "Tint", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientCubemapTint_2xbl"
                label   "Tint"
                type    color
                size    3
                default { 1 1 1 }
                help    "AmbientCubemap tint color"
                parmtag { "spare_category" "Rendering Features|Ambient Cubemap" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__unrealpostProcessAmbientCubemapTint_control_3bcl == block } { xn__unrealpostProcessAmbientCubemapTint_control_3bcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientCubemapIntensity_control_8jcl", "Intensity", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientCubemapIntensity_75bl"
                label   "Intensity"
                type    float
                size    1
                default { 1 }
                range   { 0! 4 }
                help    "To scale the Ambient cubemap brightness >=0: off, 1(default), >1 brighter"
                parmtag { "spare_category" "Rendering Features|Ambient Cubemap" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAmbientCubemapIntensity_control_8jcl == block } { xn__unrealpostProcessAmbientCubemapIntensity_control_8jcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientCubemap_control_l4bl", "Cubemap Texture", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientCubemap_krbl"
                label   "Cubemap Texture"
                type    file
                size    1
                default { "" }
                help    "The Ambient cubemap (Affects diffuse and specular shading), blends additively which if different from all other settings here. An image file, imported at render time (a lat-long panorama, made a cubemap as UE imports one), or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Rendering Features|Ambient Cubemap" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                parmtag { "usdvaluetype" "asset" }
                disablewhen R"({ xn__unrealpostProcessAmbientCubemap_control_l4bl == block } { xn__unrealpostProcessAmbientCubemap_control_l4bl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
        }

        groupcollapsible {
            name "hdUE_RenderingFeatures_AmbientOcclusion"
            label "Ambient Occlusion"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__unrealrenderMode_41a != realtime }"
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientOcclusionIntensity_control_incl", "Intensity", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientOcclusionIntensity_h9bl"
                label   "Intensity"
                type    float
                size    1
                default { 0.5 }
                range   { 0! 1! }
                help    "0..1 0=off/no ambient occlusion .. 1=strong ambient occlusion, defines how much it affects the non direct lighting after base pass"
                parmtag { "spare_category" "Rendering Features|Ambient Occlusion" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAmbientOcclusionIntensity_control_incl == block } { xn__unrealpostProcessAmbientOcclusionIntensity_control_incl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientOcclusionRadius_control_micl", "Radius", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientOcclusionRadius_l4bl"
                label   "Radius"
                type    float
                size    1
                default { 200 }
                range   { 0.1! 500 }
                help    ">0, in unreal units, bigger values means even distant surfaces affect the ambient occlusion"
                parmtag { "spare_category" "Rendering Features|Ambient Occlusion" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAmbientOcclusionRadius_control_micl == block } { xn__unrealpostProcessAmbientOcclusionRadius_control_micl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientOcclusionStaticFraction_control_nvcl", "Static Fraction", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientOcclusionStaticFraction_micl"
                label   "Static Fraction"
                type    float
                size    1
                default { 1 }
                range   { 0! 1! }
                help    "0..1 0=no effect on static lighting .. 1=AO affects the stat lighting, 0 is free meaning no extra rendering pass"
                parmtag { "spare_category" "Rendering Features|Ambient Occlusion" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAmbientOcclusionStaticFraction_control_nvcl == block } { xn__unrealpostProcessAmbientOcclusionStaticFraction_control_nvcl == none })"
                hidewhen "{ xn__unrealrenderMode_41a != realtime }"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 }" }
            }
            HDUE_CONTROL_HIDE("xn__unrealpostProcessAmbientOcclusionRadiusInWS_control_4ocl", "Radius in WorldSpace", "{ xn__unrealrenderMode_41a != realtime }")
            parm {
                name    "xn__unrealpostProcessAmbientOcclusionRadiusInWS_3bcl"
                label   "Radius in WorldSpace"
                type    toggle
                size    1
                default { 0 }
                help    "true: AO radius is in world space units, false: AO radius is locked the view space in 400 units"
                parmtag { "spare_category" "Rendering Features|Ambient Occlusion" }
                parmtag { "usdvaluetype" "bool" }
