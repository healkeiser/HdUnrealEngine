                    size    1
                    default { "" }
                    help    "Texture to replace default convolution bloom kernel. An image file, imported at render time, or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "filechooser_mode" "read" }
                    parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                    parmtag { "usdvaluetype" "asset" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionTexture_control_8jcl == block } { xn__unrealpostProcessBloomConvolutionTexture_control_8jcl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomConvolutionSize_control_dfcl", "Scale")
                parm {
                    name    "xn__unrealpostProcessBloomConvolutionSize_c1bl"
                    label   "Scale"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1 }
                    help    "Relative size of the convolution kernel image compared to the minor axis of the viewport"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionSize_control_dfcl == block } { xn__unrealpostProcessBloomConvolutionSize_control_dfcl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomConvolutionCenterUV_control_vlcl", "Center")
                parm {
                    name    "xn__unrealpostProcessBloomConvolutionCenterUV_u7bl"
                    label   "Center"
                    type    float
                    size    2
                    default { 0.5 0.5 }
                    help    "The UV location of the center of the kernel. Should be very close to (.5,.5)"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float2" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionCenterUV_control_vlcl == block } { xn__unrealpostProcessBloomConvolutionCenterUV_control_vlcl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomConvolutionPreFilterMin_control_escl", "Boost Min")
                parm {
                    name    "xn__unrealpostProcessBloomConvolutionPreFilterMin_dfcl"
                    label   "Boost Min"
                    type    float
                    size    1
                    default { 7 }
                    help    "Boost intensity of select pixels prior to computing bloom convolution (Min, Max, Multiplier). Max < Min disables"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionPreFilterMin_control_escl == block } { xn__unrealpostProcessBloomConvolutionPreFilterMin_control_escl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomConvolutionPreFilterMax_control_escl", "Boost Max")
                parm {
                    name    "xn__unrealpostProcessBloomConvolutionPreFilterMax_dfcl"
                    label   "Boost Max"
                    type    float
                    size    1
                    default { 15000 }
                    help    "Boost intensity of select pixels prior to computing bloom convolution (Min, Max, Multiplier). Max < Min disables"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionPreFilterMax_control_escl == block } { xn__unrealpostProcessBloomConvolutionPreFilterMax_control_escl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomConvolutionPreFilterMult_control_0tcl", "Boost Mult")
                parm {
                    name    "xn__unrealpostProcessBloomConvolutionPreFilterMult_zgcl"
                    label   "Boost Mult"
                    type    float
                    size    1
                    default { 15 }
                    help    "Boost intensity of select pixels prior to computing bloom convolution (Min, Max, Multiplier). Max < Min disables"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionPreFilterMult_control_0tcl == block } { xn__unrealpostProcessBloomConvolutionPreFilterMult_control_0tcl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
                HDUE_CONTROL("xn__unrealpostProcessBloomConvolutionBufferScale_control_rqcl", "Buffer")
                parm {
                    name    "xn__unrealpostProcessBloomConvolutionBufferScale_qdcl"
                    label   "Buffer"
                    type    float
                    size    1
                    default { 0.133 }
                    range   { 0! 1 }
                    help    "Implicit buffer region as a fraction of the screen size to insure the bloom does not wrap across the screen. Larger sizes have perf impact."
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__unrealpostProcessBloomConvolutionBufferScale_control_rqcl == block } { xn__unrealpostProcessBloomConvolutionBufferScale_control_rqcl == none } { xn__unrealtonemapper_41a == 0 })"
                    parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
                }
            }
        }

        groupcollapsible {
            name "hdUE_Lens_Exposure"
            label "Exposure"
            grouptag { "group_default" "1" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureMethod_control_3bcl", "Metering Mode")
            parm {
                name    "xn__unrealpostProcessAutoExposureMethod_2xbl"
                label   "Metering Mode"
                type    string
                size    1
                default { "AEM_Manual" }
                menu { "AEM_Histogram" "Auto Exposure Histogram" "AEM_Basic" "Auto Exposure Basic" "AEM_Manual" "Manual" }
                help    "Luminance computation method. hdUE renders with manual exposure, so the tone curve keeps the linear image's middle grey; Histogram or Basic turn on UE's auto exposure."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureMethod_control_3bcl == block } { xn__unrealpostProcessAutoExposureMethod_control_3bcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureApplyPhysicalCameraExposure_control_bbdl", "Apply Physical Camera Exposure")
            parm {
                name    "xn__unrealpostProcessAutoExposureApplyPhysicalCameraExposure_9wcl"
                label   "Apply Physical Camera Exposure"
                type    toggle
                size    1
                default { 0 }
                help    "Enables physical camera exposure using ShutterSpeed/ISO/Aperture."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureApplyPhysicalCameraExposure_control_bbdl == block } { xn__unrealpostProcessAutoExposureApplyPhysicalCameraExposure_control_bbdl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureBiasCurve_control_zgcl", "Exposure Compensation Curve")
            parm {
                name    "xn__unrealpostProcessAutoExposureBiasCurve_y2bl"
                label   "Exposure Compensation Curve"
                type    string
                size    1
                default { "" }
                help    "Exposure compensation based on the scene EV100. Used to calibrate the final exposure differently depending on the average scene luminance. 0: no adjustment, -1:2x darker, -2:4x darker, 1:2x brighter, 2:4x brighter, ... Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureBiasCurve_control_zgcl == block } { xn__unrealpostProcessAutoExposureBiasCurve_control_zgcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureMeterMask_control_zgcl", "Exposure Metering Mask")
            parm {
                name    "xn__unrealpostProcessAutoExposureMeterMask_y2bl"
                label   "Exposure Metering Mask"
                type    file
                size    1
                default { "" }
                help    "Exposure metering mask. Bright spots on the mask will have high influence on auto-exposure metering and dark spots will have low influence. An image file, imported at render time, or the path of a cooked texture in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.exr *.hdr *.png *.jpg *.jpeg *.tif *.tiff *.tga *.bmp" }
                parmtag { "usdvaluetype" "asset" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureMeterMask_control_zgcl == block } { xn__unrealpostProcessAutoExposureMeterMask_control_zgcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureMinBrightness_control_incl", "Min Brightness")
            parm {
                name    "xn__unrealpostProcessAutoExposureMinBrightness_h9bl"
                label   "Min Brightness"
                type    float
                size    1
                default { 0.03 }
                range   { -10! 20 }
                help    "Auto-Exposure minimum adaptation. Eye Adaptation is disabled if Min = Max. Auto-exposure is implemented by choosing an exposure value for which the average luminance generates a pixel brightness equal to the Constant Calibration value. The Min/Max are expressed in pixel luminance (cd/m2) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureMinBrightness_control_incl == block } { xn__unrealpostProcessAutoExposureMinBrightness_control_incl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureMaxBrightness_control_incl", "Max Brightness")
            parm {
                name    "xn__unrealpostProcessAutoExposureMaxBrightness_h9bl"
                label   "Max Brightness"
                type    float
                size    1
                default { 8 }
                range   { -10! 20 }
                help    "Auto-Exposure maximum adaptation. Eye Adaptation is disabled if Min = Max. Auto-exposure is implemented by choosing an exposure value for which the average luminance generates a pixel brightness equal to the Constant Calibration value. The Min/Max are expressed in pixel luminance (cd/m2) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureMaxBrightness_control_incl == block } { xn__unrealpostProcessAutoExposureMaxBrightness_control_incl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureSpeedUp_control_qdcl", "Speed Up")
            parm {
                name    "xn__unrealpostProcessAutoExposureSpeedUp_pzbl"
                label   "Speed Up"
                type    float
                size    1
                default { 3 }
                range   { 0.02! 20 }
                help    ">0. Unless a speed is set, auto exposure reaches its target in every frame; set, the realtime viewport adapts at this speed (husk and Path Tracer renders always use the target)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureSpeedUp_control_qdcl == block } { xn__unrealpostProcessAutoExposureSpeedUp_control_qdcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureSpeedDown_control_zgcl", "Speed Down")
            parm {
                name    "xn__unrealpostProcessAutoExposureSpeedDown_y2bl"
                label   "Speed Down"
                type    float
                size    1
                default { 1 }
                range   { 0.02! 20 }
                help    ">0. Unless a speed is set, auto exposure reaches its target in every frame; set, the realtime viewport adapts at this speed (husk and Path Tracer renders always use the target)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureSpeedDown_control_zgcl == block } { xn__unrealpostProcessAutoExposureSpeedDown_control_zgcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureLowPercent_control_micl", "Low Percent")
            parm {
                name    "xn__unrealpostProcessAutoExposureLowPercent_l4bl"
                label   "Low Percent"
                type    float
                size    1
                default { 10 }
                range   { 0! 100! }
                help    "The eye adaptation will adapt to a value extracted from the luminance histogram of the scene color. The value is defined as having x percent below this brightness. Higher values give bright spots on the screen more priority but can lead to less stable results. Lower values give the medium and darker values more priority but might cause burn out of bright spots. >0, <100, good values are in the range 70 .. 80"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureLowPercent_control_micl == block } { xn__unrealpostProcessAutoExposureLowPercent_control_micl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessAutoExposureHighPercent_control_8jcl", "High Percent")
            parm {
                name    "xn__unrealpostProcessAutoExposureHighPercent_75bl"
                label   "High Percent"
                type    float
                size    1
                default { 90 }
                range   { 0! 100! }
                help    "The eye adaptation will adapt to a value extracted from the luminance histogram of the scene color. The value is defined as having x percent below this brightness. Higher values give bright spots on the screen more priority but can lead to less stable results. Lower values give the medium and darker values more priority but might cause burn out of bright spots. >0, <100, good values are in the range 80 .. 95"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessAutoExposureHighPercent_control_8jcl == block } { xn__unrealpostProcessAutoExposureHighPercent_control_8jcl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessHistogramLogMin_control_75bl", "Histogram Log Min")
            parm {
                name    "xn__unrealpostProcessHistogramLogMin_6sbl"
                label   "Histogram Log Min"
                type    float
                size    1
                default { -8 }
                range   { -16 0 }
                help    "Histogram Min value. Expressed in Log2(Luminance) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessHistogramLogMin_control_75bl == block } { xn__unrealpostProcessHistogramLogMin_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
            HDUE_CONTROL("xn__unrealpostProcessHistogramLogMax_control_75bl", "Histogram Log Max")
            parm {
                name    "xn__unrealpostProcessHistogramLogMax_6sbl"
                label   "Histogram Log Max"
                type    float
                size    1
                default { 4 }
                range   { 0 16 }
                help    "Histogram Max value. Expressed in Log2(Luminance) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__unrealpostProcessHistogramLogMax_control_75bl == block } { xn__unrealpostProcessHistogramLogMax_control_75bl == none } { xn__unrealtonemapper_41a == 0 })"
                parmtag { "hdue::essential_hidewhen" "{ hdue_show == 0 } { hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            }
        }

        groupcollapsible {
            name "hdUE_Lens_ChromaticAberration"
            label "Chromatic Aberration"
            grouptag { "group_default" "0" }
            grouptag { "hdue::essential_hidewhen" "{ hdue_show == 0 xn__unrealtonemapper_41a == 0 }" }
            HDUE_CONTROL("xn__unrealpostProcessSceneFringeIntensity_control_dfcl", "Intensity")
            parm {
                name    "xn__unrealpostProcessSceneFringeIntensity_c1bl"
                label   "Intensity"
                type    float
                size    1
                default { 0 }
                range   { 0 5 }
                help    "in percent, Scene chromatic aberration / color fringe (camera imperfection) to simulate an artifact that happens in real-world lens, mostly visible in the image corners."
                parmtag { "spare_category" "Lens|Chromatic Aberration" }
                parmtag { "usdvaluetype" "float" }
