/// hdUE geometry settings, authored as unreal:* attributes on Mesh, Xform or Scope prims.
/// With the delegate registered, Render Geometry Settings LOPs show them on an "Unreal Engine" tab.

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"

/// A setting's USD control menu, with the operations of the setting's usdvaluetype (as Karma's).
#define HDUE_CONTROL(NAME, LABEL) \
    parm { \
        name    NAME \
        label   LABEL \
        type    string \
        default { "none" } \
        menujoin { \
            [ "import loputils" ] \
            [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ] \
            [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ] \
            language python \
        } \
        help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's." \
        parmtag { "sidefx::look" "icon" } \
    }

{
    name        "hdUE"
    label       "Unreal Engine"
    parmtag     { spare_opfilter        "!!SHOP/PROPERTIES!!" }
    parmtag     { spare_classtags       "render" }

    HDUE_CONTROL("xn__unrealasset_control_06a", "Native Asset")
    parm {
        name    "xn__unrealasset_zta"
        label   "Native Asset"
        type    string
        size    1
        default { "" }
        help    "Cooked UE object this prim stands for: a StaticMesh, SkeletalMesh, Actor Blueprint or Level, as an object path (/Game/HdUE/SM_Nanite.SM_Nanite). It renders in place of the prim's own geometry."
        parmtag { "spare_category" "Native Asset" }
        parmtag { "usdvaluetype" "string" }
        disablewhen R"({ xn__unrealasset_control_06a == block } { xn__unrealasset_control_06a == none })"
    }
    HDUE_CONTROL("xn__unrealsurfacewetenabled_control_krbhd", "Wet Surface")
    parm {
        name    "xn__unrealsurfacewetenabled_jebhd"
        label   "Wet Surface"
        type    toggle
        size    1
        default { 0 }
        help    "Coats the bound material with a water layer, on this prim, its subsets and the meshes below it. The material must be prepared with a wet profile (-WetProfile)."
        parmtag { "spare_category" "Wet Surface" }
        parmtag { "usdvaluetype" "bool" }
        disablewhen R"({ xn__unrealsurfacewetenabled_control_krbhd == block } { xn__unrealsurfacewetenabled_control_krbhd == none })"
    }
    HDUE_CONTROL("xn__unrealsurfacewetamount_control_xpbhd", "Amount")
    parm {
        name    "xn__unrealsurfacewetamount_wcbhd"
        label   "Amount"
        type    float
        size    1
        default { 1 }
        range   { 0! 1! }
        help    "Fraction of the surface the water covers, multiplied by the mask primvar."
        parmtag { "spare_category" "Wet Surface" }
        parmtag { "usdvaluetype" "float" }
        disablewhen R"({ xn__unrealsurfacewetamount_control_xpbhd == block } { xn__unrealsurfacewetamount_control_xpbhd == none })"
    }
    HDUE_CONTROL("xn__unrealsurfacewetroughness_control_tubhd", "Roughness")
    parm {
        name    "xn__unrealsurfacewetroughness_shbhd"
        label   "Roughness"
        type    float
        size    1
        default { 0.08 }
        range   { 0! 1! }
        help    "Roughness of the water coating."
        parmtag { "spare_category" "Wet Surface" }
        parmtag { "usdvaluetype" "float" }
        disablewhen R"({ xn__unrealsurfacewetroughness_control_tubhd == block } { xn__unrealsurfacewetroughness_control_tubhd == none })"
    }
    HDUE_CONTROL("xn__unrealsurfacewetmaskPrimvar_control_2xbhd", "Mask Primvar")
    parm {
        name    "xn__unrealsurfacewetmaskPrimvar_1kbhd"
        label   "Mask Primvar"
        type    string
        size    1
        default { "" }
        help    "Float primvar of the mesh that scales the coverage, by its base name (wetness for primvars:wetness). Empty covers the whole surface."
        parmtag { "spare_category" "Wet Surface" }
        parmtag { "usdvaluetype" "token" }
        disablewhen R"({ xn__unrealsurfacewetmaskPrimvar_control_2xbhd == block } { xn__unrealsurfacewetmaskPrimvar_control_2xbhd == none })"
    }
}
