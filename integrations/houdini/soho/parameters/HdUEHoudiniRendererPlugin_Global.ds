        groupcollapsible {
            name "hdUE_PostProcessing_Film"
            label "Film"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__hdUEpostProcessTonemappingMethod_control_55bl", "Method")
            parm {
                name    "xn__hdUEpostProcessTonemappingMethod_4sbl"
                label   "Method"
                type    string
                size    1
                default { "ETonemappingMethod::Filmic" }
                menu { "ETonemappingMethod::Filmic" "Filmic" "ETonemappingMethod::StandardACES" "Standard ACES" }
                help    "Controls the method of tonemapping."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEpostProcessTonemappingMethod_control_55bl == block } { xn__hdUEpostProcessTonemappingMethod_control_55bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessFilmSlope_control_4sbl", "Slope")
            parm {
                name    "xn__hdUEpostProcessFilmSlope_3fbl"
                label   "Slope"
                type    float
                size    1
                default { 0.88 }
                range   { 0 1 }
                help    "Controls the overall steepness of the tonemapper curve. Larger values increase scene contrast and smaller values reduce contrast."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessFilmSlope_control_4sbl == block } { xn__hdUEpostProcessFilmSlope_control_4sbl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessFilmToe_control_vpbl", "Toe")
            parm {
                name    "xn__hdUEpostProcessFilmToe_ucbl"
                label   "Toe"
                type    float
                size    1
                default { 0.55 }
                range   { 0 1 }
                help    "Controls the contrast of the dark end of the tonemapper curve. Larger values increase contrast and smaller values decrease contrast."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessFilmToe_control_vpbl == block } { xn__hdUEpostProcessFilmToe_control_vpbl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessFilmShoulder_control_0xbl", "Shoulder")
            parm {
                name    "xn__hdUEpostProcessFilmShoulder_zkbl"
                label   "Shoulder"
                type    float
                size    1
                default { 0.26 }
                range   { 0 1 }
                help    "Sometimes referred to as highlight rolloff. Controls the contrast of the bright end of the tonemapper curve. Larger values increase contrast and smaller values decrease contrast."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessFilmShoulder_control_0xbl == block } { xn__hdUEpostProcessFilmShoulder_control_0xbl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessFilmBlackClip_control_nzbl", "Black clip")
            parm {
                name    "xn__hdUEpostProcessFilmBlackClip_mmbl"
                label   "Black clip"
                type    float
                size    1
                default { 0 }
                range   { 0 1 }
                help    "Lowers the toe of the tonemapper curve by this amount. Increasing this value causes more of the scene to clip to black. For most purposes, this property should remain 0"
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessFilmBlackClip_control_nzbl == block } { xn__hdUEpostProcessFilmBlackClip_control_nzbl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessFilmWhiteClip_control_nzbl", "White clip")
            parm {
                name    "xn__hdUEpostProcessFilmWhiteClip_mmbl"
                label   "White clip"
                type    float
                size    1
                default { 0.04 }
                range   { 0 1 }
                help    "Controls the height of the tonemapper curve. Raising this value can cause bright values to more quickly approach fully-saturated white."
                parmtag { "spare_category" "Film" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessFilmWhiteClip_control_nzbl == block } { xn__hdUEpostProcessFilmWhiteClip_control_nzbl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
        }

        groupcollapsible {
            name "hdUE_PostProcessing_ChromaticAberration"
            label "Chromatic Aberration"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__hdUEpostProcessSceneFringeIntensity_control_1bcl", "Intensity")
            parm {
                name    "xn__hdUEpostProcessSceneFringeIntensity_0xbl"
                label   "Intensity"
                type    float
                size    1
                default { 0 }
                range   { 0 5 }
                help    "in percent, Scene chromatic aberration / color fringe (camera imperfection) to simulate an artifact that happens in real-world lens, mostly visible in the image corners."
                parmtag { "spare_category" "Lens|Chromatic Aberration" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessSceneFringeIntensity_control_1bcl == block } { xn__hdUEpostProcessSceneFringeIntensity_control_1bcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessChromaticAberrationStartOffset_control_cscl", "Start Offset")
            parm {
                name    "xn__hdUEpostProcessChromaticAberrationStartOffset_bfcl"
                label   "Start Offset"
                type    float
                size    1
                default { 0 }
                range   { 0 1 }
                help    "A normalized distance to the center of the framebuffer where the effect takes place."
                parmtag { "spare_category" "Lens|Chromatic Aberration" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessChromaticAberrationStartOffset_control_cscl == block } { xn__hdUEpostProcessChromaticAberrationStartOffset_control_cscl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
        }

