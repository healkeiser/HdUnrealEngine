                    label   "Tone Curve Amount"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1 }
                    help    "Allow effect of Tone Curve to be reduced (Set ToneCurveAmount and ExpandGamut to 0.0 to fully disable tone curve)"
                    parmtag { "spare_category" "Color Grading|Misc" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessToneCurveAmount_control_w2bl == block } { xn__hdUEpostProcessToneCurveAmount_control_w2bl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
