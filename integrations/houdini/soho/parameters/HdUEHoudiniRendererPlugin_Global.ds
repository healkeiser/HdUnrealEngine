                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "Control the luminance curve of the shadow region. Raising or lowering this value will result brightening or darkening the mid-tones of the shadow region."
                    parmtag { "spare_category" "Color Grading|Shadows" }
                    parmtag { "usdvaluetype" "float4" }
