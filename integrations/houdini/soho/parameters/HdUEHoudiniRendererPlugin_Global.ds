            groupsimple {
                name "hdUE_PostProcessing_ColorGrading_Misc"
                label "Misc"
                HDUE_CONTROL("xn__hdUEpostProcessBlueCorrection_control_90bl", "Blue Correction")
                parm {
                    name    "xn__hdUEpostProcessBlueCorrection_8nbl"
                    label   "Blue Correction"
                    type    float
                    size    1
                    default { 0.6 }
                    range   { 0! 1! }
                    help    "Correct for artifacts with \"electric\" blues due to the ACEScg color space. Bright blue desaturates instead of going to violet."
                    parmtag { "spare_category" "Color Grading|Misc" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBlueCorrection_control_90bl == block } { xn__hdUEpostProcessBlueCorrection_control_90bl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessExpandGamut_control_ewbl", "Expand Gamut")
                parm {
                    name    "xn__hdUEpostProcessExpandGamut_djbl"
                    label   "Expand Gamut"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1 }
                    help    "Expand bright saturated colors outside the sRGB gamut to fake wide gamut rendering."
                    parmtag { "spare_category" "Color Grading|Misc" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessExpandGamut_control_ewbl == block } { xn__hdUEpostProcessExpandGamut_control_ewbl == none } { xn__hdUEtonemapper_tya == 0 })"
