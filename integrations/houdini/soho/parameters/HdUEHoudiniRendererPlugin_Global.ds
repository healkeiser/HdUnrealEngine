                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "Control the range of light and dark values in your scene. Lower values will reduce the difference between bright and dark areas while higher values will increase the difference between the bright and dark areas."
                    parmtag { "spare_category" "Color Grading|Shadows" }
