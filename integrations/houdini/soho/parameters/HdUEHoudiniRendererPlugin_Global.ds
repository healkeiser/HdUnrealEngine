                parm {
                    name    "xn__hdUEpostProcessColorGainShadows_irbl"
                    label   "Gain"
                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "This value multiplies the colors in the shadow region. Raising or lowering this value will result in brightening or darkening the affected region."
                    parmtag { "spare_category" "Color Grading|Shadows" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorGainShadows_control_j4bl == block } { xn__hdUEpostProcessColorGainShadows_control_j4bl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
