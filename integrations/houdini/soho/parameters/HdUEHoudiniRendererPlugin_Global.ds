                name    "xn__hdUEpostProcessLensFlareBokehSize_rubl"
                label   "BokehSize"
                type    float
                size    1
                default { 3 }
                range   { 0 32 }
                help    "Size of the Lens Blur (in percent of the view width) that is done with the Bokeh texture (note: performance cost is radius*radius)"
                parmtag { "spare_category" "Lens|Lens Flares" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLensFlareBokehSize_control_s7bl == block } { xn__hdUEpostProcessLensFlareBokehSize_control_s7bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
