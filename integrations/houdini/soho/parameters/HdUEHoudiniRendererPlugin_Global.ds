                HDUE_CONTROL("xn__hdUEpostProcessBloom3Tint_control_rubl", "#3 Tint")
                parm {
                    name    "xn__hdUEpostProcessBloom3Tint_qhbl"
                    label   "#3 Tint"
                    type    color
                    size    3
                    default { 0.1176 0.1176 0.1176 }
                    help    "Bloom3 tint color"
                    parmtag { "spare_category" "Lens|Bloom|Gaussian" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__hdUEpostProcessBloom3Tint_control_rubl == block } { xn__hdUEpostProcessBloom3Tint_control_rubl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloom4Tint_control_rubl", "#4 Tint")
                parm {
                    name    "xn__hdUEpostProcessBloom4Tint_qhbl"
                    label   "#4 Tint"
                    type    color
                    size    3
                    default { 0.066 0.066 0.066 }
                    help    "Bloom4 tint color"
                    parmtag { "spare_category" "Lens|Bloom|Gaussian" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__hdUEpostProcessBloom4Tint_control_rubl == block } { xn__hdUEpostProcessBloom4Tint_control_rubl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloom5Tint_control_rubl", "#5 Tint")
                parm {
                    name    "xn__hdUEpostProcessBloom5Tint_qhbl"
                    label   "#5 Tint"
                    type    color
                    size    3
                    default { 0.066 0.066 0.066 }
                    help    "Bloom5 tint color"
                    parmtag { "spare_category" "Lens|Bloom|Gaussian" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__hdUEpostProcessBloom5Tint_control_rubl == block } { xn__hdUEpostProcessBloom5Tint_control_rubl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloom6Tint_control_rubl", "#6 Tint")
                parm {
                    name    "xn__hdUEpostProcessBloom6Tint_qhbl"
                    label   "#6 Tint"
                    type    color
                    size    3
                    default { 0.061 0.061 0.061 }
                    help    "Bloom6 tint color"
                    parmtag { "spare_category" "Lens|Bloom|Gaussian" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__hdUEpostProcessBloom6Tint_control_rubl == block } { xn__hdUEpostProcessBloom6Tint_control_rubl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
            }

            groupsimple {
                name "hdUE_PostProcessing_Bloom_Convolution"
                label "Convolution"
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionIntensity_control_6jcl", "Intensity")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionIntensity_55bl"
                    label   "Intensity"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1 }
                    help    "Multiplier for Convolution bloom contributions >=0: off, 1(default), >1 brighter"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionIntensity_control_6jcl == block } { xn__hdUEpostProcessBloomConvolutionIntensity_control_6jcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionScatterDispersion_control_7wcl", "Scatter Dispersion")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionScatterDispersion_6jcl"
                    label   "Scatter Dispersion"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 20 }
                    help    "Intensity multiplier on the scatter dispersion energy of the kernel. 1.0 means exactly use the same energy as the kernel scatter dispersion."
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionScatterDispersion_control_7wcl == block } { xn__hdUEpostProcessBloomConvolutionScatterDispersion_control_7wcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionSize_control_1bcl", "Scale")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionSize_0xbl"
                    label   "Scale"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1 }
                    help    "Relative size of the convolution kernel image compared to the minor axis of the viewport"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionSize_control_1bcl == block } { xn__hdUEpostProcessBloomConvolutionSize_control_1bcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionTexture_control_xgcl", "Kernel")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionTexture_w2bl"
                    label   "Kernel"
                    type    string
                    size    1
                    default { "" }
                    help    "Texture to replace default convolution bloom kernel Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "string" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionTexture_control_xgcl == block } { xn__hdUEpostProcessBloomConvolutionTexture_control_xgcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionCenterUV_control_kicl", "Center")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionCenterUV_j4bl"
                    label   "Center"
                    type    float
                    size    2
                    default { 0.5 0.5 }
                    help    "The UV location of the center of the kernel. Should be very close to (.5,.5)"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float2" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionCenterUV_control_kicl == block } { xn__hdUEpostProcessBloomConvolutionCenterUV_control_kicl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionPreFilterMin_control_2ocl", "Boost Min")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionPreFilterMin_1bcl"
                    label   "Boost Min"
                    type    float
                    size    1
                    default { 7 }
                    help    "Boost intensity of select pixels prior to computing bloom convolution (Min, Max, Multiplier). Max < Min disables"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionPreFilterMin_control_2ocl == block } { xn__hdUEpostProcessBloomConvolutionPreFilterMin_control_2ocl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionPreFilterMax_control_2ocl", "Boost Max")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionPreFilterMax_1bcl"
                    label   "Boost Max"
                    type    float
                    size    1
                    default { 15000 }
                    help    "Boost intensity of select pixels prior to computing bloom convolution (Min, Max, Multiplier). Max < Min disables"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionPreFilterMax_control_2ocl == block } { xn__hdUEpostProcessBloomConvolutionPreFilterMax_control_2ocl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionPreFilterMult_control_pqcl", "Boost Mult")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionPreFilterMult_odcl"
                    label   "Boost Mult"
                    type    float
                    size    1
                    default { 15 }
                    help    "Boost intensity of select pixels prior to computing bloom convolution (Min, Max, Multiplier). Max < Min disables"
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionPreFilterMult_control_pqcl == block } { xn__hdUEpostProcessBloomConvolutionPreFilterMult_control_pqcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessBloomConvolutionBufferScale_control_gncl", "Buffer")
                parm {
                    name    "xn__hdUEpostProcessBloomConvolutionBufferScale_f9bl"
                    label   "Buffer"
                    type    float
                    size    1
                    default { 0.133 }
                    range   { 0! 1 }
                    help    "Implicit buffer region as a fraction of the screen size to insure the bloom does not wrap across the screen. Larger sizes have perf impact."
                    parmtag { "spare_category" "Lens|Bloom|Convolution" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomConvolutionBufferScale_control_gncl == block } { xn__hdUEpostProcessBloomConvolutionBufferScale_control_gncl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
            }
        }

        groupcollapsible {
            name "hdUE_PostProcessing_Exposure"
            label "Exposure"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureMethod_control_s7bl", "Metering Mode")
            parm {
                name    "xn__hdUEpostProcessAutoExposureMethod_rubl"
                label   "Metering Mode"
                type    string
                size    1
                default { "AEM_Manual" }
                menu { "AEM_Histogram" "Auto Exposure Histogram" "AEM_Basic" "Auto Exposure Basic" "AEM_Manual" "Manual" }
                help    "Luminance computation method. hdUE renders with manual exposure, so the tone curve keeps the linear image's middle grey; Histogram or Basic turn on UE's auto exposure."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureMethod_control_s7bl == block } { xn__hdUEpostProcessAutoExposureMethod_control_s7bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureBias_control_j4bl", "Exposure Compensation ")
            parm {
                name    "xn__hdUEpostProcessAutoExposureBias_irbl"
                label   "Exposure Compensation "
                type    float
                size    1
                default { 0 }
                range   { -15 15 }
                help    "Logarithmic adjustment for the exposure. Only used if a tonemapper is specified. 0: no adjustment, -1:2x darker, -2:4x darker, 1:2x brighter, 2:4x brighter, ... hdUE adds the USD camera exposure to it."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureBias_control_j4bl == block } { xn__hdUEpostProcessAutoExposureBias_control_j4bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureApplyPhysicalCameraExposure_control_z6cl", "Apply Physical Camera Exposure")
            parm {
                name    "xn__hdUEpostProcessAutoExposureApplyPhysicalCameraExposure_ytcl"
                label   "Apply Physical Camera Exposure"
                type    toggle
                size    1
                default { 0 }
                help    "Enables physical camera exposure using ShutterSpeed/ISO/Aperture."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureApplyPhysicalCameraExposure_control_z6cl == block } { xn__hdUEpostProcessAutoExposureApplyPhysicalCameraExposure_control_z6cl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureBiasCurve_control_odcl", "Exposure Compensation Curve")
            parm {
                name    "xn__hdUEpostProcessAutoExposureBiasCurve_nzbl"
                label   "Exposure Compensation Curve"
                type    string
                size    1
                default { "" }
                help    "Exposure compensation based on the scene EV100. Used to calibrate the final exposure differently depending on the average scene luminance. 0: no adjustment, -1:2x darker, -2:4x darker, 1:2x brighter, 2:4x brighter, ... Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureBiasCurve_control_odcl == block } { xn__hdUEpostProcessAutoExposureBiasCurve_control_odcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureMeterMask_control_odcl", "Exposure Metering Mask")
            parm {
                name    "xn__hdUEpostProcessAutoExposureMeterMask_nzbl"
                label   "Exposure Metering Mask"
                type    string
                size    1
                default { "" }
                help    "Exposure metering mask. Bright spots on the mask will have high influence on auto-exposure metering and dark spots will have low influence. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureMeterMask_control_odcl == block } { xn__hdUEpostProcessAutoExposureMeterMask_control_odcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureLowPercent_control_bfcl", "Low Percent")
            parm {
                name    "xn__hdUEpostProcessAutoExposureLowPercent_90bl"
                label   "Low Percent"
                type    float
                size    1
                default { 10 }
                range   { 0! 100! }
                help    "The eye adaptation will adapt to a value extracted from the luminance histogram of the scene color. The value is defined as having x percent below this brightness. Higher values give bright spots on the screen more priority but can lead to less stable results. Lower values give the medium and darker values more priority but might cause burn out of bright spots. >0, <100, good values are in the range 70 .. 80"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureLowPercent_control_bfcl == block } { xn__hdUEpostProcessAutoExposureLowPercent_control_bfcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureHighPercent_control_xgcl", "High Percent")
            parm {
                name    "xn__hdUEpostProcessAutoExposureHighPercent_w2bl"
                label   "High Percent"
                type    float
                size    1
                default { 90 }
                range   { 0! 100! }
                help    "The eye adaptation will adapt to a value extracted from the luminance histogram of the scene color. The value is defined as having x percent below this brightness. Higher values give bright spots on the screen more priority but can lead to less stable results. Lower values give the medium and darker values more priority but might cause burn out of bright spots. >0, <100, good values are in the range 80 .. 95"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureHighPercent_control_xgcl == block } { xn__hdUEpostProcessAutoExposureHighPercent_control_xgcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureMinBrightness_control_6jcl", "Min Brightness")
            parm {
                name    "xn__hdUEpostProcessAutoExposureMinBrightness_55bl"
                label   "Min Brightness"
                type    float
                size    1
                default { 0.03 }
                range   { -10! 20 }
                help    "Auto-Exposure minimum adaptation. Eye Adaptation is disabled if Min = Max. Auto-exposure is implemented by choosing an exposure value for which the average luminance generates a pixel brightness equal to the Constant Calibration value. The Min/Max are expressed in pixel luminance (cd/m2) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureMinBrightness_control_6jcl == block } { xn__hdUEpostProcessAutoExposureMinBrightness_control_6jcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureMaxBrightness_control_6jcl", "Max Brightness")
            parm {
                name    "xn__hdUEpostProcessAutoExposureMaxBrightness_55bl"
                label   "Max Brightness"
                type    float
                size    1
                default { 8 }
                range   { -10! 20 }
                help    "Auto-Exposure maximum adaptation. Eye Adaptation is disabled if Min = Max. Auto-exposure is implemented by choosing an exposure value for which the average luminance generates a pixel brightness equal to the Constant Calibration value. The Min/Max are expressed in pixel luminance (cd/m2) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureMaxBrightness_control_6jcl == block } { xn__hdUEpostProcessAutoExposureMaxBrightness_control_6jcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureSpeedUp_control_f9bl", "Speed Up")
            parm {
                name    "xn__hdUEpostProcessAutoExposureSpeedUp_ewbl"
                label   "Speed Up"
                type    float
                size    1
                default { 3 }
                range   { 0.02! 20 }
                help    ">0. Unless a speed is set, auto exposure reaches its target in every frame; set, the realtime viewport adapts at this speed (husk and Path Tracer renders always use the target)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureSpeedUp_control_f9bl == block } { xn__hdUEpostProcessAutoExposureSpeedUp_control_f9bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessAutoExposureSpeedDown_control_odcl", "Speed Down")
            parm {
                name    "xn__hdUEpostProcessAutoExposureSpeedDown_nzbl"
                label   "Speed Down"
                type    float
                size    1
                default { 1 }
                range   { 0.02! 20 }
                help    ">0. Unless a speed is set, auto exposure reaches its target in every frame; set, the realtime viewport adapts at this speed (husk and Path Tracer renders always use the target)."
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessAutoExposureSpeedDown_control_odcl == block } { xn__hdUEpostProcessAutoExposureSpeedDown_control_odcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessHistogramLogMin_control_w2bl", "Histogram Log Min")
            parm {
                name    "xn__hdUEpostProcessHistogramLogMin_vpbl"
                label   "Histogram Log Min"
                type    float
                size    1
                default { -8 }
                range   { -16 0 }
                help    "Histogram Min value. Expressed in Log2(Luminance) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessHistogramLogMin_control_w2bl == block } { xn__hdUEpostProcessHistogramLogMin_control_w2bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessHistogramLogMax_control_w2bl", "Histogram Log Max")
            parm {
                name    "xn__hdUEpostProcessHistogramLogMax_vpbl"
                label   "Histogram Log Max"
                type    float
                size    1
                default { 4 }
                range   { 0 16 }
                help    "Histogram Max value. Expressed in Log2(Luminance) or in EV100 when using ExtendDefaultLuminanceRange (see project settings)"
                parmtag { "spare_category" "Lens|Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessHistogramLogMax_control_w2bl == block } { xn__hdUEpostProcessHistogramLogMax_control_w2bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
        }

        groupcollapsible {
            name "hdUE_PostProcessing_ColorGrading"
            label "Color Grading"
            grouptag { "group_default" "0" }

            groupsimple {
                name "hdUE_PostProcessing_ColorGrading_Temperature"
                label "Temperature"
                HDUE_CONTROL("xn__hdUEpostProcessTemperatureType_control_w2bl", "Temperature Type")
                parm {
                    name    "xn__hdUEpostProcessTemperatureType_vpbl"
                    label   "Temperature Type"
                    type    string
                    size    1
                    default { "TEMP_WhiteBalance" }
                    menu { "TEMP_WhiteBalance" "White Balance" "TEMP_ColorTemperature" "Color Temperature" }
                    help    "Selects the type of temperature calculation. White Balance uses the Temperature value to control the virtual camera's White Balance. This is the default selection. Color Temperature uses the Temperature value to adjust the color temperature of the scene, which is the inverse of the White Balance operation."
                    parmtag { "spare_category" "Color Grading|Temperature" }
                    parmtag { "usdvaluetype" "token" }
                    disablewhen R"({ xn__hdUEpostProcessTemperatureType_control_w2bl == block } { xn__hdUEpostProcessTemperatureType_control_w2bl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessWhiteTemp_control_4sbl", "Temp")
                parm {
                    name    "xn__hdUEpostProcessWhiteTemp_3fbl"
                    label   "Temp"
                    type    float
                    size    1
                    default { 6500 }
                    range   { 1500 15000 }
                    help    "Controls the color temperature or white balance in degrees Kelvin which the scene considers as white light."
                    parmtag { "spare_category" "Color Grading|Temperature" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessWhiteTemp_control_4sbl == block } { xn__hdUEpostProcessWhiteTemp_control_4sbl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessWhiteTint_control_4sbl", "Tint")
                parm {
                    name    "xn__hdUEpostProcessWhiteTint_3fbl"
                    label   "Tint"
                    type    float
                    size    1
                    default { 0 }
                    range   { -1 1 }
                    help    "Controls the color of the scene along the magenta - green axis (orthogonal to the color temperature). This feature is equivalent to color tint in digital cameras."
                    parmtag { "spare_category" "Color Grading|Temperature" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessWhiteTint_control_4sbl == block } { xn__hdUEpostProcessWhiteTint_control_4sbl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
            }

            groupsimple {
                name "hdUE_PostProcessing_ColorGrading_Global"
                label "Global"
                HDUE_CONTROL("xn__hdUEpostProcessColorSaturation_control_w2bl", "Saturation")
                parm {
                    name    "xn__hdUEpostProcessColorSaturation_vpbl"
                    label   "Saturation"
                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "Control the intensity of the color(hue) for the entire image.Higher values will result in more vibrant colors."
                    parmtag { "spare_category" "Color Grading|Global" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorSaturation_control_w2bl == block } { xn__hdUEpostProcessColorSaturation_control_w2bl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessColorContrast_control_nzbl", "Contrast")
                parm {
                    name    "xn__hdUEpostProcessColorContrast_mmbl"
                    label   "Contrast"
                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "Control the range of light and dark values in your scene. Lower values will reduce the difference between bright and dark areas while higher values will increase the difference between the bright and dark areas."
                    parmtag { "spare_category" "Color Grading|Global" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorContrast_control_nzbl == block } { xn__hdUEpostProcessColorContrast_control_nzbl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessColorGamma_control_rubl", "Gamma")
                parm {
                    name    "xn__hdUEpostProcessColorGamma_qhbl"
                    label   "Gamma"
                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "Control the luminance curve of the scene. Raising or lowering this value will result brightening or darkening the mid-tones of the entire image."
                    parmtag { "spare_category" "Color Grading|Global" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorGamma_control_rubl == block } { xn__hdUEpostProcessColorGamma_control_rubl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessColorGain_control_4sbl", "Gain")
                parm {
                    name    "xn__hdUEpostProcessColorGain_3fbl"
                    label   "Gain"
                    type    float
                    size    4
                    default { 1 1 1 1 }
                    range   { 0 2 }
                    help    "This value multiplies the colors of the image. Raising or lowering this value will result in brightening or darkening the entire scene."
                    parmtag { "spare_category" "Color Grading|Global" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorGain_control_4sbl == block } { xn__hdUEpostProcessColorGain_control_4sbl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessColorOffset_control_ewbl", "Offset")
                parm {
                    name    "xn__hdUEpostProcessColorOffset_djbl"
                    label   "Offset"
                    type    float
                    size    4
                    default { 0 0 0 0 }
                    range   { -1 1 }
                    help    "This value is added to the colors of the scene. Raising or lowering this value will result in the image being more or less washed-out."
                    parmtag { "spare_category" "Color Grading|Global" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorOffset_control_ewbl == block } { xn__hdUEpostProcessColorOffset_control_ewbl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
            }

            groupsimple {
                name "hdUE_PostProcessing_ColorGrading_Shadows"
                label "Shadows"
                HDUE_CONTROL("xn__hdUEpostProcessColorSaturationShadows_control_bfcl", "Saturation")
