                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessBloomGaussianIntensity_control_bfcl == block } { xn__hdUEpostProcessBloomGaussianIntensity_control_bfcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
