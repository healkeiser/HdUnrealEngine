                label   "BokehShape"
                type    string
                size    1
                default { "" }
                help    "Defines the shape of the Bokeh when the image base lens flares are blurred, cannot be blended Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Lens Flares" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEpostProcessLensFlareBokehShape_control_f9bl == block } { xn__hdUEpostProcessLensFlareBokehShape_control_f9bl == none } { xn__hdUEtonemapper_tya == 0 })"
