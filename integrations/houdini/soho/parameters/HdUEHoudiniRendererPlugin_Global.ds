            parm {
                name    "xn__hdUEpostProcessLensFlareThreshold_rubl"
                label   "Threshold"
                type    float
                size    1
                default { 8 }
                range   { 0.1 32 }
                help    "Minimum brightness the lens flare starts having effect (this should be as high as possible to avoid the performance cost of blurring content that is too dark too see)"
                parmtag { "spare_category" "Lens|Lens Flares" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLensFlareThreshold_control_s7bl == block } { xn__hdUEpostProcessLensFlareThreshold_control_s7bl == none } { xn__hdUEtonemapper_tya == 0 })"
