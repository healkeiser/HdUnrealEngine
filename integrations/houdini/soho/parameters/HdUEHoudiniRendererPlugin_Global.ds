                    parmtag { "spare_category" "Color Grading|Highlights" }
                    parmtag { "usdvaluetype" "float4" }
                    disablewhen R"({ xn__hdUEpostProcessColorOffsetHighlights_control_odcl == block } { xn__hdUEpostProcessColorOffsetHighlights_control_odcl == none } { xn__hdUEtonemapper_tya == 0 })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessColorCorrectionHighlightsMin_control_2ocl", "HighlightsMin")
                parm {
                    name    "xn__hdUEpostProcessColorCorrectionHighlightsMin_1bcl"
                    label   "HighlightsMin"
                    type    float
                    size    1
                    default { 0.5 }
                    range   { -1 1 }
                    help    "This value sets the lower threshold for what is considered to be the highlight region of the image."
                    parmtag { "spare_category" "Color Grading|Highlights" }
                    parmtag { "usdvaluetype" "float" }
