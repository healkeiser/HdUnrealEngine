            grouptag { "group_default" "1" }
            HDUE_CONTROL("xn__hdUEcvarrAntiAliasingMethod_control_0xbeb", "Anti-Aliasing Method")
            parm {
                name    "xn__hdUEcvarrAntiAliasingMethod_zkbeb"
                label   "Anti-Aliasing Method"
                type    int
                size    1
                default { 4 }
                menu { "0" "None" "1" "FXAA" "2" "TAA" "4" "TSR" }
                help    "Engine default (project setting) for AntiAliasingMethod is (postprocess volume/camera/game setting still can override) 0: off (no anti-aliasing) 1: Fast Approximate Anti-Aliasing (FXAA) 2: Temporal Anti-Aliasing (TAA) 3: Multisample Anti-Aliasing (MSAA, Only available on the desktop forward renderer) 4: Temporal Super-Resolution (TSR, Default) 5: Subpixel Morphological Anti-Aliasing (SMAA) Console variable r.AntiAliasingMethod (process-wide)."
                parmtag { "spare_category" "Resolution and Anti-Aliasing" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEcvarrAntiAliasingMethod_control_0xbeb == block } { xn__hdUEcvarrAntiAliasingMethod_control_0xbeb == none })"
            }
            HDUE_CONTROL("xn__hdUEcvarrScreenPercentage_control_rubeb", "Screen Percentage")
            parm {
                name    "xn__hdUEcvarrScreenPercentage_qhbeb"
                label   "Screen Percentage"
                type    float
                size    1
                default { 100 }
                range   { 10! 200! }
                help    "To render in lower resolution and upscale for better performance (combined up with the blenable post process setting). 70 is a good value for low aliasing and performance, can be verified with 'show TestImage' in percent, >0 and <=100, larger numbers are possible (supersampling) but the downsampling quality is improvable.<=0 compute the screen percentage is determined by r.ScreenPercentage.Default cvars. Console variable r.ScreenPercentage (process-wide)."
                parmtag { "spare_category" "Resolution and Anti-Aliasing" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEcvarrScreenPercentage_control_rubeb == block } { xn__hdUEcvarrScreenPercentage_control_rubeb == none })"
            }
            HDUE_CONTROL("xn__hdUEcvarrHdUEInteractiveResolution_control_f9bebe", "Lower Resolution While Moving")
            parm {
                name    "xn__hdUEcvarrHdUEInteractiveResolution_ewbebe"
                label   "Lower Resolution While Moving"
                type    toggle
                size    1
                default { 1 }
                help    "Interactive hosts (Houdini's viewport): render at Moving Screen Percentage while the camera or scene changes, and at full Screen Percentage 250 ms after the last change. Realtime mode only. Console variable r.HdUE.InteractiveResolution (process-wide)."
                parmtag { "spare_category" "Resolution and Anti-Aliasing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEcvarrHdUEInteractiveResolution_control_f9bebe == block } { xn__hdUEcvarrHdUEInteractiveResolution_control_f9bebe == none })"
            }
            HDUE_CONTROL("xn__hdUEcvarrHdUEInteractiveScreenPercentage_control_6jcebe", "Moving Screen Percentage")
            parm {
                name    "xn__hdUEcvarrHdUEInteractiveScreenPercentage_55bebe"
                label   "Moving Screen Percentage"
                type    float
                size    1
                default { 50 }
                range   { 10! 100! }
                help    "Screen percentage while moving, upsampled by the anti-aliasing method (TSR by default). Console variable r.HdUE.InteractiveScreenPercentage (process-wide)."
                parmtag { "spare_category" "Resolution and Anti-Aliasing" }
                parmtag { "usdvaluetype" "float" }
