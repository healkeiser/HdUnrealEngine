/// hdUE render settings, authored as hdUE:* attributes on a UsdRenderSettings prim.
/// With the delegate registered, Render Settings LOPs show them on an "Unreal Engine" tab, in
/// tabs of collapsible sections like Karma's. Parameter names encode the attribute names: keep them.
/// The UE post-process properties and Engine Quality are generated from the engine source by
/// scripts/generate_render_settings.py into the generated blocks: edit the script, not the blocks.
/// scripts/build_render_settings_hda.py builds the hdUE Render Settings LOP from these tabs.

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"

/// A setting's USD control menu, with the operations of the setting's usdvaluetype (as Karma's).
#define HDUE_CONTROL(NAME, LABEL) \
    parm { \
        name    NAME \
        label   LABEL \
        type    string \
        default { "none" } \
        menujoin { \
            [ "import loputils" ] \
            [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ] \
            [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ] \
            language python \
        } \
        help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's." \
        parmtag { "sidefx::look" "icon" } \
    }

/// Same, hidden with its parameter (a setting that applies to one render mode only).
#define HDUE_CONTROL_HIDE(NAME, LABEL, HIDE) \
    parm { \
        name    NAME \
        label   LABEL \
        type    string \
        default { "none" } \
        menujoin { \
            [ "import loputils" ] \
            [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ] \
            [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ] \
            language python \
        } \
        help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's." \
        parmtag { "sidefx::look" "icon" } \
        hidewhen HIDE \
    }

{
    name        "hdUE"
    label       "Unreal Engine"
    parmtag     { spare_opfilter        "!!SHOP/PROPERTIES!!" }
    parmtag     { spare_classtags       "render" }

    group {
        name "hdUE_RenderingTab"
        label "Rendering"

        groupcollapsible {
            name "hdUE_Rendering"
            label "Rendering"
            grouptag { "group_default" "1" }

            HDUE_CONTROL("xn__hdUErenderMode_control_ucb", "Render Mode")
            parm {
                name    "xn__hdUErenderMode_tya"
                label   "Render Mode"
                type    string
                size    1
                default { "realtime" }
                menu { "realtime" "Realtime (Lumen)" "pathtraced" "Path Tracer" }
                help    "Realtime renders with UE's deferred renderer, Lumen and MegaLights, and is meant for final frames too. Path Tracer accumulates UE's reference path tracer."
                parmtag { "spare_category" "Rendering" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUErenderMode_control_ucb == block } { xn__hdUErenderMode_control_ucb == none })"
            }
            HDUE_CONTROL_HIDE("xn__hdUEwarmupFrames_control_3fb", "Warmup Frames", "{ xn__hdUErenderMode_tya == pathtraced }")
            parm {
                name    "xn__hdUEwarmupFrames_21a"
                label   "Warmup Frames"
                type    int
                size    1
                default { 16 }
                range   { 0! 256 }
                help    "Realtime frames rendered before a frame counts as converged, so Lumen and temporal effects settle. Divided between motion-blur sub-frames."
                parmtag { "spare_category" "Rendering" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEwarmupFrames_control_3fb == block } { xn__hdUEwarmupFrames_control_3fb == none })"
                hidewhen "{ xn__hdUErenderMode_tya == pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__hdUEsamplesPerPixel_control_zkb", "Path Tracer Samples", "{ xn__hdUErenderMode_tya != pathtraced }")
            parm {
                name    "xn__hdUEsamplesPerPixel_y6a"
                label   "Path Tracer Samples"
                type    int
                size    1
                default { 64 }
                range   { 1! 4096 }
                help    "Samples per pixel. Divided between motion-blur sub-frames."
                parmtag { "spare_category" "Rendering" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEsamplesPerPixel_control_zkb == block } { xn__hdUEsamplesPerPixel_control_zkb == none })"
                hidewhen "{ xn__hdUErenderMode_tya != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__hdUEdenoiser_control_l8a", "Denoiser", "{ xn__hdUErenderMode_tya != pathtraced }")
            parm {
                name    "xn__hdUEdenoiser_kva"
                label   "Denoiser"
                type    string
                size    1
                default { "off" }
                menu { "off" "Off" "oidn" "Open Image Denoise" }
                help    "Denoises the converged Path Tracer image with Houdini's Open Image Denoise (on the GPU when available), guided by albedo and normal passes. AOVs and Lumen are unaffected."
                parmtag { "spare_category" "Rendering" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEdenoiser_control_l8a == block } { xn__hdUEdenoiser_control_l8a == none })"
                hidewhen "{ xn__hdUErenderMode_tya != pathtraced }"
            }
            HDUE_CONTROL_HIDE("xn__hdUEdebugView_control_79a", "Debug View", "{ xn__hdUErenderMode_tya == pathtraced }")
            parm {
                name    "xn__hdUEdebugView_6wa"
                label   "Debug View"
                type    string
                size    1
                default { "off" }
                menu { "off" "Lit" "unlit" "Unlit" "lightingOnly" "Lighting Only" "detailLighting" "Detail Lighting" "reflections" "Reflections" "lightComplexity" "Light Complexity" "buffer:BaseColor" "Buffer: Base Color" "buffer:Metallic" "Buffer: Metallic" "buffer:Roughness" "Buffer: Roughness" "buffer:Specular" "Buffer: Specular" "buffer:WorldNormal" "Buffer: World Normal" "buffer:SceneDepth" "Buffer: Scene Depth" "buffer:ShadingModel" "Buffer: Shading Model" "nanite:Mask" "Nanite: Mask" "nanite:Triangles" "Nanite: Triangles" "nanite:Clusters" "Nanite: Clusters" "nanite:Primitives" "Nanite: Primitives" "nanite:Instances" "Nanite: Instances" "nanite:Overdraw" "Nanite: Overdraw" "lumen:Overview" "Lumen: Overview" "lumen:LumenScene" "Lumen: Lumen Scene" "lumen:SurfaceCache" "Lumen: Surface Cache" "lumen:GeometryNormals" "Lumen: Geometry Normals" "lumen:ReflectionView" "Lumen: Reflection View" "vsm:mip" "Virtual Shadow Map: Mip Level" "vsm:vpage" "Virtual Shadow Map: Virtual Page" "vsm:cache" "Virtual Shadow Map: Cached Page" }
                help    "Renders one of UE's viewport view modes instead of the lit image, as its View Mode menu does: GBuffer channels, Nanite triangles and clusters, the Lumen scene and surface cache, Virtual Shadow Map pages (with Virtual Shadow Maps on). Nanite views show Nanite meshes: the viewport's, and native Nanite assets. Buffer views are linear data; the others are display-referred, like the Unreal Tonemapper's output. Realtime beauty only: AOVs are unaffected."
                parmtag { "spare_category" "Rendering" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEdebugView_control_79a == block } { xn__hdUEdebugView_control_79a == none })"
                hidewhen "{ xn__hdUErenderMode_tya == pathtraced }"
            }
        }

        /// BEGIN generated by scripts/generate_render_settings.py: Rendering

        groupcollapsible {
            name "hdUE_Rendering_PathTracing"
            label "Path Tracing"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__hdUErenderMode_tya != pathtraced }"
            HDUE_CONTROL("xn__hdUEpostProcessPathTracingMaxBounces_control_odcl", "Max. Bounces")
            parm {
                name    "xn__hdUEpostProcessPathTracingMaxBounces_nzbl"
                label   "Max. Bounces"
                type    int
                size    1
                default { 8 }
                range   { 0! 100! }
                help    "Sets the path tracing maximum bounces. hdUE uses 8, or 16 when the scene has refractive materials, unless set."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEpostProcessPathTracingMaxBounces_control_odcl == block } { xn__hdUEpostProcessPathTracingMaxBounces_control_odcl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessPathTracingMaxPathIntensity_control_gncl", "Max Path Intensity")
            parm {
                name    "xn__hdUEpostProcessPathTracingMaxPathIntensity_f9bl"
                label   "Max Path Intensity"
                type    float
                size    1
                default { 24 }
                range   { 1! 65504! }
                help    "Sets the maximum intensity of indirect samples to reduce fireflies. Lowering this value reduces noise at the expense of accuracy. Increasing it is more accurate but may lead to more noise."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessPathTracingMaxPathIntensity_control_gncl == block } { xn__hdUEpostProcessPathTracingMaxPathIntensity_control_gncl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessPathTracingEnableEmissiveMaterials_control_uycl", "Emissive Materials")
            parm {
                name    "xn__hdUEpostProcessPathTracingEnableEmissiveMaterials_tlcl"
                label   "Emissive Materials"
                type    toggle
                size    1
                default { 1 }
                help    "Should emissive materials contribute to scene lighting?"
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEpostProcessPathTracingEnableEmissiveMaterials_control_uycl == block } { xn__hdUEpostProcessPathTracingEnableEmissiveMaterials_control_uycl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessPathTracingEnableReferenceDOF_control_pqcl", "Reference Depth Of Field")
            parm {
                name    "xn__hdUEpostProcessPathTracingEnableReferenceDOF_odcl"
                label   "Reference Depth Of Field"
                type    toggle
                size    1
                default { 1 }
                help    "Enables a reference quality depth-of-field which replaces the post-process effect. hdUE turns it on when the USD camera has depth of field."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEpostProcessPathTracingEnableReferenceDOF_control_pqcl == block } { xn__hdUEpostProcessPathTracingEnableReferenceDOF_control_pqcl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessPathTracingEnableReferenceAtmosphere_control_31cl", "Reference Atmosphere")
            parm {
                name    "xn__hdUEpostProcessPathTracingEnableReferenceAtmosphere_2ocl"
                label   "Reference Atmosphere"
                type    toggle
                size    1
                default { 0 }
                help    "Enables path tracing in the atmosphere instead of baking the sky atmosphere contribution into a skylight. Any skylight present in the scene will be automatically ignored when this is enabled."
                parmtag { "spare_category" "Path Tracing" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEpostProcessPathTracingEnableReferenceAtmosphere_control_31cl == block } { xn__hdUEpostProcessPathTracingEnableReferenceAtmosphere_control_31cl == none })"
            }

            groupsimple {
                name "hdUE_Rendering_PathTracing_LightingComponents"
                label "Lighting Components"
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeEmissive_control_tlcl", "Emissive")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeEmissive_s7bl"
                    label   "Emissive"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include directly visible emissive elements?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeEmissive_control_tlcl == block } { xn__hdUEpostProcessPathTracingIncludeEmissive_control_tlcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeDiffuse_control_6jcl", "Diffuse")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeDiffuse_55bl"
                    label   "Diffuse"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include diffuse lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeDiffuse_control_6jcl == block } { xn__hdUEpostProcessPathTracingIncludeDiffuse_control_6jcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeIndirectDiffuse_control_7wcl", "Indirect Diffuse")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeIndirectDiffuse_6jcl"
                    label   "Indirect Diffuse"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include indirect diffuse lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeIndirectDiffuse_control_7wcl == block } { xn__hdUEpostProcessPathTracingIncludeIndirectDiffuse_control_7wcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeSpecular_control_tlcl", "Specular")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeSpecular_s7bl"
                    label   "Specular"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include specular lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeSpecular_control_tlcl == block } { xn__hdUEpostProcessPathTracingIncludeSpecular_control_tlcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeIndirectSpecular_control_uycl", "Indirect Specular")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeIndirectSpecular_tlcl"
                    label   "Indirect Specular"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include indirect specular lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeIndirectSpecular_control_uycl == block } { xn__hdUEpostProcessPathTracingIncludeIndirectSpecular_control_uycl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeVolume_control_kicl", "Volume")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeVolume_j4bl"
                    label   "Volume"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include volume lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeVolume_control_kicl == block } { xn__hdUEpostProcessPathTracingIncludeVolume_control_kicl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessPathTracingIncludeIndirectVolume_control_lvcl", "Indirect Volume")
                parm {
                    name    "xn__hdUEpostProcessPathTracingIncludeIndirectVolume_kicl"
                    label   "Indirect Volume"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Should the render include volume lighting contributions?"
                    parmtag { "spare_category" "Path Tracing|Lighting Components" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessPathTracingIncludeIndirectVolume_control_lvcl == block } { xn__hdUEpostProcessPathTracingIncludeIndirectVolume_control_lvcl == none })"
                }
            }
        }
        /// END generated

        groupcollapsible {
            name "hdUE_Geometry"
            label "Geometry"
            grouptag { "group_default" "0" }

            HDUE_CONTROL("xn__hdUEsubdivisionLevel_control_mmb", "Subdivision Level")
            parm {
                name    "xn__hdUEsubdivisionLevel_l8a"
                label   "Subdivision Level"
                type    int
                size    1
                default { 2 }
                range   { 0! 5 }
                help    "Uniform refinement of catmullClark and loop meshes; each level has 4x the faces. 3 matches Karma's surfaces closely, 0 renders the cage."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEsubdivisionLevel_control_mmb == block } { xn__hdUEsubdivisionLevel_control_mmb == none })"
            }
            HDUE_CONTROL("xn__hdUErequireNanite_control_qhb", "Require Nanite")
            parm {
                name    "xn__hdUErequireNanite_p3a"
                label   "Require Nanite"
                type    toggle
                size    1
                default { 0 }
                help    "Meshes from the native asset catalog must render with Nanite (their cooked asset needs Nanite data). Meshes built from Hydra are unaffected."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUErequireNanite_control_qhb == block } { xn__hdUErequireNanite_control_qhb == none })"
            }
            HDUE_CONTROL("xn__hdUEupAxis_control_c5a", "Stage Up Axis")
            parm {
                name    "xn__hdUEupAxis_bsa"
                label   "Stage Up Axis"
                type    string
                size    1
                default { "Y" }
                menu { "Y" "Y" "Z" "Z" }
                help    "Overrides the stage's upAxis metadata."
                parmtag { "spare_category" "Geometry" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEupAxis_control_c5a == block } { xn__hdUEupAxis_control_c5a == none })"
            }
        }

        groupcollapsible {
            name "hdUE_Materials"
            label "Materials"
            grouptag { "group_default" "0" }

            HDUE_CONTROL("xn__hdUEmaterialxLibrary_control_mmb", "Cooked MaterialX Library")
            parm {
                name    "xn__hdUEmaterialxLibrary_l8a"
                label   "Cooked MaterialX Library"
                type    file
                size    1
                default { "" }
                help    "library.json of MaterialX materials cooked to UE materials (scripts/Import-MaterialX.ps1). Unset: the runtime profile's materialx_library. Houdini's viewport prepares the bound MaterialX materials from it; husk renders the Preview Surface fallback and warns."
                parmtag { "spare_category" "Materials" }
                parmtag { "filechooser_pattern" "*.json" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEmaterialxLibrary_control_mmb == block } { xn__hdUEmaterialxLibrary_control_mmb == none })"
            }
            HDUE_CONTROL("xn__hdUEsubstrateLibrary_control_mmb", "Prepared Substrate Library")
            parm {
                name    "xn__hdUEsubstrateLibrary_l8a"
                label   "Prepared Substrate Library"
                type    file
                size    1
                default { "" }
                help    "library.json of prepared Substrate materials (scripts/Prepare-Substrate.ps1). Unset: the runtime profile's substrate_library. Houdini's viewport prepares Substrate Builder materials from it; husk renders the Preview Surface fallback and warns."
                parmtag { "spare_category" "Materials" }
                parmtag { "filechooser_pattern" "*.json" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEsubstrateLibrary_control_mmb == block } { xn__hdUEsubstrateLibrary_control_mmb == none })"
            }
        }
    }

    group {
        name "hdUE_LightingTab"
        label "Lighting"

        groupcollapsible {
            name "hdUE_Lighting"
            label "Lighting"
            grouptag { "group_default" "1" }

            HDUE_CONTROL_HIDE("xn__hdUElumenEnabled_control_3fb", "Lumen", "{ xn__hdUErenderMode_tya == pathtraced }")
            parm {
                name    "xn__hdUElumenEnabled_21a"
                label   "Lumen"
                type    toggle
                size    1
                default { 1 }
                help    "Lumen global illumination and reflections in realtime mode. Per-light MegaLights is on the lights' Unreal Engine tab."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUElumenEnabled_control_3fb == block } { xn__hdUElumenEnabled_control_3fb == none })"
                hidewhen "{ xn__hdUErenderMode_tya == pathtraced }"
            }
            HDUE_CONTROL("xn__hdUEdomeResolution_control_djb", "Environment Cube Resolution")
            parm {
                name    "xn__hdUEdomeResolution_c5a"
                label   "Environment Cube Resolution"
                type    int
                size    1
                default { 512 }
                menu { "32" "32" "64" "64" "128" "128" "256" "256" "512" "512" "1024" "1024" "2048" "2048" }
                help    "Face size of the cubemap dome lights are baked into, for lighting, reflections and the background."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEdomeResolution_control_djb == block } { xn__hdUEdomeResolution_control_djb == none })"
            }
            HDUE_CONTROL("xn__hdUEautoViewerLight_control_zkb", "Light Unlit Scenes")
            parm {
                name    "xn__hdUEautoViewerLight_y6a"
                label   "Light Unlit Scenes"
                type    toggle
                size    1
                default { 1 }
                help    "Add a camera-relative key and fill light when the scene has no lights, so unlit scenes are reviewable."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEautoViewerLight_control_zkb == block } { xn__hdUEautoViewerLight_control_zkb == none })"
            }
            HDUE_CONTROL("xn__hdUEviewerLightIntensity_control_4sb", "Viewer Light Intensity")
            parm {
                name    "xn__hdUEviewerLightIntensity_3fb"
                label   "Viewer Light Intensity"
                type    float
                size    1
                default { 4 }
                range   { 0! 100! }
                help    "Intensity of the unlit-scene lights and of the viewport's headlight."
                parmtag { "spare_category" "Lighting" }
                parmtag { "uiscope" "viewport" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEviewerLightIntensity_control_4sb == block } { xn__hdUEviewerLightIntensity_control_4sb == none })"
            }
        }

        /// BEGIN generated by scripts/generate_render_settings.py: Lighting

        groupcollapsible {
            name "hdUE_Lighting_GlobalIllumination"
            label "Global Illumination"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__hdUErenderMode_tya != realtime }"
            HDUE_CONTROL("xn__hdUEpostProcessDynamicGlobalIlluminationMethod_control_ytcl", "Method")
            parm {
                name    "xn__hdUEpostProcessDynamicGlobalIlluminationMethod_xgcl"
                label   "Method"
                type    string
                size    1
                default { "EDynamicGlobalIlluminationMethod::Lumen" }
                menu { "EDynamicGlobalIlluminationMethod::None" "None" "EDynamicGlobalIlluminationMethod::Lumen" "Lumen" "EDynamicGlobalIlluminationMethod::ScreenSpace" "Screen Space (Deprecated)" "EDynamicGlobalIlluminationMethod::Plugin" "Plugin" }
                help    "Chooses the Dynamic Global Illumination method. Not compatible with Forward Shading. Overrides hdUE:lumenEnabled."
                parmtag { "spare_category" "Global Illumination" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEpostProcessDynamicGlobalIlluminationMethod_control_ytcl == block } { xn__hdUEpostProcessDynamicGlobalIlluminationMethod_control_ytcl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessIndirectLightingColor_control_odcl", "Indirect Lighting Color")
            parm {
                name    "xn__hdUEpostProcessIndirectLightingColor_nzbl"
                label   "Indirect Lighting Color"
                type    color
                size    3
                default { 1 1 1 }
                help    "Adjusts indirect lighting color. (1,1,1) is default. (0,0,0) to disable GI. The show flag 'Global Illumination' must be enabled to use this property."
                parmtag { "spare_category" "Global Illumination" }
                parmtag { "usdvaluetype" "color3f" }
                disablewhen R"({ xn__hdUEpostProcessIndirectLightingColor_control_odcl == block } { xn__hdUEpostProcessIndirectLightingColor_control_odcl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessIndirectLightingIntensity_control_6jcl", "Indirect Lighting Intensity")
            parm {
                name    "xn__hdUEpostProcessIndirectLightingIntensity_55bl"
                label   "Indirect Lighting Intensity"
                type    float
                size    1
                default { 1 }
                range   { 0! 4 }
                help    "Scales the indirect lighting contribution. A value of 0 disables GI. Default is 1. The show flag 'Global Illumination' must be enabled to use this property."
                parmtag { "spare_category" "Global Illumination" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessIndirectLightingIntensity_control_6jcl == block } { xn__hdUEpostProcessIndirectLightingIntensity_control_6jcl == none })"
            }

            groupsimple {
                name "hdUE_Lighting_GlobalIllumination_LumenGlobalIllumination"
                label "Lumen Global Illumination"
                HDUE_CONTROL("xn__hdUEpostProcessLumenRayLightingMode_control_1bcl", "Ray Lighting Mode")
                parm {
                    name    "xn__hdUEpostProcessLumenRayLightingMode_0xbl"
                    label   "Ray Lighting Mode"
                    type    string
                    size    1
                    default { "ELumenRayLightingModeOverride::Default" }
                    menu { "ELumenRayLightingModeOverride::Default" "Project Default" "ELumenRayLightingModeOverride::SurfaceCache" "Surface Cache" "ELumenRayLightingModeOverride::HitLightingForReflections" "Hit Lighting for Reflections" "ELumenRayLightingModeOverride::HitLighting" "Hit Lighting" }
                    help    "Controls how Lumen rays are lit when Lumen is using Hardware Ray Tracing. By default, Lumen uses the Surface Cache for best performance, but can be set to 'Hit Lighting' for higher quality."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "token" }
                    disablewhen R"({ xn__hdUEpostProcessLumenRayLightingMode_control_1bcl == block } { xn__hdUEpostProcessLumenRayLightingMode_control_1bcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSceneLightingQuality_control_6jcl", "Lumen Scene Lighting Quality")
                parm {
                    name    "xn__hdUEpostProcessLumenSceneLightingQuality_55bl"
                    label   "Lumen Scene Lighting Quality"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 2 }
                    help    "Scales Lumen Scene's quality. Larger scales cause Lumen Scene to be calculated with a higher fidelity, which can be visible in reflections, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSceneLightingQuality_control_6jcl == block } { xn__hdUEpostProcessLumenSceneLightingQuality_control_6jcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSceneDetail_control_j4bl", "Lumen Scene Detail")
                parm {
                    name    "xn__hdUEpostProcessLumenSceneDetail_irbl"
                    label   "Lumen Scene Detail"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 4 }
                    help    "Controls the size of instances that can be represented in Lumen Scene. Larger values will ensure small objects are represented, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSceneDetail_control_j4bl == block } { xn__hdUEpostProcessLumenSceneDetail_control_j4bl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSceneViewDistance_control_bfcl", "Lumen Scene View Distance")
                parm {
                    name    "xn__hdUEpostProcessLumenSceneViewDistance_90bl"
                    label   "Lumen Scene View Distance"
                    type    float
                    size    1
                    default { 20000 }
                    range   { 1! 2097152 }
                    help    "Sets the maximum view distance of the scene that Lumen maintains for ray tracing against. Larger values will increase the effective range of sky shadowing and Global Illumination, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSceneViewDistance_control_bfcl == block } { xn__hdUEpostProcessLumenSceneViewDistance_control_bfcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSceneLightingUpdateSpeed_control_pqcl", "Lumen Scene Lighting Update Speed")
                parm {
                    name    "xn__hdUEpostProcessLumenSceneLightingUpdateSpeed_odcl"
                    label   "Lumen Scene Lighting Update Speed"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.5! 4 }
                    help    "Controls how much Lumen Scene is allowed to cache lighting results to improve performance. Larger scales cause lighting changes to propagate faster, but increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSceneLightingUpdateSpeed_control_pqcl == block } { xn__hdUEpostProcessLumenSceneLightingUpdateSpeed_control_pqcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenFinalGatherQuality_control_xgcl", "Final Gather Quality")
                parm {
                    name    "xn__hdUEpostProcessLumenFinalGatherQuality_w2bl"
                    label   "Final Gather Quality"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 2 }
                    help    "Scales Lumen's Final Gather quality. Larger scales reduce noise, but greatly increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenFinalGatherQuality_control_xgcl == block } { xn__hdUEpostProcessLumenFinalGatherQuality_control_xgcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenFinalGatherLightingUpdateSpeed_control_h0cl", "Final Gather Lighting Update Speed")
                parm {
                    name    "xn__hdUEpostProcessLumenFinalGatherLightingUpdateSpeed_gncl"
                    label   "Final Gather Lighting Update Speed"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.5! 4 }
                    help    "Controls how much Lumen Final Gather is allowed to cache lighting results to improve performance. Larger scales cause lighting changes to propagate faster, but increase GPU cost and noise."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenFinalGatherLightingUpdateSpeed_control_h0cl == block } { xn__hdUEpostProcessLumenFinalGatherLightingUpdateSpeed_control_h0cl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenFinalGatherScreenTraces_control_2ocl", "Screen Traces")
                parm {
                    name    "xn__hdUEpostProcessLumenFinalGatherScreenTraces_1bcl"
                    label   "Screen Traces"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Whether to use screen space traces for Lumen Global Illumination. Screen space traces bypass Lumen Scene and instead sample Scene Depth and Scene Color. This improves quality, as it bypasses Lumen Scene, but causes view dependent lighting."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessLumenFinalGatherScreenTraces_control_2ocl == block } { xn__hdUEpostProcessLumenFinalGatherScreenTraces_control_2ocl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenMaxTraceDistance_control_odcl", "Max Trace Distance")
                parm {
                    name    "xn__hdUEpostProcessLumenMaxTraceDistance_nzbl"
                    label   "Max Trace Distance"
                    type    float
                    size    1
                    default { 20000 }
                    range   { 1! 2097152 }
                    help    "Controls the maximum distance that Lumen should trace while solving lighting. Values that are too small will cause lighting to leak into large caves, while values that are large will increase GPU cost."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenMaxTraceDistance_control_odcl == block } { xn__hdUEpostProcessLumenMaxTraceDistance_control_odcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenDiffuseColorBoost_control_bfcl", "Diffuse Color Boost")
                parm {
                    name    "xn__hdUEpostProcessLumenDiffuseColorBoost_90bl"
                    label   "Diffuse Color Boost"
                    type    float
                    size    1
                    default { 1 }
                    range   { 1! 4! }
                    help    "Allows brightening indirect lighting by calculating material diffuse color for indirect lighting. Values above 1 (original diffuse color) aren't physically correct, but they can be useful as an art direction knob to increase the amount of bounced light in the scene. Best to keep below 2 as it also causes reflections to be brighter than the scene."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenDiffuseColorBoost_control_bfcl == block } { xn__hdUEpostProcessLumenDiffuseColorBoost_control_bfcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenAmbientOcclusionIntensity_control_cscl", "Ambient Occlusion Intensity")
                parm {
                    name    "xn__hdUEpostProcessLumenAmbientOcclusionIntensity_bfcl"
                    label   "Ambient Occlusion Intensity"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 1! }
                    help    "Allows control over the strength of Lumen's Short Range Ambient Occlusion."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenAmbientOcclusionIntensity_control_cscl == block } { xn__hdUEpostProcessLumenAmbientOcclusionIntensity_control_cscl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSkylightLeaking_control_1bcl", "Skylight Leaking")
                parm {
                    name    "xn__hdUEpostProcessLumenSkylightLeaking_0xbl"
                    label   "Skylight Leaking"
                    type    float
                    size    1
                    default { 0 }
                    range   { 0! 0.02 }
                    help    "Controls what fraction of the skylight intensity should be allowed to leak. This can be useful as an art direction knob (non-physically based) to keep indoor areas from going fully black."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSkylightLeaking_control_1bcl == block } { xn__hdUEpostProcessLumenSkylightLeaking_control_1bcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSkylightLeakingTint_control_kicl", "Skylight Leaking Tint")
                parm {
                    name    "xn__hdUEpostProcessLumenSkylightLeakingTint_j4bl"
                    label   "Skylight Leaking Tint"
                    type    color
                    size    3
                    default { 1 1 1 }
                    help    "Color tint for Lumen Skylight Leaking."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSkylightLeakingTint_control_kicl == block } { xn__hdUEpostProcessLumenSkylightLeakingTint_control_kicl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenFullSkylightLeakingDistance_control_lvcl", "Full Skylight Leaking Distance")
                parm {
                    name    "xn__hdUEpostProcessLumenFullSkylightLeakingDistance_kicl"
                    label   "Full Skylight Leaking Distance"
                    type    float
                    size    1
                    default { 1000 }
                    range   { 0.1! 2000 }
                    help    "Controls the distance from a receiving surface where skylight leaking reaches its full intensity. Smaller values make the skylight leaking flatter, while larger values create an Ambient Occlusion effect."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenFullSkylightLeakingDistance_control_lvcl == block } { xn__hdUEpostProcessLumenFullSkylightLeakingDistance_control_lvcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenSurfaceCacheResolution_control_gncl", "Lumen Surface Cache Resolution")
                parm {
                    name    "xn__hdUEpostProcessLumenSurfaceCacheResolution_f9bl"
                    label   "Lumen Surface Cache Resolution"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.5! 1! }
                    help    "Scale factor for Lumen Surface Cache resolution. Smaller values save GPU memory, at a cost in quality. Defaults to 0.5 for Scene Captures if not overridden."
                    parmtag { "spare_category" "Global Illumination|Lumen Global Illumination" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenSurfaceCacheResolution_control_gncl == block } { xn__hdUEpostProcessLumenSurfaceCacheResolution_control_gncl == none })"
                }
            }
        }

        groupcollapsible {
            name "hdUE_Lighting_Reflections"
            label "Reflections"
            grouptag { "group_default" "0" }
            hidewhentab "{ xn__hdUErenderMode_tya != realtime }"
            HDUE_CONTROL("xn__hdUEpostProcessReflectionMethod_control_j4bl", "Method")
            parm {
                name    "xn__hdUEpostProcessReflectionMethod_irbl"
                label   "Method"
                type    string
                size    1
                default { "EReflectionMethod::Lumen" }
                menu { "EReflectionMethod::None" "None" "EReflectionMethod::Lumen" "Lumen" "EReflectionMethod::ScreenSpace" "Screen Space" }
                help    "Chooses the Reflection method. Not compatible with Forward Shading. Overrides hdUE:lumenEnabled."
                parmtag { "spare_category" "Reflections" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEpostProcessReflectionMethod_control_j4bl == block } { xn__hdUEpostProcessReflectionMethod_control_j4bl == none })"
            }

            groupsimple {
                name "hdUE_Lighting_Reflections_LumenReflections"
                label "Lumen Reflections"
                HDUE_CONTROL("xn__hdUEpostProcessLumenReflectionQuality_control_bfcl", "Quality")
                parm {
                    name    "xn__hdUEpostProcessLumenReflectionQuality_90bl"
                    label   "Quality"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0.25! 2 }
                    help    "Scales the Reflection quality. Larger scales reduce noise in reflections, but increase GPU cost."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenReflectionQuality_control_bfcl == block } { xn__hdUEpostProcessLumenReflectionQuality_control_bfcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenReflectionsScreenTraces_control_2ocl", "Screen Traces")
                parm {
                    name    "xn__hdUEpostProcessLumenReflectionsScreenTraces_1bcl"
                    label   "Screen Traces"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Whether to use screen space traces for Lumen Reflections. Screen space traces bypass Lumen Scene and instead sample Scene Depth and Scene Color. This improves quality, as it bypasses Lumen Scene, but causes view dependent lighting."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessLumenReflectionsScreenTraces_control_2ocl == block } { xn__hdUEpostProcessLumenReflectionsScreenTraces_control_2ocl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenFrontLayerTranslucencyReflections_control_d5cl", "High Quality Translucency Reflections")
                parm {
                    name    "xn__hdUEpostProcessLumenFrontLayerTranslucencyReflections_cscl"
                    label   "High Quality Translucency Reflections"
                    type    toggle
                    size    1
                    default { 1 }
                    help    "Whether to use high quality mirror reflections on the front layer of translucent surfaces. Other layers will use the lower quality Radiance Cache method that can only produce glossy reflections. Increases GPU cost when enabled."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "bool" }
                    disablewhen R"({ xn__hdUEpostProcessLumenFrontLayerTranslucencyReflections_control_d5cl == block } { xn__hdUEpostProcessLumenFrontLayerTranslucencyReflections_control_d5cl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenMaxRoughnessToTraceReflections_control_h0cl", "Max Roughness To Trace")
                parm {
                    name    "xn__hdUEpostProcessLumenMaxRoughnessToTraceReflections_gncl"
                    label   "Max Roughness To Trace"
                    type    float
                    size    1
                    default { 0.4 }
                    range   { 0! 1! }
                    help    "Sets the maximum roughness value for which Lumen still traces dedicated reflection rays. Higher values improve reflection quality, but greatly increase GPU cost."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessLumenMaxRoughnessToTraceReflections_control_h0cl == block } { xn__hdUEpostProcessLumenMaxRoughnessToTraceReflections_control_h0cl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenMaxReflectionBounces_control_6jcl", "Max Reflection Bounces")
                parm {
                    name    "xn__hdUEpostProcessLumenMaxReflectionBounces_55bl"
                    label   "Max Reflection Bounces"
                    type    int
                    size    1
                    default { 1 }
                    range   { 1! 8! }
                    help    "Sets the maximum number of recursive reflection bounces. 1 means a single reflection ray (no secondary reflections in mirrors). Currently only supported by Hardware Ray Tracing with Hit Lighting."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "int" }
                    disablewhen R"({ xn__hdUEpostProcessLumenMaxReflectionBounces_control_6jcl == block } { xn__hdUEpostProcessLumenMaxReflectionBounces_control_6jcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessLumenMaxRefractionBounces_control_6jcl", "Max Refraction Bounces")
                parm {
                    name    "xn__hdUEpostProcessLumenMaxRefractionBounces_55bl"
                    label   "Max Refraction Bounces"
                    type    int
                    size    1
                    default { 0 }
                    range   { 0! 64! }
                    help    "The maximum count of refraction event to trace. When hit lighting is used, Translucent meshes will be traced when LumenMaxRefractionBounces > 0, making the reflection tracing more expenssive."
                    parmtag { "spare_category" "Reflections|Lumen Reflections" }
                    parmtag { "usdvaluetype" "int" }
                    disablewhen R"({ xn__hdUEpostProcessLumenMaxRefractionBounces_control_6jcl == block } { xn__hdUEpostProcessLumenMaxRefractionBounces_control_6jcl == none })"
                }
            }

            groupsimple {
                name "hdUE_Lighting_Reflections_ScreenSpaceReflections"
                label "Screen Space Reflections"
                HDUE_CONTROL("xn__hdUEpostProcessScreenSpaceReflectionIntensity_control_cscl", "Intensity")
                parm {
                    name    "xn__hdUEpostProcessScreenSpaceReflectionIntensity_bfcl"
                    label   "Intensity"
                    type    float
                    size    1
                    default { 100 }
                    range   { 0! 100! }
                    help    "Enable/Fade/disable the Screen Space Reflection feature, in percent, avoid numbers between 0 and 1 fo consistency"
                    parmtag { "spare_category" "Reflections|Screen Space Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessScreenSpaceReflectionIntensity_control_cscl == block } { xn__hdUEpostProcessScreenSpaceReflectionIntensity_control_cscl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessScreenSpaceReflectionQuality_control_2ocl", "Quality")
                parm {
                    name    "xn__hdUEpostProcessScreenSpaceReflectionQuality_1bcl"
                    label   "Quality"
                    type    float
                    size    1
                    default { 50 }
                    range   { 0! 100 }
                    help    "0=lowest quality..100=maximum quality, only a few quality levels are implemented, no soft transition, 50 is the default for better performance."
                    parmtag { "spare_category" "Reflections|Screen Space Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessScreenSpaceReflectionQuality_control_2ocl == block } { xn__hdUEpostProcessScreenSpaceReflectionQuality_control_2ocl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessScreenSpaceReflectionMaxRoughness_control_7wcl", "Max Roughness")
                parm {
                    name    "xn__hdUEpostProcessScreenSpaceReflectionMaxRoughness_6jcl"
                    label   "Max Roughness"
                    type    float
                    size    1
                    default { 0.6 }
                    range   { 0.01! 1! }
                    help    "Until what roughness we fade the screen space reflections, 0.8 works well, smaller can run faster"
                    parmtag { "spare_category" "Reflections|Screen Space Reflections" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessScreenSpaceReflectionMaxRoughness_control_7wcl == block } { xn__hdUEpostProcessScreenSpaceReflectionMaxRoughness_control_7wcl == none })"
                }
            }
        }

        groupcollapsible {
            name "hdUE_Lighting_RenderingFeatures"
            label "Rendering Features"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__hdUEpostProcessbMegaLights_control_ewbl", "MegaLights")
            parm {
                name    "xn__hdUEpostProcessbMegaLights_djbl"
                label   "MegaLights"
                type    toggle
                size    1
                default { 1 }
                help    "Allows forcing MegaLights on or off for this volume, regardless of the project setting for MegaLights. MegaLights will stochastically sample lights, which allows many shadow casting lights to be rendered efficiently, with a consistent and low GPU cost. When MegaLights is enabled, other direct lighting algorithms like Deferred Shading will no longer be used, and other shadowing methods like Ray Traced Shadows, Distance Field Shadows and Shadow Maps will no longer be used. MegaLights requires Hardware Ray Tracing and Shader Model 6."
                parmtag { "spare_category" "Rendering Features" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEpostProcessbMegaLights_control_ewbl == block } { xn__hdUEpostProcessbMegaLights_control_ewbl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessMegaLightsFrontLayerTranslucency_control_lvcl", "MegaLights - High Quality Translucency")
            parm {
                name    "xn__hdUEpostProcessMegaLightsFrontLayerTranslucency_kicl"
                label   "MegaLights - High Quality Translucency"
                type    toggle
                size    1
                default { 0 }
                help    "Whether to use high quality direct lighting on the front layer of translucent surfaces. Other layers will use the lower quality Translucency Lighting Volume. Increases GPU cost when enabled."
                parmtag { "spare_category" "Rendering Features" }
                parmtag { "usdvaluetype" "bool" }
                disablewhen R"({ xn__hdUEpostProcessMegaLightsFrontLayerTranslucency_control_lvcl == block } { xn__hdUEpostProcessMegaLightsFrontLayerTranslucency_control_lvcl == none })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessUserFlags_control_4sbl", "User Flags")
            parm {
                name    "xn__hdUEpostProcessUserFlags_3fbl"
                label   "User Flags"
                type    int
                size    1
                default { 0 }
                help    "Per-view user flags accessible in materials via TestPostVolumeUserFlag node, allowing per-view overrides of material behavior."
                parmtag { "spare_category" "Rendering Features" }
                parmtag { "usdvaluetype" "int" }
                disablewhen R"({ xn__hdUEpostProcessUserFlags_control_4sbl == block } { xn__hdUEpostProcessUserFlags_control_4sbl == none })"
            }

            groupsimple {
                name "hdUE_Lighting_RenderingFeatures_AmbientCubemap"
                label "Ambient Cubemap"
                HDUE_CONTROL("xn__hdUEpostProcessAmbientCubemapTint_control_s7bl", "Tint")
                parm {
                    name    "xn__hdUEpostProcessAmbientCubemapTint_rubl"
                    label   "Tint"
                    type    color
                    size    3
                    default { 1 1 1 }
                    help    "AmbientCubemap tint color"
                    parmtag { "spare_category" "Rendering Features|Ambient Cubemap" }
                    parmtag { "usdvaluetype" "color3f" }
                    disablewhen R"({ xn__hdUEpostProcessAmbientCubemapTint_control_s7bl == block } { xn__hdUEpostProcessAmbientCubemapTint_control_s7bl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessAmbientCubemapIntensity_control_xgcl", "Intensity")
                parm {
                    name    "xn__hdUEpostProcessAmbientCubemapIntensity_w2bl"
                    label   "Intensity"
                    type    float
                    size    1
                    default { 1 }
                    range   { 0! 4 }
                    help    "To scale the Ambient cubemap brightness >=0: off, 1(default), >1 brighter"
                    parmtag { "spare_category" "Rendering Features|Ambient Cubemap" }
                    parmtag { "usdvaluetype" "float" }
                    disablewhen R"({ xn__hdUEpostProcessAmbientCubemapIntensity_control_xgcl == block } { xn__hdUEpostProcessAmbientCubemapIntensity_control_xgcl == none })"
                }
                HDUE_CONTROL("xn__hdUEpostProcessAmbientCubemap_control_90bl", "Cubemap Texture")
                parm {
                    name    "xn__hdUEpostProcessAmbientCubemap_8nbl"
                    label   "Cubemap Texture"
                    type    string
                    size    1
                    default { "" }
