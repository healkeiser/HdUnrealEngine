                parm {
                    name    "xn__hdUEpostProcessColorOffsetShadows_rubl"
                    label   "Offset"
                    type    float
                    size    4
                    default { 0 0 0 0 }
                    range   { -1 1 }
                    help    "This value is added to the colors in the shadow region. Raising or lowering this value will result in the shadows being more or less washed-out."
                    parmtag { "spare_category" "Color Grading|Shadows" }
                    parmtag { "usdvaluetype" "float4" }
