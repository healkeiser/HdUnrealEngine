        groupcollapsible {
            name "hdUE_PostProcessing_LocalExposure"
            label "Local Exposure"
            grouptag { "group_default" "0" }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureMethod_control_f9bl", "Method")
            parm {
                name    "xn__hdUEpostProcessLocalExposureMethod_ewbl"
                label   "Method"
                type    string
                size    1
                default { "ELocalExposureMethod::Bilateral" }
                menu { "ELocalExposureMethod::Bilateral" "Bilateral" "ELocalExposureMethod::Fusion" "Fusion (Experimental)" }
                help    "Local Exposure algorithm"
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "token" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureMethod_control_f9bl == block } { xn__hdUEpostProcessLocalExposureMethod_control_f9bl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureHighlightContrastScale_control_h0cl", "Highlight Contrast")
            parm {
                name    "xn__hdUEpostProcessLocalExposureHighlightContrastScale_gncl"
                label   "Highlight Contrast"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Contrast of the base layer is reduced based on this value. Value less than 1 will enable local exposure. Good values are usually in the range 0.6 .. 1.0."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureHighlightContrastScale_control_h0cl == block } { xn__hdUEpostProcessLocalExposureHighlightContrastScale_control_h0cl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureShadowContrastScale_control_lvcl", "Shadow Contrast")
            parm {
                name    "xn__hdUEpostProcessLocalExposureShadowContrastScale_kicl"
                label   "Shadow Contrast"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Contrast of the base layer is reduced based on this value. Value less than 1 will enable local exposure. Good values are usually in the range 0.6 .. 1.0."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureShadowContrastScale_control_lvcl == block } { xn__hdUEpostProcessLocalExposureShadowContrastScale_control_lvcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureHighlightContrastCurve_control_h0cl", "Highlight Contrast Curve")
            parm {
                name    "xn__hdUEpostProcessLocalExposureHighlightContrastCurve_gncl"
                label   "Highlight Contrast Curve"
                type    string
                size    1
                default { "" }
                help    "Local Exposure Highlight Contrast based on the scene EV100. Used to calibrate Local Exposure differently depending on the average scene luminance. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureHighlightContrastCurve_control_h0cl == block } { xn__hdUEpostProcessLocalExposureHighlightContrastCurve_control_h0cl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureShadowContrastCurve_control_lvcl", "Shadow Contrast Curve")
            parm {
                name    "xn__hdUEpostProcessLocalExposureShadowContrastCurve_kicl"
                label   "Shadow Contrast Curve"
                type    string
                size    1
                default { "" }
                help    "Local Exposure Shadow Contrast based on the scene EV100. Used to calibrate Local Exposure differently depending on the average scene luminance. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "string" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureShadowContrastCurve_control_lvcl == block } { xn__hdUEpostProcessLocalExposureShadowContrastCurve_control_lvcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureHighlightThreshold_control_ytcl", "Highlight Threshold")
            parm {
                name    "xn__hdUEpostProcessLocalExposureHighlightThreshold_xgcl"
                label   "Highlight Threshold"
                type    float
                size    1
                default { 0 }
                range   { 0 4 }
                help    "Threshold used to determine which regions of the screen are considered highlights."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureHighlightThreshold_control_ytcl == block } { xn__hdUEpostProcessLocalExposureHighlightThreshold_control_ytcl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureShadowThreshold_control_2ocl", "Shadow Threshold")
            parm {
                name    "xn__hdUEpostProcessLocalExposureShadowThreshold_1bcl"
                label   "Shadow Threshold"
                type    float
                size    1
                default { 0 }
                range   { 0 4 }
                help    "Threshold used to determine which regions of the screen are considered shadows."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureShadowThreshold_control_2ocl == block } { xn__hdUEpostProcessLocalExposureShadowThreshold_control_2ocl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureDetailStrength_control_gncl", "Detail Strength")
            parm {
                name    "xn__hdUEpostProcessLocalExposureDetailStrength_f9bl"
                label   "Detail Strength"
                type    float
                size    1
                default { 1 }
                range   { 0 4 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Value different than 1 will enable local exposure. This value should be set to 1 in most cases."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureDetailStrength_control_gncl == block } { xn__hdUEpostProcessLocalExposureDetailStrength_control_gncl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureBlurredLuminanceBlend_control_uycl", "Blurred Luminance Blend")
            parm {
                name    "xn__hdUEpostProcessLocalExposureBlurredLuminanceBlend_tlcl"
                label   "Blurred Luminance Blend"
                type    float
                size    1
                default { 0.6 }
                range   { 0 1 }
                help    "Local Exposure decomposes luminance of the frame into a base layer and a detail layer. Blend between bilateral filtered and blurred luminance as the base layer. Blurred luminance helps preserve image appearance and specular highlights, and reduce ringing. Good values are usually in the range 0.4 .. 0.6"
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureBlurredLuminanceBlend_control_uycl == block } { xn__hdUEpostProcessLocalExposureBlurredLuminanceBlend_control_uycl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureBlurredLuminanceKernelSizePercent_control_ejdl", "Blurred Luminance Kernel Size Percent")
            parm {
                name    "xn__hdUEpostProcessLocalExposureBlurredLuminanceKernelSizePercent_d5cl"
                label   "Blurred Luminance Kernel Size Percent"
                type    float
                size    1
                default { 50 }
                range   { 0 100 }
                help    "Kernel size (percentage of screen) used to blur frame luminance."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureBlurredLuminanceKernelSizePercent_control_ejdl == block } { xn__hdUEpostProcessLocalExposureBlurredLuminanceKernelSizePercent_control_ejdl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureHighlightThresholdStrength_control_z6cl", "Highlight Threshold Strength")
            parm {
                name    "xn__hdUEpostProcessLocalExposureHighlightThresholdStrength_ytcl"
                label   "Highlight Threshold Strength"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Strength of the highlight threshold."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureHighlightThresholdStrength_control_z6cl == block } { xn__hdUEpostProcessLocalExposureHighlightThresholdStrength_control_z6cl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureShadowThresholdStrength_control_31cl", "Shadow Threshold Strength")
            parm {
                name    "xn__hdUEpostProcessLocalExposureShadowThresholdStrength_2ocl"
                label   "Shadow Threshold Strength"
                type    float
                size    1
                default { 1 }
                range   { 0 1 }
                help    "Strength of the shadow threshold."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureShadowThresholdStrength_control_31cl == block } { xn__hdUEpostProcessLocalExposureShadowThresholdStrength_control_31cl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
            HDUE_CONTROL("xn__hdUEpostProcessLocalExposureMiddleGreyBias_control_gncl", "Middle Grey Bias")
            parm {
                name    "xn__hdUEpostProcessLocalExposureMiddleGreyBias_f9bl"
                label   "Middle Grey Bias"
                type    float
                size    1
                default { 0 }
                range   { -15 15 }
                help    "Logarithmic adjustment for the local exposure middle grey. 0: no adjustment, -1:2x darker, -2:4x darker, 1:2x brighter, 2:4x brighter, ..."
                parmtag { "spare_category" "Lens|Local Exposure" }
                parmtag { "usdvaluetype" "float" }
                disablewhen R"({ xn__hdUEpostProcessLocalExposureMiddleGreyBias_control_gncl == block } { xn__hdUEpostProcessLocalExposureMiddleGreyBias_control_gncl == none } { xn__hdUEtonemapper_tya == 0 })"
            }
        }

