/// hdUE light settings, authored as unreal:* attributes on UsdLux lights.
/// With the delegate registered, Light LOPs show them on an "Unreal Engine" tab.

#include "$HFS/houdini/soho/parameters/CommonMacros.ds"

#define HDUE_CONTROL(NAME, LABEL) \
    parm { \
        name    NAME \
        label   LABEL \
        type    string \
        default { "none" } \
        menujoin { \
            [ "import loputils" ] \
            [ "value = kwargs['node'].parm(hou.text.encode(hou.text.decode(kwargs['parm'].name())[:-len('_control')]))" ] \
            [ "return loputils.createEditPropertiesControlMenu(kwargs, value.parmTemplate().tags().get('usdvaluetype', 'int') if value else 'int')" ] \
            language python \
        } \
        help    "How this node edits the setting: Set or Create authors the value, Set If Exists changes it only where it is authored, Block removes it, Do Nothing keeps the input's." \
        parmtag { "sidefx::look" "icon" } \
    }

{
    name        "hdUE"
    label       "Unreal Engine"
    parmtag     { spare_opfilter        "!!SHOP/PROPERTIES!!" }
    parmtag     { spare_classtags       "render" }

    HDUE_CONTROL("xn__unrealvisibleBackground_control_krb", "Visible to Camera")
    parm {
        name    "xn__unrealvisibleBackground_jeb"
        label   "Visible to Camera"
        type    toggle
        size    1
        default { 1 }
        help    "Dome lights: draw the environment as the background. Off, the dome still lights the scene but camera rays that escape see black."
        parmtag { "spare_category" "Light" }
        parmtag { "usdvaluetype" "bool" }
        disablewhen R"({ xn__unrealvisibleBackground_control_krb == block } { xn__unrealvisibleBackground_control_krb == none })"
    }
    HDUE_CONTROL("xn__unrealmegaLights_control_5fb", "MegaLights")
    parm {
        name    "xn__unrealmegaLights_41a"
        label   "MegaLights"
        type    toggle
        size    1
        default { 1 }
        help    "Realtime mode: shade this local light with UE's MegaLights (stochastic, ray-traced shadows). Off, it uses UE's regular deferred lighting. The Path Tracer is unaffected."
        parmtag { "spare_category" "Light" }
        parmtag { "usdvaluetype" "bool" }
        disablewhen R"({ xn__unrealmegaLights_control_5fb == block } { xn__unrealmegaLights_control_5fb == none })"
    }
    /// BEGIN generated by scripts/generate_render_settings.py: Light Properties
    collapsible {
        name "hdUE_light_Light"
        label "Light"
        HDUE_CONTROL("xn__unreallightIndirectLightingIntensity_control_qdcf", "Indirect Lighting Intensity")
        parm {
            name    "xn__unreallightIndirectLightingIntensity_pzbf"
            label   "Indirect Lighting Intensity"
            type    float
            size    1
            default { 1 }
            range   { 0 6 }
            help    "Scales the indirect lighting contribution from this light. A value of 0 disables any GI from this light. Default is 1."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightIndirectLightingIntensity_control_qdcf == block } { xn__unreallightIndirectLightingIntensity_control_qdcf == none })"
        }
        HDUE_CONTROL("xn__unreallightVolumetricScatteringIntensity_control_8jcf", "Volumetric Scattering Intensity")
        parm {
            name    "xn__unreallightVolumetricScatteringIntensity_75bf"
            label   "Volumetric Scattering Intensity"
            type    float
            size    1
            default { 1 }
            range   { 0.25 4 }
            help    "Intensity of the volumetric scattering from this light. This scales Intensity and LightColor."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightVolumetricScatteringIntensity_control_8jcf == block } { xn__unreallightVolumetricScatteringIntensity_control_8jcf == none })"
        }
        HDUE_CONTROL("xn__unreallightbCastVolumetricShadow_control_75bf", "Cast Volumetric Shadow")
        parm {
            name    "xn__unreallightbCastVolumetricShadow_6sbf"
            label   "Cast Volumetric Shadow"
            type    toggle
            size    1
            default { 0 }
            help    "Whether the light shadows volumetric fog. Disabling this can save GPU time. Distant lights default to on (UDirectionalLightComponent). It also lets heterogeneous volumes shadow the scene in realtime."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbCastVolumetricShadow_control_75bf == block } { xn__unreallightbCastVolumetricShadow_control_75bf == none })"
        }
        HDUE_CONTROL("xn__unreallightbAffectTranslucentLighting_control_dfcf", "Affect Translucent Lighting")
        parm {
            name    "xn__unreallightbAffectTranslucentLighting_c1bf"
            label   "Affect Translucent Lighting"
            type    toggle
            size    1
            default { 1 }
            help    "Whether the light affects translucency or not. Disabling this can save GPU time when there are many small lights."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbAffectTranslucentLighting_control_dfcf == block } { xn__unreallightbAffectTranslucentLighting_control_dfcf == none })"
        }
        HDUE_CONTROL("xn__unreallightbTransmission_control_6sbf", "Transmission")
        parm {
            name    "xn__unreallightbTransmission_5fbf"
            label   "Transmission"
            type    toggle
            size    1
            default { 0 }
            help    "Whether light from this light transmits through surfaces with subsurface scattering profiles. Requires light to be movable."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbTransmission_control_6sbf == block } { xn__unreallightbTransmission_control_6sbf == none })"
        }
        HDUE_CONTROL("xn__unreallightCastRaytracedShadow_control_y2bf", "Cast Ray Traced Shadows")
        parm {
            name    "xn__unreallightCastRaytracedShadow_xpbf"
            label   "Cast Ray Traced Shadows"
            type    string
            size    1
            default { "ECastRayTracedShadow::UseProjectSetting" }
            menu { "ECastRayTracedShadow::Disabled" "Disabled" "ECastRayTracedShadow::UseProjectSetting" "UseProjectSetting" "ECastRayTracedShadow::Enabled" "Enabled" }
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "token" }
            disablewhen R"({ xn__unreallightCastRaytracedShadow_control_y2bf == block } { xn__unreallightCastRaytracedShadow_control_y2bf == none })"
        }
        HDUE_CONTROL("xn__unreallightContactShadowLength_control_y2bf", "Contact Shadow Length")
        parm {
            name    "xn__unreallightContactShadowLength_xpbf"
            label   "Contact Shadow Length"
            type    float
            size    1
            default { 0 }
            range   { 0 0.1 }
            help    "Length of screen space ray trace for sharp contact shadows. Zero is disabled."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightContactShadowLength_control_y2bf == block } { xn__unreallightContactShadowLength_control_y2bf == none })"
        }
        HDUE_CONTROL("xn__unreallightContactShadowLengthInWS_control_h9bf", "Contact Shadow Length In World Space Units")
        parm {
            name    "xn__unreallightContactShadowLengthInWS_gwbf"
            label   "Contact Shadow Length In World Space Units"
            type    toggle
            size    1
            default { 0 }
            help    "Where Length of screen space ray trace for sharp contact shadows is in world space units or in screen space units."
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightContactShadowLengthInWS_control_h9bf == block } { xn__unreallightContactShadowLengthInWS_control_h9bf == none })"
        }
        HDUE_CONTROL("xn__unreallightShadowResolutionScale_control_75bf", "Shadow Resolution Scale")
        parm {
            name    "xn__unreallightShadowResolutionScale_6sbf"
            label   "Shadow Resolution Scale"
            type    float
            size    1
            default { 1 }
            range   { 0.125 8 }
            help    "Scales the resolution of shadowmaps used to shadow this light. By default shadowmap resolution is chosen based on screen size of the caster. Setting the scale to zero disables shadow maps, but does not disable, e.g., contact shadows. Note: shadowmap resolution is still clamped by 'r.Shadow.MaxResolution'"
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightShadowResolutionScale_control_75bf == block } { xn__unreallightShadowResolutionScale_control_75bf == none })"
        }
        HDUE_CONTROL("xn__unreallightShadowBias_control_bobf", "Shadow Bias")
        parm {
            name    "xn__unreallightShadowBias_99af"
            label   "Shadow Bias"
            type    float
            size    1
            default { 0.5 }
            range   { 0 1 }
            help    "Controls how accurate self shadowing of whole scene shadows from this light are. At 0, shadows will start at the their caster surface, but there will be many self shadowing artifacts. larger values, shadows will start further from their caster, and there won't be self shadowing artifacts but object might appear to fly. around 0.5 seems to be a good tradeoff. This also affects the soft transition of shadows"
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightShadowBias_control_bobf == block } { xn__unreallightShadowBias_control_bobf == none })"
        }
        HDUE_CONTROL("xn__unreallightShadowSlopeBias_control_gwbf", "Shadow Slope Bias")
        parm {
            name    "xn__unreallightShadowSlopeBias_fjbf"
            label   "Shadow Slope Bias"
            type    float
            size    1
            default { 0.5 }
            range   { 0 1 }
            help    "Controls how accurate self shadowing of whole scene shadows from this light are. This works in addition to shadow bias, by increasing the amount of bias depending on the slope of a surface. At 0, shadows will start at the their caster surface, but there will be many self shadowing artifacts. larger values, shadows will start further from their caster, and there won't be self shadowing artifacts but object might appear to fly. around 0.5 seems to be a good tradeoff. This also affects the soft transition of shadows"
            parmtag { "spare_category" "Light" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightShadowSlopeBias_control_gwbf == block } { xn__unreallightShadowSlopeBias_control_gwbf == none })"
        }
        HDUE_CONTROL("xn__unreallightLightFunctionMaterial_control_75bf", "Light Function Material")
        parm {
            name    "xn__unreallightLightFunctionMaterial_6sbf"
            label   "Light Function Material"
            type    string
            size    1
            default { "" }
            help    "The light function material to be applied to this light. Note that only non-lightmapped lights (UseDirectLightMap=False) can have a light function. Light functions are supported within VolumetricFog, but only for Directional, Point and Spot lights. Rect lights are not supported. Path of a cooked asset in the runtime project (/Game/... or /Engine/...)."
            parmtag { "spare_category" "LightFunction" }
            parmtag { "usdvaluetype" "string" }
            disablewhen R"({ xn__unreallightLightFunctionMaterial_control_75bf == block } { xn__unreallightLightFunctionMaterial_control_75bf == none })"
        }
        HDUE_CONTROL("xn__unreallightLightFunctionScale_control_c1bf", "Light Function Scale")
        parm {
            name    "xn__unreallightLightFunctionScale_bobf"
            label   "Light Function Scale"
            type    float
            size    3
            default { 1024 1024 1024 }
            help    "Scales the light function projection. X and Y scale in the directions perpendicular to the light's direction, Z scales along the light direction."
            parmtag { "spare_category" "LightFunction" }
            parmtag { "usdvaluetype" "float3" }
            disablewhen R"({ xn__unreallightLightFunctionScale_control_c1bf == block } { xn__unreallightLightFunctionScale_control_c1bf == none })"
        }
        HDUE_CONTROL("xn__unreallightLightFunctionFadeDistance_control_qdcf", "Fade Distance")
        parm {
            name    "xn__unreallightLightFunctionFadeDistance_pzbf"
            label   "Fade Distance"
            type    float
            size    1
            default { 100000 }
            help    "Distance at which the light function should be completely faded to DisabledBrightness. This is useful for hiding aliasing from light functions applied in the distance."
            parmtag { "spare_category" "LightFunction" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightLightFunctionFadeDistance_control_qdcf == block } { xn__unreallightLightFunctionFadeDistance_control_qdcf == none })"
        }
        HDUE_CONTROL("xn__unreallightDisabledBrightness_control_c1bf", "Disabled Brightness")
        parm {
            name    "xn__unreallightDisabledBrightness_bobf"
            label   "Disabled Brightness"
            type    float
            size    1
            default { 0.5 }
            range   { 0 1 }
            help    "Brightness factor applied to the light when the light function is specified but disabled, for example in scene captures that use SceneCapView_LitNoShadows. This should be set to the average brightness of the light function material's emissive input, which should be between 0 and 1."
            parmtag { "spare_category" "LightFunction" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightDisabledBrightness_control_c1bf == block } { xn__unreallightDisabledBrightness_control_c1bf == none })"
        }
        HDUE_CONTROL("xn__unreallightbEnableLightShaftBloom_control_u7bf", "Light Shaft Bloom")
        parm {
            name    "xn__unreallightbEnableLightShaftBloom_tubf"
            label   "Light Shaft Bloom"
            type    toggle
            size    1
            default { 0 }
            help    "Whether to render light shaft bloom from this light. For directional lights, the color around the light direction will be blurred radially and added back to the scene. for point lights, the color on pixels closer than the light's SourceRadius will be blurred radially and added back to the scene."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbEnableLightShaftBloom_control_u7bf == block } { xn__unreallightbEnableLightShaftBloom_control_u7bf == none })"
        }
        HDUE_CONTROL("xn__unreallightBloomScale_control_bobf", "Bloom Scale")
        parm {
            name    "xn__unreallightBloomScale_99af"
            label   "Bloom Scale"
            type    float
            size    1
            default { 0.2 }
            range   { 0 10 }
            help    "Scales the additive color."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightBloomScale_control_bobf == block } { xn__unreallightBloomScale_control_bobf == none })"
        }
        HDUE_CONTROL("xn__unreallightBloomThreshold_control_tubf", "Bloom Threshold")
        parm {
            name    "xn__unreallightBloomThreshold_shbf"
            label   "Bloom Threshold"
            type    float
            size    1
            default { 0 }
            range   { 0 4 }
            help    "Scene color must be larger than this to create bloom in the light shafts."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightBloomThreshold_control_tubf == block } { xn__unreallightBloomThreshold_control_tubf == none })"
        }
        HDUE_CONTROL("xn__unreallightBloomTint_control_ombf", "Bloom Tint")
        parm {
            name    "xn__unreallightBloomTint_n8af"
            label   "Bloom Tint"
            type    color
            size    3
            default { 1 1 1 }
            help    "Multiplies against scene color to create the bloom color."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "color3f" }
            disablewhen R"({ xn__unreallightBloomTint_control_ombf == block } { xn__unreallightBloomTint_control_ombf == none })"
        }
    }
    collapsible {
        name "hdUE_light_DistantLight"
        label "Distant Light"
        HDUE_CONTROL("xn__unreallightbAtmosphereSunLight_control_y2bf", "Atmosphere Sun Light")
        parm {
            name    "xn__unreallightbAtmosphereSunLight_xpbf"
            label   "Atmosphere Sun Light"
            type    toggle
            size    1
            default { 1 }
            help    "Whether the directional light can interact with the atmosphere, cloud and generate a visual disk. All of which compose the visual sky."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbAtmosphereSunLight_control_y2bf == block } { xn__unreallightbAtmosphereSunLight_control_y2bf == none })"
        }
        HDUE_CONTROL("xn__unreallightAtmosphereSunLightIndex_control_h9bf", "Atmosphere Sun Light Index")
        parm {
            name    "xn__unreallightAtmosphereSunLightIndex_gwbf"
            label   "Atmosphere Sun Light Index"
            type    int
            size    1
            default { 0 }
            range   { 0! 1! }
            help    "Two atmosphere lights are supported. For instance: a sun and a moon, or two suns."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "int" }
            disablewhen R"({ xn__unreallightAtmosphereSunLightIndex_control_h9bf == block } { xn__unreallightAtmosphereSunLightIndex_control_h9bf == none })"
        }
        HDUE_CONTROL("xn__unreallightAtmosphereSunDiskColorScale_control_zgcf", "Atmosphere Sun Disk Color Scale")
        parm {
            name    "xn__unreallightAtmosphereSunDiskColorScale_y2bf"
            label   "Atmosphere Sun Disk Color Scale"
            type    color
            size    3
            default { 1 1 1 }
            help    "A color multiplied with the sun disk luminance."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "color3f" }
            disablewhen R"({ xn__unreallightAtmosphereSunDiskColorScale_control_zgcf == block } { xn__unreallightAtmosphereSunDiskColorScale_control_zgcf == none })"
        }
        HDUE_CONTROL("xn__unreallightbCastShadowsOnClouds_control_l4bf", "Cast Shadows On Clouds")
        parm {
            name    "xn__unreallightbCastShadowsOnClouds_krbf"
            label   "Cast Shadows On Clouds"
            type    toggle
            size    1
            default { 0 }
            help    "Whether the light should cast any shadows from opaque meshes onto clouds. This is disabled when 'Atmosphere Sun Light Index' is set to 1."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbCastShadowsOnClouds_control_l4bf == block } { xn__unreallightbCastShadowsOnClouds_control_l4bf == none })"
        }
        HDUE_CONTROL("xn__unreallightbCastShadowsOnAtmosphere_control_3bcf", "Cast Shadows On Atmosphere")
        parm {
            name    "xn__unreallightbCastShadowsOnAtmosphere_2xbf"
            label   "Cast Shadows On Atmosphere"
            type    toggle
            size    1
            default { 0 }
            help    "Whether the light should cast any shadows from opaque meshes onto the atmosphere."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbCastShadowsOnAtmosphere_control_3bcf == block } { xn__unreallightbCastShadowsOnAtmosphere_control_3bcf == none })"
        }
        HDUE_CONTROL("xn__unreallightbCastCloudShadows_control_pzbf", "Cast Cloud Shadows")
        parm {
            name    "xn__unreallightbCastCloudShadows_ombf"
            label   "Cast Cloud Shadows"
            type    toggle
            size    1
            default { 0 }
            help    "Whether the light should cast any shadows from clouds onto the atmosphere and other scene elements."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbCastCloudShadows_control_pzbf == block } { xn__unreallightbCastCloudShadows_control_pzbf == none })"
        }
        HDUE_CONTROL("xn__unreallightCloudShadowStrength_control_y2bf", "Cloud Shadow Strength")
        parm {
            name    "xn__unreallightCloudShadowStrength_xpbf"
            label   "Cloud Shadow Strength"
            type    float
            size    1
            default { 1 }
            range   { 0! 1 }
            help    "The overall strength of the cloud shadow, higher value will block more light."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightCloudShadowStrength_control_y2bf == block } { xn__unreallightCloudShadowStrength_control_y2bf == none })"
        }
        HDUE_CONTROL("xn__unreallightCloudShadowOnAtmosphereStrength_control_incf", "Cloud Shadow On Atmosphere Strength")
        parm {
            name    "xn__unreallightCloudShadowOnAtmosphereStrength_h9bf"
            label   "Cloud Shadow On Atmosphere Strength"
            type    float
            size    1
            default { 1 }
            range   { 0! 1 }
            help    "The strength of the shadow on atmosphere. Disabled when 0."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightCloudShadowOnAtmosphereStrength_control_incf == block } { xn__unreallightCloudShadowOnAtmosphereStrength_control_incf == none })"
        }
        HDUE_CONTROL("xn__unreallightCloudShadowOnSurfaceStrength_control_micf", "Cloud Shadow On Surface Strength")
        parm {
            name    "xn__unreallightCloudShadowOnSurfaceStrength_l4bf"
            label   "Cloud Shadow On Surface Strength"
            type    float
            size    1
            default { 1 }
            range   { 0! 1 }
            help    "The strength of the shadow on opaque and transparent meshes. Disabled when 0."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightCloudShadowOnSurfaceStrength_control_micf == block } { xn__unreallightCloudShadowOnSurfaceStrength_control_micf == none })"
        }
        HDUE_CONTROL("xn__unreallightCloudScatteredLuminanceScale_control_micf", "Cloud Scattered Luminance Scale")
        parm {
            name    "xn__unreallightCloudScatteredLuminanceScale_l4bf"
            label   "Cloud Scattered Luminance Scale"
            type    color
            size    3
            default { 1 1 1 }
            help    "Scales the lights contribution when scattered in cloud participating media. This can help counter balance the fact that our multiple scattering solution is only an approximation. Setting this to 0 on the secondary atmospheric light will optimise the cloud tracing to only use a single light."
            parmtag { "spare_category" "AtmosphereAndCloud" }
            parmtag { "usdvaluetype" "color3f" }
            disablewhen R"({ xn__unreallightCloudScatteredLuminanceScale_control_micf == block } { xn__unreallightCloudScatteredLuminanceScale_control_micf == none })"
        }
        HDUE_CONTROL("xn__unreallightbEnableLightShaftOcclusion_control_dfcf", "Light Shaft Occlusion")
        parm {
            name    "xn__unreallightbEnableLightShaftOcclusion_c1bf"
            label   "Light Shaft Occlusion"
            type    toggle
            size    1
            default { 0 }
            help    "Whether to occlude fog and atmosphere inscattering with screenspace blurred occlusion from this light."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "bool" }
            disablewhen R"({ xn__unreallightbEnableLightShaftOcclusion_control_dfcf == block } { xn__unreallightbEnableLightShaftOcclusion_control_dfcf == none })"
        }
        HDUE_CONTROL("xn__unreallightOcclusionMaskDarkness_control_75bf", "Occlusion Mask Darkness")
        parm {
            name    "xn__unreallightOcclusionMaskDarkness_6sbf"
            label   "Occlusion Mask Darkness"
            type    float
            size    1
            default { 0.05 }
            range   { 0 1 }
            help    "Controls how dark the occlusion masking is, a value of 1 results in no darkening term."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "float" }
            disablewhen R"({ xn__unreallightOcclusionMaskDarkness_control_75bf == block } { xn__unreallightOcclusionMaskDarkness_control_75bf == none })"
        }
        HDUE_CONTROL("xn__unreallightOcclusionDepthRange_control_y2bf", "Occlusion Depth Range")
        parm {
            name    "xn__unreallightOcclusionDepthRange_xpbf"
            label   "Occlusion Depth Range"
            type    float
            size    1
            default { 100000 }
            range   { 0 500000 }
            help    "Everything closer to the camera than this distance will occlude light shafts."
            parmtag { "spare_category" "LightShafts" }
            parmtag { "usdvaluetype" "float" }
