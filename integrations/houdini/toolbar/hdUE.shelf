<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="hdUE" label="hdUE"><memberTool name="vop_hduesubstratebuilder"/><memberTool name="hdue_substrate_publish"/><memberTool name="hdue_substrate_water"/></toolshelf>
  <!-- As $HFS/houdini/toolbar/ExtraTools.shelf's vop_karmamtlxsubnet (Karma Material Builder): a plain VOP subnet set up
       as a material builder, in the TAB menu wherever a Material Builder can go (/mat, Material Library LOPs). -->
  <tool name="vop_hduesubstratebuilder" label="hdUE Substrate Material Builder" icon="HDUE_hdue">
    <helpText><![CDATA[Creates an hdUE Substrate Material Builder: an editable VOP subnet, with a Slab wired to its surface output, whose TAB menu offers the hdUE Substrate nodes. From the shelf it goes in /mat.]]></helpText>
    <toolMenuContext name="network">
      <contextOpType>Vop/materialbuilder</contextOpType>
    </toolMenuContext>
    <toolSubmenu>hdUE</toolSubmenu>
    <script scriptType="python"><![CDATA[import hdue_substrate
hdue_substrate.tool(kwargs)]]></script>
  </tool>
  <tool name="hdue_substrate_publish" label="Author Substrate USD" icon="HDUE_hdue">
    <helpText><![CDATA[Adds a Material Library LOP after the displayed LOP that authors the selected Substrate Material Builder at /Looks/<name>, bound to the selected prims.]]></helpText>
    <script scriptType="python"><![CDATA[import hdue_substrate
hdue_substrate.publish()]]></script>
  </tool>
  <tool name="hdue_substrate_water" label="Water Coating Example" icon="HDUE_hdue">
    <script scriptType="python"><![CDATA[import hdue_substrate
hdue_substrate.create(preset='wet')]]></script>
  </tool>
</shelfDocument>
