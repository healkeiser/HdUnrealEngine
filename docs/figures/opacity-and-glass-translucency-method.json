    ]
   }
  },
  {
   "caption": "Ray Traced",
   "set": {
    "/Render/Settings": [
     "token unreal:postProcess:TranslucencyType = \"ETranslucencyType::RayTraced\""
    ]
   }
  },
  {
   "caption": "Path Tracer",
   "set": {
    "/Render/Settings": [
     "token unreal:renderMode = \"pathtraced\""
